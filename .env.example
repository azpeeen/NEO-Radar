# NEO Radar — Environment Variables
# Copy this file to .env and fill in your keys.

# NASA API key for NeoWs (Near Earth Object Web Service)
# Get one free at https://api.nasa.gov/
# Falls back to DEMO_KEY (rate-limited) if not set.
NASA_API_KEY=YOUR_NASA_API_KEY_HERE

# Server port (default: 3000)
PORT=3000

# Ko-fi webhook verification token.
# Set this in your Ko-fi account under Settings → API → Webhooks, then paste
# the same value here. The /api/kofi/webhook route rejects every request
# with 401 until this is set and matches what Ko-fi sends.
KO_FI_TOKEN=YOUR_KOFI_VERIFICATION_TOKEN_HERE
