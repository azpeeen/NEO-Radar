<%- include('partials/head', { title: 'About — NEO Radar' }) %>

<style>
  body { overflow-x: hidden; }

  .about-hero {
    position: relative;
    z-index: 1;
    max-width: 900px;
    margin: 0 auto;
    padding: 140px 40px 40px;
  }
  .about-hero h1 {
    font-family: var(--font-display);
    font-weight: 500;
    letter-spacing: -0.035em;
    font-size: clamp(48px, 6vw, 76px);
    line-height: 1;
    margin: 20px 0 16px;
  }
  .about-hero .lede {
    font-size: 17px;
    color: var(--ink-3);
    max-width: 560px;
    margin: 0;
  }

  .about-section {
    position: relative;
    z-index: 1;
    max-width: 900px;
    margin: 0 auto;
    padding: 56px 40px;
    border-top: 1px solid var(--line);
  }
  .about-section h2 {
    font-family: var(--font-display);
    font-weight: 500;
    letter-spacing: -0.025em;
    font-size: 30px;
    line-height: 1.1;
    margin: 0 0 22px;
  }
  .about-section p {
    font-size: 15.5px;
    color: var(--ink-2);
    line-height: 1.7;
    max-width: 680px;
    margin: 0 0 16px;
  }

  .press-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: 24px;
  }
  .press-list a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    width: fit-content;
    font-family: var(--font-mono);
    font-size: 12.5px;
    letter-spacing: 0.02em;
    color: var(--cobalt-soft);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 160ms;
  }
  .press-list a:hover { border-color: var(--cobalt-soft); }

  .supporters-summary {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--ink-2);
    margin-bottom: 24px;
  }
  .supporters-summary strong { color: var(--green); font-weight: 500; }

  .supporters-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 14px;
  }
  .supporter-card {
    padding: 16px 18px;
    border-radius: var(--r-md);
  }
  .supporter-card .row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 10px;
    font-size: 14px;
  }
  .supporter-card .name {
    color: var(--ink);
    font-weight: 500;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .supporter-card .amount {
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--green);
    white-space: nowrap;
  }
  .supporter-card .message {
    margin-top: 8px;
    font-size: 13px;
    font-style: italic;
    color: var(--ink-3);
    line-height: 1.5;
  }
  .supporters-empty {
    font-size: 14px;
    color: var(--ink-4);
  }

  .support-ctas {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    margin: 28px 0 16px;
  }
  .support-note {
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.02em;
    color: var(--ink-4);
    max-width: 560px;
  }

  .pix-toggle {
    background: transparent;
    border: 1px solid var(--line-strong);
    color: var(--ink);
  }
  .pix-toggle:hover { border-color: rgba(255,255,255,0.3); background: rgba(255,255,255,0.03); }

  .pix-panel {
    display: none;
    align-items: center;
    gap: 24px;
    margin: 8px 0 16px;
    padding: 24px;
    max-width: 560px;
  }
  .pix-panel.open { display: flex; }
  .pix-panel img {
    width: 240px;
    height: 240px;
    border-radius: var(--r-sm);
    background: white;
    padding: 10px;
    flex-shrink: 0;
  }
  .pix-panel .txt {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--ink-3);
    line-height: 1.6;
  }
  .pix-key-row {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 12px;
  }
  .pix-key {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--ink-2);
    background: rgba(255,255,255,0.05);
    border: 1px solid var(--line);
    border-radius: var(--r-sm);
    padding: 7px 9px;
    word-break: break-all;
    line-height: 1.4;
  }
  .pix-copy-btn {
    flex-shrink: 0;
    height: 28px;
    padding: 0 10px;
    border-radius: var(--r-sm);
    border: 1px solid var(--line-strong);
    background: transparent;
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 160ms;
  }
  .pix-copy-btn:hover { border-color: rgba(255,255,255,0.3); background: rgba(255,255,255,0.03); }
  .pix-copy-btn.copied { color: var(--green); border-color: var(--green); }

  @media (max-width: 560px) {
    .pix-panel { flex-direction: column; align-items: flex-start; }
  }
</style>

<div class="space-bg" aria-hidden="true"></div>

<%- include('partials/nav') %>

<!-- ============ HERO ============ -->
<section class="about-hero" data-screen-label="About — Hero">
  <span class="eyebrow">About</span>
  <h1>About</h1>
  <p class="lede">The project and the person behind it.</p>
</section>

<!-- ============ THE PROJECT ============ -->
<section class="about-section" data-screen-label="About — Project">
  <h2>The project</h2>
  <p>
    NEO Radar is a browser-based orbital mechanics engine tracking 41,812 real
    near-Earth asteroids. Built from first principles, it uses Newton-Raphson
    Kepler solving, adaptive RK4 N-body integration, and Monte Carlo
    uncertainty propagation, validated to 412 km RMS against JPL Horizons
    over 50 years. Free and open source.
  </p>
</section>

<!-- ============ ABOUT DAVI ============ -->
