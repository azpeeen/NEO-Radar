</section>

<!-- ============ SUPPORTERS ============ -->
<section class="about-section" data-screen-label="About — Supporters">
  <h2>Supporters</h2>

  <% if (total > 0) { %>
    <p class="supporters-summary">
      <strong><%= supporters.length %></strong> <%= supporters.length === 1 ? 'person has' : 'people have' %> supported this project. Thank you.
      <span style="color: var(--ink-4);">($<%= total.toFixed(2) %> USD total)</span>
    </p>
  <% } %>

  <% if (supporters.length > 0) { %>
    <div class="supporters-grid">
      <% supporters.forEach(function(s) { %>
        <div class="card supporter-card">
          <div class="row">
            <span class="name"><%= s.name %></span>
            <span class="amount"><%= s.amount %> <%= s.currency %></span>
          </div>
          <% if (s.message) { %>
            <div class="message">"<%= s.message %>"</div>
          <% } %>
        </div>
      <% }) %>
    </div>
  <% } else { %>
    <p class="supporters-empty">Be the first to support.</p>
  <% } %>
</section>

