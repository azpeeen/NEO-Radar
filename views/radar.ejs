  #pilot-hud.show { opacity: 1; transform: translateY(0); }
  #pilot-hud .fh-title { display: flex; justify-content: space-between; align-items: center; font-size: 9px; letter-spacing: 0.22em; color: var(--cobalt-soft); }
  #pilot-hud .ph-tag { padding: 2px 7px; border: 1px solid var(--line-strong); border-radius: 999px; color: var(--ink-3); letter-spacing: 0.14em; }
  #pilot-hud .ph-tag.auto { color: #6fb4ff; border-color: rgba(111,180,255,0.55); }
  #pilot-hud .fh-rule { height: 1px; background: var(--line); margin: 10px 0; }
  #pilot-hud .ph-speed { font-family: var(--font-display); font-size: 26px; font-weight: 500; letter-spacing: -0.01em; color: var(--ink); font-variant-numeric: tabular-nums; line-height: 1.1; }
  #pilot-hud .ph-speed small { font-family: var(--font-mono); font-size: 10.5px; color: var(--ink-3); margin-left: 6px; letter-spacing: 0.08em; }
  #pilot-hud .ph-c { font-size: 10px; color: var(--ink-3); letter-spacing: 0.1em; margin-top: 4px; min-height: 13px; }
  #pilot-hud .ph-c.ftl { color: var(--amber-soft); }
  #pilot-hud .fh-kv { display: flex; justify-content: space-between; gap: 14px; font-size: 10.5px; margin: 4px 0; }
  #pilot-hud .fh-kv .k { color: var(--ink-4); letter-spacing: 0.14em; flex-shrink: 0; }
  #pilot-hud .fh-kv .v { color: var(--ink); font-variant-numeric: tabular-nums; text-align: right; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
