  planets: PLANETS.map(() => ({ x:0, y:0, visible:false, conj:false })),
  neos:    NEOS.map(() => ({ x:0, y:0, z:0 })),
  dwarfPlanets: DWARF_PLANETS.map(() => ({ x:0, y:0, z:0, visible:true })),
  comets:       COMETS.map(() => ({ x:0, y:0, z:0, visible:true, sunDist:99 })),
