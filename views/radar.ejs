  cone: { active:false, risky:false, count:_CONE_N, upper:_coneUpper, lower:_coneLower },
  jup:  { active:false, ax:0, ay:0, az:0, bx:0, by:0, bz:0 },
  conjs: [],
  mpcDirty: false,
  hoverMPC: null,
  // Pilot mode (see _pilotTick): ship position, camera attitude (cq*), hull
  // attitude relative to the camera (rq*), turn rates and throttle for the
