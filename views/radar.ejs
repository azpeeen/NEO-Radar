      <button data-simday="${al.simDay}" style="margin-top:8px;padding:3px 10px;border:1px solid var(--line);border-radius:4px;background:transparent;color:var(--ink-3);font-family:var(--font-mono);font-size:10px;cursor:pointer;transition:all 160ms;" onmouseover="this.style.color='var(--ink)'" onmouseout="this.style.color='var(--ink-3)'">Jump →</button>
