// Display timezone — physics always runs in UTC/J2000 internally
var _selectedTz = (function () {
  try {
    var known = ['UTC','America/Sao_Paulo','America/New_York','America/Los_Angeles',
                 'Europe/London','Europe/Paris','Asia/Tokyo','Asia/Shanghai','Australia/Sydney'];
    var btz = Intl.DateTimeFormat().resolvedOptions().timeZone;
    return known.includes(btz) ? btz : 'UTC';
  } catch (e) { return 'UTC'; }
}());

function updateClock() {
  var epoch = new Date(Date.UTC(2026, 4, 27, 12, 0, 0));
  var d     = new Date(epoch.getTime() + state.simTime * 86400000);
  var fmt   = new Intl.DateTimeFormat('en-CA', {
    timeZone: _selectedTz,
    year: 'numeric', month: '2-digit', day: '2-digit',
    hour: '2-digit', minute: '2-digit', hour12: false,
  });
  var p = Object.fromEntries(fmt.formatToParts(d).map(function (x) { return [x.type, x.value]; }));
  var tzLabel = _selectedTz === 'UTC' ? 'UTC' : _selectedTz.split('/').pop().replace(/_/g, ' ');
  document.getElementById('sim-clock-val').textContent =
    p.year + '·' + p.month + '·' + p.day + ' ' + p.hour + ':' + p.minute + ' ' + tzLabel;
}
function updateScaleBar() {
  // Perspective: px-per-AU is only meaningful at one depth — we measure it at
  // the camera-target plane, so the bar stays honest as the dolly moves
  const ROUND = [1e-5,2e-5,5e-5,1e-4,2e-4,5e-4,0.001,0.002,0.005,0.01,0.02,0.05,0.1,0.2,0.5,1,2,5,10,20,50,100];
  const scale = pxPerAU();
  let chosen = ROUND[0];
  for (const v of ROUND) {
    chosen = v;
    if (v * scale >= 80) break;
  }
  const barPx = Math.round(chosen * scale);
  const label = chosen >= 0.01 ? chosen + ' AU'
    : Math.round(chosen * 1.496e8).toLocaleString('en-US') + ' km';
  const line = document.getElementById('dyn-scale-line');
  const lbl  = document.getElementById('dyn-scale-label');
  if (line) line.style.width = barPx + 'px';
  if (lbl)  lbl.textContent  = label;
  const sv = document.getElementById('scale-val');
  if (sv) sv.textContent = scale >= 1
    ? '1 AU = ' + scale.toFixed(0) + ' px'
    : '1 AU = ' + scale.toFixed(2) + ' px';
}

// Vis-viva orbital speed: v = sqrt(GM*(2/r - 1/a)) in km/s
function visVivaKms(a, r) {
  const GM = 4*Math.PI*Math.PI; // AU³/yr²
  const v_AU_per_yr = Math.sqrt(GM * (2/r - 1/a));
  return +(v_AU_per_yr * 4.74057).toFixed(1); // 1 AU/yr = 4.74057 km/s (Earth: 2π AU/yr ≈ 29.8)
}

// ─── Unified search index (Change 3) ─────────────────────────────────────────
// The 47 NEOs plus every navigable body: planets, moons, dwarf planets, comets,
// and a famous shape-model asteroid. Typing searches ALL of these; picking a
// non-NEO hit focuses it directly. Browsing (empty query) keeps the NEO-only
// list filtered by the risk chip.
function _cap(s){ return s.charAt(0).toUpperCase()+s.slice(1); }
function _focusFromSearch(target){
  // Piloting: a search result is a destination, the autopilot takes it
  if (_pilot && _pilot.active) { _pilotSetTarget(target, true); return; }
  // From the map: enterFocus. Already focused: hot-swap without an exit trip.
  if (state.focusMode && !_exitAnim) _switchFocus(target);
  else enterFocus(target);
}
function _focusMPCByName(keys){
  // Bodies without their own orbit in the app (e.g. Vesta, a main-belt shape
  // model) resolve to the MPC cloud by name/number when it's loaded.
  if (!_mpcLoaded) return false;
  var ast = _mpcAsteroids.find(function(a){
    var nm=(a.name||'').toLowerCase(), dg=(a.designation||'').toLowerCase();
    return keys.some(function(k){ return nm===k || dg===k || dg.replace(/\D/g,'')===k; });
  });
  if (ast) { _focusFromSearch({type:'mpc', ast:ast}); return true; }
  return false;
}
const _BADGE_COLORS = {
  NEO:'#6fb4ff', PLANET:'#e8cda0', MOON:'#c0c6d8',
  DWARF:'#c4ceb6', COMET:'#8cd6e0', MODEL:'#d0a0ff',
};
const SEARCH_INDEX = (function(){
  const idx=[];
  NEOS.forEach((n,i)=>idx.push({ name:n.name, sub:n.desig, kind:'NEO',
    onPick(){ state.selectedId=n.id; renderSelected(); _focusFromSearch({type:'neo',idx:i}); } }));
  PLANETS.forEach((p,i)=>idx.push({ name:p.name, sub:'Planet', kind:'PLANET',
    onPick(){ _focusFromSearch({type:'planet',idx:i}); } }));
  MOONS.forEach(m=>idx.push({ name:m.name, sub:'Moon of '+_cap(m.parent), kind:'MOON',
    onPick(){ _focusFromSearch({type:'moon',id:m.id}); } }));
  DWARF_PLANETS.forEach((d,i)=>idx.push({ name:d.name, sub:'Dwarf Planet', kind:'DWARF',
    onPick(){ _focusFromSearch({type:'dwarf',idx:i}); } }));
  COMETS.forEach((c,i)=>idx.push({ name:c.name, sub:'Comet', kind:'COMET',
    onPick(){ _focusFromSearch({type:'comet',idx:i}); } }));
  idx.push({ name:'Vesta', sub:'Asteroid (shape model)', kind:'MODEL',
    onPick(){ _focusMPCByName(['vesta','4']); } });
  // Dedup by lowercased name — earlier wins, so Toutatis stays a NEO and Ceres
  // a dwarf (never a duplicate MODEL/DWARF row).
  const seen=new Set(), out=[];
  for(const e of idx){ const k=e.name.toLowerCase(); if(seen.has(k))continue; seen.add(k); out.push(e); }
  return out;
})();

function renderList() {
  const q=state.search.toLowerCase().trim();
  const listEl=document.getElementById('neo-list');
  if (q) {
    // ── Search mode — every body type, type badges, direct focus on click ──
    const results=SEARCH_INDEX.filter(r=>
      r.name.toLowerCase().includes(q)||(r.sub&&r.sub.toLowerCase().includes(q))
    ).slice(0,80);
    document.getElementById('result-count').textContent=`${results.length} result${results.length===1?'':'s'}`;
    listEl.innerHTML=results.map(r=>{
      const col=_BADGE_COLORS[r.kind]||'#aab4d2';
      const badge=`<span style="font-family:var(--font-mono);font-size:8.5px;letter-spacing:0.12em;padding:2px 6px;border-radius:999px;border:1px solid ${col}55;color:${col};margin-left:7px;vertical-align:middle;">${r.kind}</span>`;
      return `<div class="neo-item search-item" data-sidx="${SEARCH_INDEX.indexOf(r)}">
        <div class="name">${r.name}${badge}</div>
        <div class="desig">${r.sub||''}</div>
      </div>`;
    }).join('');
    listEl.querySelectorAll('.search-item').forEach(el=>el.addEventListener('click',()=>{
      const r=SEARCH_INDEX[+el.dataset.sidx]; if(r&&r.onPick)r.onPick();
    }));
    return;
  }
  // ── Browse mode — NEOs filtered by the risk chip (original behavior) ──
  const filtered=NEOS.filter(n=>{
    if(state.filter!=='all'&&n.risk!==state.filter)return false;
    return true;
  }).sort((a,b)=>a.nextLD-b.nextLD);
  document.getElementById('result-count').textContent=`${filtered.length} result${filtered.length===1?'':'s'}`;
  listEl.innerHTML=filtered.map(n=>`
    <div class="neo-item r-${n.risk}${state.selectedId===n.id?' selected':''}" data-id="${n.id}">
      <div class="name"><span class="risk-dot"></span>${n.name}</div>
      <div class="desig">${n.desig}</div>
      <div class="ld">${n.nextLD<1?n.nextLD.toFixed(2):n.nextLD.toFixed(1)}<small>LUNAR DIST</small></div>
    </div>`).join('');
  listEl.querySelectorAll('.neo-item').forEach(el=>el.addEventListener('click',()=>{state.selectedId=el.dataset.id;renderList();renderSelected();}));
}
function renderSelected() {
  const n=NEOS.find(x=>x.id===state.selectedId); if(!n)return;
  document.getElementById('sel-name').textContent=n.name;
  document.getElementById('sel-desig').textContent=`${n.desig} · NEA`;
  const re=document.getElementById('sel-risk'); re.className=`risk ${n.risk}`; re.textContent=n.label;
