    ? state.focusTarget.idx
    : (_pilot.active && _pilot.target && _pilot.target.tg.type === 'neo') ? _pilot.target.tg.idx
    : null;

  // Focus LOD inputs: planets far from the focused object collapse to dots
  // in the renderer. Off during the exit glide (focusMode already false) so
  // the map look returns while the camera flies back.
  _frame.focusMode = !!(state.focusMode && state.focusTarget);
  _frame.focusPos = _frame.focusMode ? _focusTargetPos(t) : null;

