  _applyFocusTarget(target);
}

// True when a hit-test result denotes the object already focused
function _sameFocusTarget(a, b) {
  if (!a || !b || a.type !== b.type) return false;
  if (a.type === 'mpc') return a.ast === b.ast;
  if (a.type === 'moon') return a.id === b.id;
  return a.idx === b.idx;
}

// Hit test usable while focused (the map hover is disabled then): same tests
// and priorities as the mousemove hover, returning an enterFocus-style
// target descriptor or null.
function _focusHitTest(mx, my) {
  var t = state.simTime;
  var bestIdx = -1, bestD = 22;
  for (var i = 0; i < NEOS.length; i++) {
    var p = orbitPos(NEOS[i], t), s = ws(p.x, p.y, p.z);
    if (!s) continue;
    var d = Math.hypot(s.x - mx, s.y - my);
    if (d < bestD) { bestD = d; bestIdx = i; }
  }
  if (bestIdx >= 0) return { type: 'neo', idx: bestIdx };
  if (state.showPlanets) {
    var bestP = -1, bestPD = 18;
    for (var j = 0; j < PLANETS.length; j++) {
      if (!state.planetToggles[PLANETS[j].key]) continue;
      var pp = orbitPos(PLANETS[j], t), sp = ws(pp.x, pp.y, 0);
      if (!sp) continue;
      var dp = Math.hypot(sp.x - mx, sp.y - my);
      if (dp < bestPD) { bestPD = dp; bestP = j; }
    }
    if (bestP >= 0) return { type: 'planet', idx: bestP };
    // Moons — after planets; sep>3 skips moons buried in the parent's disc
    for (var mi2 = 0; mi2 < MOONS.length; mi2++) {
      var msp = _renderer.getMoonScreenPos(MOONS[mi2].id);
      if (!msp || msp.sep <= 3) continue;
      if (Math.hypot(mx - msp.x, my - msp.y) < msp.r + 8) {
        return { type: 'moon', id: MOONS[mi2].id };
      }
    }
  }
  // Dwarf planets + comets (visible independent of the planet toggle)
  for (var di2 = 0; di2 < DWARF_PLANETS.length; di2++) {
    var dsp = _renderer.getDwarfScreenPos(di2);
    if (dsp && Math.hypot(mx - dsp.x, my - dsp.y) < dsp.r + 8) {
      return { type: 'dwarf', idx: di2 };
    }
  }
  for (var ci2 = 0; ci2 < COMETS.length; ci2++) {
    var csp = _renderer.getCometScreenPos(ci2);
    if (csp && Math.hypot(mx - csp.x, my - csp.y) < csp.r + 8) {
      return { type: 'comet', idx: ci2 };
    }
  }
  if (state.showMPC && _mpcLoaded) {
    var hit = _mpcHit(mx, my);
    if (hit) return { type: 'mpc', ast: hit.ast };
  }
  return null;
}

function exitFocus() {
  if (!state.focusMode) return;
  state.focusMode = false;
  _focusFollow = false;                        // follow off at animation start
  _exitAnim = { from: Object.assign({}, state.cam), t: 0 };
  _magDolly = null;
  document.getElementById('focus-hud').classList.remove('show');
}

function _finishExitFocus() {                  // called by tick() once the glide lands
  if (state._camBeforeFocus) Object.assign(state.cam, state._camBeforeFocus);
  state.focusTarget = null;
  state.focusLerp = 0;
  _exitAnim = null;
  _syncAsteroidMesh();                         // demote unless the dossier still owns it
  _refreshReprNotice();
  _container.classList.remove('focus-active');
}

// Zoom-out exit: leave focus with NO return glide — the camera stays exactly
// where the wheel put it and the map takes over from there.
function exitFocusSilent() {
  if (!state.focusTarget) return;
  state.focusMode = false;
  state.focusTarget = null;
  state.focusLerp = 0;
  _focusFollow = false;
  _exitAnim = null;
  state._camBeforeFocus = null;                // never glide back to it
  _magDolly = null;
  _syncAsteroidMesh();                         // demote unless the dossier still owns it
  _refreshReprNotice();
