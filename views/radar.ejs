  _frame.mag.key = (state.showMag && _frame.focusMode && _magDef(state.focusTarget))
    ? _magKey(state.focusTarget) : null;
  _frame.mag.kind = state.focusTarget ? state.focusTarget.type : null;
  _frame.simRate = state.playing ? state.daysPerSec * state.speed : 1 / 86400;

