      updateFocusHud(tp, t);
    } else {
      // Follow: target glued to the moving object; the user orbits/dollies
      // around it freely (dolly floor = just above the surface)
      state.cam.tx = tp.x; state.cam.ty = tp.y; state.cam.tz = tp.z || 0;
      // Magnetic field toggled: glide to (or back from) the distance that
      // frames it, in log space like every other dolly here
      if (_magDolly) {
        _magDolly.t = Math.min(1, _magDolly.t + dt / 1.1);
        const eM = _easeInOutCubic(_magDolly.t);
