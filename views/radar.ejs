    const moidClass = moidAU <= 0.05 ? 'color:var(--amber)' : '';
    moidStr = '<span style="' + moidClass + '">' + moidAU.toFixed(5) + ' <small>AU</small></span> · ' + moidLD + ' <small>LD</small>';
  }
  _setText('dos-moid', moidStr);

  const tj = d.tisserand;
  _setText('dos-tj', tj != null ? tj.toFixed(3) : '—');
  _setText('dos-tj-note', tj != null ? (tj < 3 ? '← cometary origin?' : tj > 3.5 ? '← typical asteroid' : '← near boundary') : '');

  // Physical estimates
  let diamStr = '—';
  if (d.diam_mid_km != null) {
    diamStr = d.diam_mid_km.toFixed(3) + ' <small>km mid</small> '
            + '(' + d.diam_dark_km.toFixed(3) + '–' + d.diam_bright_km.toFixed(3) + ' <small>km range</small>)';
  }
  _setText('dos-diam', diamStr);

  _setText('dos-mass', d.mass_kg != null ? _fmtSci(d.mass_kg) + ' <small>kg</small>' : '—');
  _setText('dos-vesc', d.v_escape_ms != null ? (d.v_escape_ms < 1 ? (d.v_escape_ms * 100).toFixed(1) + ' <small>cm/s</small>' : d.v_escape_ms.toFixed(2) + ' <small>m/s</small>') : '—');

  // Impact energy
  if (d.impact_Mt != null) {
    let impStr, impCmp;
    if (d.impact_Mt < 0.001) {
      impStr = (d.impact_Mt * 1000).toFixed(3) + ' <small>kt TNT</small>';
    } else if (d.impact_Mt < 1000) {
