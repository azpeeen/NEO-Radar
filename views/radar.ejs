  state.hoverId = null; state.hoverPlanet = null; state.hoverMoon = null;
  state.hoverDwarf = null; state.hoverComet = null; _hoverMPC = null;
  document.getElementById('tooltip').classList.remove('show');
  document.getElementById('pilot-hud').classList.add('show');
  _container.classList.add('pilot-active');
  cv.style.cursor = 'crosshair';
  _syncAsteroidMesh();
  _pilotHud(true);
}
function exitPilot() {
  var P = _pilot;
  if (!P.active) return;
  P.active = false; P.target = null; P.auto = false; P.anchor = null;
  _pilotKeys = {}; _pilotDrag = null;
  if (state._camBeforePilot) Object.assign(state.cam, state._camBeforePilot);
  _camVTheta = 0; _camVPhi = 0;
  document.getElementById('pilot-hud').classList.remove('show');
  _container.classList.remove('pilot-active');
  cv.style.cursor = 'grab';
  _syncAsteroidMesh();
}

// Nearest surface: sets the speed scale, the near plane and the HUD row
function _pilotScan() {
  var P = _pilot, B = P.bodies, d;
