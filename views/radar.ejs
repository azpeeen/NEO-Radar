  /* ── Floating Action Button (mobile LIVE toggle) ────────────── */
  .fab-live {
    position: fixed;
    bottom: calc(88px + env(safe-area-inset-bottom, 0px));
    right: 16px;
    z-index: 200;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 18px;
    border-radius: 999px;
    background: rgba(10, 10, 20, 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.10);
    font-family: var(--font-display);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    color: var(--ink-3);
    cursor: pointer;
    transition: all 0.2s ease;
    min-height: 44px;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    user-select: none;
    -webkit-user-select: none;
  }
  .fab-live.is-live {
    border-color: var(--cobalt);
    color: var(--ink);
  }
  .fab-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--ink-4);
    flex-shrink: 0;
    transition: background 0.2s;
  }
  .fab-live.is-live .fab-dot {
    background: var(--green);
    animation: pulse-live 1.4s ease-in-out infinite;
  }
  /* Hide FAB on desktop */
  @media (min-width: 769px) {
    .fab-live { display: none; }
  }

  /* ── Timezone custom dropdown ───────────────────────────────── */
  @keyframes fadeInDown {
    from { opacity: 0; transform: translateY(-4px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  .tz-wrap {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 3px;
    flex-shrink: 0;
    position: relative;
  }
  .tz-lbl {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-4);
  }
  .tz-dropdown { position: relative; }
  .tz-trigger {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: transparent;
    border: 1px solid var(--line);
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    padding: 4px 10px;
    border-radius: var(--r-sm);
    cursor: pointer;
    transition: border-color 0.15s, color 0.15s;
    white-space: nowrap;
    outline: none;
  }
  .tz-trigger:hover { border-color: var(--line-strong); color: var(--ink-2); }
  .tz-menu {
    display: none;
    position: absolute;
    top: calc(100% + 4px);
    right: 0;
    min-width: 160px;
    background: var(--bg-2);
    border: 1px solid var(--line-strong);
    border-radius: var(--r-md);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    padding: 4px;
    z-index: 300;
    box-shadow: 0 8px 32px rgba(0,0,0,0.4);
    margin: 0;
    list-style: none;
  }
  .tz-menu.open {
    display: block;
    animation: fadeInDown 0.15s ease;
  }
  .tz-menu li {
    padding: 7px 12px;
    border-radius: var(--r-sm);
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    cursor: pointer;
    list-style: none;
    transition: background 0.1s, color 0.1s;
    white-space: nowrap;
  }
  .tz-menu li:hover { background: rgba(255,255,255,0.05); color: var(--ink); }
  .tz-menu li.active { color: var(--cobalt-soft); background: rgba(26,108,246,0.08); }
  /* Hide topbar TZ wrap on mobile (lives in sidebar there) */
  @media (max-width: 767px) { .tz-wrap { display: none; } }
