    border: 1px solid var(--line); border-radius: 8px;
    backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);
    font-family: var(--font-mono); font-size: 9.5px; letter-spacing: 0.1em;
    color: var(--ink-3); line-height: 2; pointer-events: none;
  }
  #pilot-exit-btn {
    position: absolute; top: 16px; right: 16px; z-index: 7;
    width: 40px; height: 40px; border-radius: 50%;
    border: 1px solid var(--line-strong); background: rgba(5,6,12,0.78);
    color: var(--ink-2); font-size: 18px; line-height: 1;
