  _setText('dos-n',      d.n_deg   != null ? d.n_deg.toFixed(4)   + ' <small>°/d</small>' : '—');
  _setText('dos-vperi',  d.v_peri_kms != null ? d.v_peri_kms.toFixed(2) + ' <small>km/s</small>' : '—');

  const moidAU = d.MOID_AU;
