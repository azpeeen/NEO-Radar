<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<!-- GLTFLoader served locally (CSP allows 'self' + cdnjs only; cdnjs lacks examples/).
     Fetched by scripts/downloadAsteroidModels.js — if absent, the renderer
     detects the missing THREE.GLTFLoader and uses procedural meshes only. -->
<script src="/js/GLTFLoader.js"></script>
<script src="/js/renderer3d.js"></script>

<script>
// Catalog injected server-side from src/data/catalog.js (47 objects)
const NEOS = <%- JSON.stringify(neos.map(n => ({
  id:       n.id,
  name:     n.name,
  desig:    n.desig,
  risk:     n.riskLevel,
  label:    n.label,
  a:        n.a,
  e:        n.e,
  i:        n.i,
  om:       n.Omega,
  w:        n.omega,
  phase:    n.phase,
  nextLD:   n.missDist_ld,
  nextDate: n.nextDate,
  nextKm:   n.nextKm,
  vel:      n.velocity_kms,
}))) %>;

// Deep-link initial state
const _FOCUS_ID   = <%- JSON.stringify(focusId) %>;
const _FOCUS_DATE = <%- JSON.stringify(focusDate) %>;
const PLANETS = [
  { name:'Mercury', a:0.387,  e:0.206, phase:1.50, color:'#b5b5b5', r:3, key:'mercury', inner:true  },
  { name:'Venus',   a:0.723,  e:0.007, phase:4.20, color:'#e8cda0', r:3, key:'venus',   inner:true  },
  { name:'Earth',   a:1.000,  e:0.017, phase:2.60, color:'#4f8fff', r:4, key:'earth',   inner:false, glow:true },
  { name:'Mars',    a:1.524,  e:0.093, phase:0.80, color:'#e07050', r:3, key:'mars',    inner:true  },
  { name:'Jupiter', a:5.204,  e:0.048, phase:5.70, color:'#c79b6e', r:7, key:'jupiter', inner:false, glow:true },
  { name:'Saturn',  a:9.583,  e:0.054, phase:1.30, color:'#c9b079', r:6, key:'saturn',  inner:false, ring:true },
  { name:'Uranus',  a:19.218, e:0.047, phase:4.45, color:'#7de8e8', r:5, key:'uranus',  inner:false },
  { name:'Neptune', a:30.070, e:0.009, phase:5.48, color:'#4b6eff', r:5, key:'neptune', inner:false },
];

// Alignment data from server
const ALIGNMENTS = <%- JSON.stringify(alignments || []) %>;
// Apply deep-link date if provided (?date=2029-04-13)
let _initSimTime = 0;
if (_FOCUS_DATE) {
  const epoch = new Date(Date.UTC(2026,4,27,12,0,0));
  const target = new Date(_FOCUS_DATE + 'T00:00:00Z');
  _initSimTime = Math.max(0, (target - epoch) / 86400000);
}

const state = {
  selectedId: (_FOCUS_ID && NEOS.find(n => n.id === _FOCUS_ID)) ? _FOCUS_ID : (NEOS[0] && NEOS[0].id),
  hoverId: null, hoverPlanet: null, hoverLuna: false,
  filter: 'all', search: '',
  // playing=false → live mode (JD pinned to Date.now() every frame)
  // playing=true  → simulate mode (dt accumulates)
  // Deep-link dates start in simulate so the specific date is shown.
  playing: !!_FOCUS_DATE, speed: 1.0,
  daysPerSec: 12,
  simTime: _FOCUS_DATE
    ? _initSimTime
    : (Date.now() - (Date.UTC(2000, 0, 1, 12, 0, 0) + 9643 * 86400000)) / 86400000,
  jupiter: true, saturn: true, uncertainty: true, trails: true, inner: false,
  pxPerAU: 120, zoom: 1.0, panX: 0, panY: 0,
  showPlanets: true, showOrbits: true, showMPC: true,
  planetToggles: { mercury:false, venus:false, earth:true, mars:false, jupiter:true, saturn:true, uranus:true, neptune:true },
  // ── Focus mode ──
  focusMode: false,        // true while focused (exit animation runs after → false)
  focusTarget: null,       // { type:'neo'|'planet'|'mpc', idx?|ast?, name, desig, a }
  focusLerp: 0,            // 0→1 entry animation progress (eased in tick)
  _focusCamTheta: 0,       // spherical camera orbit around the focused object
  _focusCamPhi: Math.PI / 4,
  _focusCamRadius: 1.5,    // AU
};

function solveKepler(M, e) {
  let E = M + e*Math.sin(M);
  for (let k=0; k<20; k++) { const dE=(E-e*Math.sin(E)-M)/(1-e*Math.cos(E)); E-=dE; if(Math.abs(dE)<1e-10)break; }
  return E;
}
function orbitPos(o, t) {
  const period=Math.pow(o.a,1.5), M=((t/365.25)/period)*2*Math.PI+(o.phase||0), E=solveKepler(M,o.e);
  const x=o.a*(Math.cos(E)-o.e), y=o.a*Math.sqrt(1-o.e*o.e)*Math.sin(E);
  const ang=((o.w||0)+(o.om||0))*Math.PI/180;
  return { x:x*Math.cos(ang)-y*Math.sin(ang), y:x*Math.sin(ang)+y*Math.cos(ang) };
}

// ─── Moon — visual-only circular orbit ───────────────────────────────────────
// Sole declaration of these globals: renderer3d.js (loaded earlier) reads them
// at render time — do NOT redeclare there (classic scripts share global scope).
const MOON_PERIOD = 27.321661;                                   // days, sidereal
const MOON_A      = 0.00257;                                     // AU (384,400 km)
const MOON_PHASE0 = ((9643 % MOON_PERIOD) / MOON_PERIOD) * 2 * Math.PI; // at sim epoch
function moonPos(simTime) {                                      // geocentric, AU
  var angle = MOON_PHASE0 + (simTime / MOON_PERIOD) * 2 * Math.PI;
  return { x: MOON_A * Math.cos(angle), y: MOON_A * Math.sin(angle) };
}

// ─── MPC asteroid layer (Layer 2 — Keplerian + Laplace-Lagrange secular) ─────
// Sim epoch: 2026-05-27 12:00 UTC = J2000 + 9643 days → JD 2461188.0
const _SIM_EPOCH_JD = 2451545.0 + 9643;
const _J2000_OFFSET = 9643; // _SIM_EPOCH_JD - J2000_JD

let _mpcAsteroids = [];
let _mpcLoaded    = false;

// ─── Browser-side Laplace-Lagrange secular theory ────────────────────────────
// Mirror of src/physics/secular.js — runs once at load time per asteroid.

function _secLaplace(alpha, n) {
  // b_{3/2}^{(1)}(alpha) via composite Simpson's rule (n intervals)
  var h = Math.PI / n, a2 = alpha * alpha, sum = 0;
  for (var k = 0; k <= n; k++) {
    var t = k * h, ct = Math.cos(t);
    var denom = Math.pow(1 - 2 * alpha * ct + a2, 1.5);
    var f = ct / denom; // cos(1·θ) = cos(θ)
    var w = (k === 0 || k === n) ? 1 : (k % 2 === 0 ? 2 : 4);
    sum += w * f;
  }
  return (2 / Math.PI) * (h / 3) * sum;
}

function computeSecularRates(ast) {
  var a = ast.a;
  if (!a || !isFinite(a) || a <= 0) return { dperi_dt: 0, dnode_dt: 0 };
  var n_ast = (2 * Math.PI) / (365.25 * Math.pow(a, 1.5)); // rad/day
  var planets = [{ a: 5.204267, m: 9.55e-4 }, { a: 9.582017, m: 2.86e-4 }];
  var rate = 0;
  for (var k = 0; k < planets.length; k++) {
    var p = planets[k];
    var alpha = a < p.a ? a / p.a : p.a / a;
    if (alpha >= 1) alpha = 0.9999;
    rate += (3 / 4) * n_ast * p.m * Math.pow(alpha, 3) * _secLaplace(alpha, 32);
  }
  return { dperi_dt: rate, dnode_dt: -rate };
}

// ─── Spatial hash for O(1) hit detection on 41k asteroids ────────────────────
const _GRID = 40; // px per cell
var _mpcVisible = []; // [{ast, sx, sy}, ...] rebuilt each frame
var _mpcGrid = new Map();

function _buildGrid() {
  _mpcGrid = new Map();
  for (var gi = 0; gi < _mpcVisible.length; gi++) {
    var e = _mpcVisible[gi];
    var gx = (e.sx / _GRID) | 0;
    var gy = (e.sy / _GRID) | 0;
    var key = gx * 100000 + gy;
    var bucket = _mpcGrid.get(key);
    if (!bucket) { bucket = []; _mpcGrid.set(key, bucket); }
    bucket.push(e);
  }
}

function _mpcHit(mx, my) {
  if (!_mpcGrid.size) return null;
  var gx = (mx / _GRID) | 0;
  var gy = (my / _GRID) | 0;
  var best = null, bestD2 = 14 * 14; // 14px hit radius
  for (var dx = -1; dx <= 1; dx++) {
    for (var dy = -1; dy <= 1; dy++) {
      var bucket = _mpcGrid.get((gx + dx) * 100000 + (gy + dy));
      if (!bucket) continue;
      for (var bi = 0; bi < bucket.length; bi++) {
        var be = bucket[bi];
        var d2 = (be.sx - mx) * (be.sx - mx) + (be.sy - my) * (be.sy - my);
        if (d2 < bestD2) { bestD2 = d2; best = be; }
      }
    }
  }
  return best; // { ast, sx, sy } or null
}

// ─── Promoted object state (Layer 3 — N-body on click) ───────────────────────
var _promotedAst     = null;  // the clicked MPC asteroid
var _promotedResult  = null;  // { trajectory, closeApproach, uncertainty }
var _promotedLoading = false;
var _hoverMPC        = null;  // currently hovered MPC entry { ast, sx, sy }

async function loadMPCAsteroids() {
  try {
    // Load ALL catalog asteroids (chunked: two requests of 25k)
    const [r1, r2] = await Promise.all([
      fetch('/api/asteroids/bulk?limit=25000&offset=0').then(r => r.json()),
      fetch('/api/asteroids/bulk?limit=25000&offset=25000').then(r => r.json()),
    ]);
    const combined = (r1.asteroids || []).concat(r2.asteroids || []);
    _mpcAsteroids = combined;

    // Pre-compute secular rates once — O(1) per frame from here on
    for (var k = 0; k < _mpcAsteroids.length; k++) {
      _mpcAsteroids[k]._sec = computeSecularRates(_mpcAsteroids[k]);
    }
    _mpcLoaded = true;
    _initMPCBuffers();

    // Update HUD catalog count
    var el = document.getElementById('hud-catalog-count');
    var el2 = document.getElementById('hud-catalog-line');
    if (el) el.textContent = _mpcAsteroids.length.toLocaleString();
    if (el2) el2.style.display = '';
  } catch (e) {
    console.warn('[MPC] Failed to load asteroids:', e.message);
  }
}

function getMPCPosition(ast, currentJD) {
  var dt = currentJD - ast.epoch_jd;
  var n  = 0.9856076686 / Math.pow(ast.a, 1.5); // deg/day
  var M  = (ast.M + n * dt) % 360;
  if (M < 0) M += 360;

  var Mrad = M * Math.PI / 180;
  var E    = solveKepler(Mrad, ast.e);

  var x_orb = ast.a * (Math.cos(E) - ast.e);
  var y_orb = ast.a * Math.sqrt(1 - ast.e * ast.e) * Math.sin(E);

  // Apply secular perturbation (Laplace-Lagrange) — O(1), pre-computed rates
  var w_eff = ast.w, node_eff = ast.node;
  if (ast._sec) {
    var R2D = 180 / Math.PI;
    w_eff    += ast._sec.dperi_dt * R2D * dt;
    node_eff += ast._sec.dnode_dt * R2D * dt;
  }

  var w    = w_eff    * Math.PI / 180;
  var node = node_eff * Math.PI / 180;
  var i    = ast.i    * Math.PI / 180;

  var cosN = Math.cos(node), sinN = Math.sin(node);
  var cosW = Math.cos(w),    sinW = Math.sin(w);
  var cosI = Math.cos(i);

  var x = (cosN * cosW - sinN * sinW * cosI) * x_orb
         + (-cosN * sinW - sinN * cosW * cosI) * y_orb;
  var y = (sinN * cosW + cosN * sinW * cosI) * x_orb
         + (-sinN * sinW + cosN * cosW * cosI) * y_orb;

  return { x, y };
}

// ─── MPC point-cloud bridge ──────────────────────────────────────────────────
// Positions are still solved HERE (Layer 2 Kepler + secular) and written into
// a flat Float32Array that the renderer uploads as ONE THREE.Points draw call.
let _mpcPositions = null, _mpcColors = null;

function _initMPCBuffers() {
  const N = _mpcAsteroids.length;
  _mpcPositions = new Float32Array(N * 3);
  _mpcColors    = new Float32Array(N * 3);
  for (var k = 0; k < N; k++) {
    const ast = _mpcAsteroids[k];
    const q = ast.a * (1 - ast.e);
    let r, g, b;
    if      (ast.a < 1.0) { r = 1;    g = 0.39; b = 0.39; }  // Aten
    else if (q < 1.017)   { r = 1;    g = 0.71; b = 0.20; }  // Apollo
    else                  { r = 0.31; g = 0.50; b = 0.80; }  // Amor (dimmed — 2D drew it at lower alpha)
    _mpcColors[k*3] = r; _mpcColors[k*3+1] = g; _mpcColors[k*3+2] = b;
  }
  _renderer.setMPC(_mpcPositions, _mpcColors, N);
}

function updateMPCFrame() {
  if (!state.showMPC || !_mpcLoaded || !_mpcPositions) return false;
  const currentJD = _SIM_EPOCH_JD + state.simTime;

  // Reset per-frame visibility list (used for spatial hash + hit test)
  _mpcVisible = [];

  for (var mi = 0; mi < _mpcAsteroids.length; mi++) {
    const ast = _mpcAsteroids[mi];
    const pos = getMPCPosition(ast, currentJD);
    const i3  = mi * 3;

    // Promoted asteroid is rendered as its own mesh — park its point off-world
    if (_promotedAst && ast === _promotedAst) {
      _mpcPositions[i3] = 1e6; _mpcPositions[i3+1] = 1e6;
    } else {
      _mpcPositions[i3] = pos.x; _mpcPositions[i3+1] = pos.y;
    }

    // Viewport culling now only matters for hit detection — GPU clips the rest
    const s = ws(pos.x, pos.y);
    if (s.x < -4 || s.x > W + 4 || s.y < -4 || s.y > H + 4) continue;

    _mpcVisible.push({ ast, sx: s.x, sy: s.y });
  }

  // Rebuild spatial hash from this frame's visible set
  _buildGrid();
  return true;
}

// Start loading MPC data (non-blocking)
if (state.showMPC) loadMPCAsteroids();

// ─── Promoted object (Layer 3) ────────────────────────────────────────────────
// Rendered by ThreeJSRenderer: procedural mesh + RK4 trajectory + MC cloud.
// Per-frame position/Earth-distance data is packed into _frame.promoted in tick().

// ─── MPC Dossier panel — static rendering helpers ────────────────────────────

function _fmt(v, digits, unit) {
  if (v == null || !isFinite(v)) return '—';
  return v.toFixed(digits) + (unit ? ' <small>' + unit + '</small>' : '');
}
function _fmtSci(v) {
  if (v == null || !isFinite(v)) return '—';
  const e = Math.floor(Math.log10(Math.abs(v)));
  const m = (v / Math.pow(10, e)).toFixed(2);
  return m + ' × 10<sup>' + e + '</sup>';
}
function _setText(id, html) {
  const el = document.getElementById(id);
  if (el) el.innerHTML = html;
}

function _renderDossierStatic(data) {
  const ast = data.elements || {};
  const d   = data.derived  || {};
  const jpl = data.jpl      || {};

  // Header
  _setText('dos-name', data.name || data.designation || '—');
  _setText('dos-desig', data.designation || '—');

  const typeEl = document.getElementById('dos-type');
  if (typeEl && d.type) {
    typeEl.textContent = d.type;
