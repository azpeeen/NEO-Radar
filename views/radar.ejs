  /* ── Pilot mode ──────────────────────────────────────────────────────────
     Entry button (bottom-right), HUD (top-left, same card language as the
     focus HUD), key legend and exit button. Desktop only for now: the ship
     needs a keyboard. */
  #pilot-btn {
    position: absolute; right: 16px; bottom: 16px; z-index: 5;
    display: inline-flex; align-items: center; gap: 9px;
    height: 36px; padding: 0 12px 0 11px;
    border: 1px solid rgba(26,108,246,0.45); border-radius: 8px;
    background: rgba(8,12,24,0.72); color: var(--cobalt-soft);
    font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.16em;
    cursor: pointer; backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
    transition: border-color 160ms, color 160ms, background 160ms;
  }
  #pilot-btn:hover { color: var(--ink); border-color: var(--cobalt-soft); background: rgba(26,108,246,0.16); }
  #pilot-btn svg { width: 15px; height: 15px; }
  #pilot-btn .kbd, #pilot-keys .kbd {
    display: inline-block; min-width: 16px; padding: 1px 5px; text-align: center;
