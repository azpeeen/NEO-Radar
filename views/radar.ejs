}
function _sameBody(a, b) {
  if (!a || !b || a.type !== b.type) return false;
  if (a.type === 'sun') return true;
  if (a.type === 'mpc') return a.ast === b.ast;
  if (a.type === 'moon') return a.id === b.id;
  return a.idx === b.idx;
}

function _pilotBuildBodies() {
  var L = [{ tg: { type: 'sun' } }];
  PLANETS.forEach(function (p, i) { L.push({ tg: { type: 'planet', idx: i } }); });
  MOONS.forEach(function (m) { L.push({ tg: { type: 'moon', id: m.id } }); });
  DWARF_PLANETS.forEach(function (d, i) { L.push({ tg: { type: 'dwarf', idx: i } }); });
  COMETS.forEach(function (c, i) { L.push({ tg: { type: 'comet', idx: i } }); });
  NEOS.forEach(function (n, i) { L.push({ tg: { type: 'neo', idx: i } }); });
  L.forEach(function (b) { b.name = _bodyName(b.tg); b.r = _bodyRadiusAU(b.tg); b.x = b.y = b.z = 0; });
