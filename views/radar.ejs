  /* ── Load screen ─────────────────────────────────────────────────────────
     The sweep only animates transform/opacity, so the browser runs it on the
     compositor and it keeps spinning even while the main thread is busy
     building the scene. */
  .radar-loader { position: fixed; inset: 0; z-index: 200; display: grid; place-items: center; background: #050508; transition: opacity .6s ease, visibility .6s ease; }
  .radar-loader.is-done { opacity: 0; visibility: hidden; pointer-events: none; }
  .radar-loader .rl-inner { display: grid; justify-items: center; gap: 28px; width: min(420px, 86vw); }
  .radar-loader .rl-scope { position: relative; width: 168px; height: 168px; border-radius: 50%; border: 1px solid var(--line-strong); background:
      radial-gradient(circle, rgba(79,143,255,.10) 0, transparent 62%); }
  .radar-loader .rl-scope::before, .radar-loader .rl-scope::after { content: ""; position: absolute; border-radius: 50%; border: 1px solid var(--line); inset: 22%; }
  .radar-loader .rl-scope::after { inset: 44%; }
  .radar-loader .rl-sweep { position: absolute; inset: 0; border-radius: 50%; animation: rl-spin 2.4s linear infinite; will-change: transform;
      background: conic-gradient(from 0deg, rgba(79,143,255,0) 0deg, rgba(79,143,255,0) 270deg, rgba(79,143,255,.55) 360deg); }
  .radar-loader .rl-dot { position: absolute; width: 4px; height: 4px; border-radius: 50%; background: var(--amber-soft); box-shadow: 0 0 8px var(--amber-glow); animation: rl-blip 2.4s ease-in-out infinite; }
  .radar-loader .rl-dot:nth-child(2) { top: 30%; left: 64%; animation-delay: .4s; }
  .radar-loader .rl-dot:nth-child(3) { top: 62%; left: 28%; animation-delay: 1.1s; }
  .radar-loader .rl-dot:nth-child(4) { top: 44%; left: 78%; animation-delay: 1.7s; }
  .radar-loader .rl-title { font-family: var(--font-display); font-weight: 500; font-size: 15px; letter-spacing: .02em; color: var(--ink); }
  .radar-loader .rl-meta { display: grid; gap: 10px; width: 100%; font-family: var(--font-mono); font-size: 11px; letter-spacing: .08em; color: var(--ink-3); }
  .radar-loader .rl-row { display: flex; justify-content: space-between; gap: 12px; }
  .radar-loader .rl-row .v { color: var(--ink-2); font-variant-numeric: tabular-nums; }
  .radar-loader .rl-bar { height: 2px; background: var(--line); border-radius: 2px; overflow: hidden; }
  .radar-loader .rl-fill { height: 100%; width: 100%; background: var(--cobalt-soft); transform-origin: left center; transform: scaleX(0); transition: transform .25s ease-out; }
  @keyframes rl-spin { to { transform: rotate(360deg); } }
  @keyframes rl-blip { 0%, 100% { opacity: 0; } 12% { opacity: 1; } 55% { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) {
    .radar-loader .rl-sweep, .radar-loader .rl-dot { animation: none; }
    .radar-loader .rl-dot { opacity: 1; }
  }
</style>

