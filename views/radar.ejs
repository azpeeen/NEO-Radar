function _renderDossierTrajectory(result) {
  const ca = result.closeApproach || {};
  const unc = result.uncertainty  || {};

  // Show content, hide spinner and idle
  document.getElementById('dos-ca-spinner').style.display = 'none';
  document.getElementById('dos-ca-idle').style.display = 'none';
  document.getElementById('dos-ca-error').style.display = 'none';
  document.getElementById('dos-ca-content').style.display = '';

  // Distance
  let distStr = '—', subStr = '—';
  if (ca.dist_AU != null) {
    if (ca.dist_AU < 0.00257) {
      distStr = (ca.dist_AU / 0.00257 * 384400).toFixed(0) + ' <small>km</small>';
    } else {
      distStr = (ca.dist_AU / 0.00257).toFixed(3) + ' <small>LD</small>';
    }
    subStr = (ca.date || '—') + ' · ' +
             ca.dist_AU.toFixed(5) + ' AU · ' +
             (ca.rel_vel_kms != null ? 'Δv ' + ca.rel_vel_kms.toFixed(2) + ' km/s' : '—');
  }
  _setText('dos-ca-dist', distStr);
  _setText('dos-ca-sub',  subStr);

  // Monte Carlo 3σ
  const sig = unc.sigma3_AU;
  _setText('dos-sigma', sig != null ? sig.toExponential(3) + ' AU (' + (sig/0.00257).toFixed(4) + ' LD)' : '—');

  // Hand the RK4 trajectory + Monte Carlo cloud to the renderer as flat arrays
  _promotedResult = result;
  _renderer.setPromotedTrajectory(
    result.trajectory || [],
    (result.uncertainty && result.uncertainty.caPositions) || []
  );
}

