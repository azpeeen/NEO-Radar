// ─── Focus Mode ──────────────────────────────────────────────────────────────
// Double-click any object (planet, Moon, tracked NEO, MPC asteroid) — or press
// F on hover, or the sidebar Focus button — for a cinematic single-object view.
// ONE scene, ONE camera: focus is pure camera state. Entry animates the camera
// target onto the (moving) object with a log-space dolly (~1.4 s); afterwards
// the camera FOLLOWS the object every frame while the user orbits/dollies
// around it, and 5 s without input starts a slow auto-rotate (Eyes signature).
// Asteroids get their 3D shape model (NASA GLB or procedural) promoted into
// the main scene at the real position, radius estimated from H.
// ESC / double-click on empty space glides back to the pre-focus camera (~1 s).

var _promoModelText = null;    // #repr-notice override when a NASA GLB is shown

// Focus runtime (tick() drives these)
var _focusFollow     = false;  // entry animation done → target glued to object
var _focusStartCam   = null;   // {tx,ty,tz,dist} snapshot at glide start
var _focusDistTarget = 0.002;  // dolly end distance (AU)
var _focusMinDist    = 3e-5;   // dolly floor while following (≈ radius · 1.3)
var _focusRadiusAU   = 0;      // physical radius of the focused object (AU)
var _exitAnim        = null;   // { from:{cam…}, t:0..1 } while exiting

function _easeInOutCubic(t) {
  return t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
}

// Radius in AU from absolute magnitude H (mid albedo 0.14):
// D_km = 1329/√p · 10^(−H/5). Fallback ≈ 250 m for objects without H.
function _astRadiusAU(ast) {
  var H = ast && ast.H;
  if (H == null || !isFinite(H)) return 1.7e-9;
  var D_km = (1329 / Math.sqrt(0.14)) * Math.pow(10, -H / 5);
  return (D_km / 2) / 1.496e8;
}

function _refreshReprNotice() {
  var el = document.getElementById('repr-notice');
  if (!el) return;
  var txt = null;
  var tg = state.focusTarget;
  if (tg && (tg.type === 'neo' || tg.type === 'mpc')) {
    txt = _promoModelText || '⚠ ARTISTIC REPRESENTATION · ACTUAL SHAPE UNKNOWN';
  } else if (_promotedAst) {
    txt = _promoModelText || '⚠ ARTISTIC REPRESENTATION';
  }
  if (txt) { el.textContent = txt; el.style.display = ''; }
  else el.style.display = 'none';
}

// Renderer callback: a real NASA shape model replaced the procedural mesh
_renderer.onModelApplied = function (context, key, noticeText) {
  _promoModelText = noticeText;
  _refreshReprNotice();
};

// ONE shared mesh slot in the renderer serves both the dossier's promoted
// asteroid and the focused NEO/MPC. Promote whatever should carry the mesh
// now; demote (with dispose) when nothing should.
function _syncAsteroidMesh() {
  var want = null;
  var tg = state.focusTarget;
  if (tg && tg.type === 'neo') {
    var n = NEOS[tg.idx];
    // The NEO's own orbit LineLoop already lives in the scene
    want = { desig: n.id, name: n.name, orbit: null, ast: null };
  } else if (tg && tg.type === 'mpc') {
    want = { desig: tg.ast.designation, name: tg.ast.name,
             orbit: buildMPCOrbitPts(tg.ast, 256), ast: tg.ast };
  } else if (_promotedAst) {
    want = { desig: _promotedAst.designation, name: _promotedAst.name,
             orbit: buildMPCOrbitPts(_promotedAst, 256), ast: _promotedAst };
  }
  if (!want) {
    if (_promoKey !== null) {
      _renderer.demote();                      // disposes mesh + orbit + trajectory
      _promoKey = null; _promoAstRef = null; _promoModelText = null;
    }
    return;
  }
  _promoAstRef = want.ast;
  if (want.desig === _promoKey) return;        // same object — keep mesh/trajectory
  _promoModelText = null;
  _renderer.promote(want.desig, want.name, want.orbit);  // may fire onModelApplied synchronously
  _promoKey = want.desig;
}

// Closed orbit loop for an MPC asteroid, sampled over one period from now —
// same solver path as its live position (Kepler + secular), page-side only.
function buildMPCOrbitPts(ast, segments) {
  var jd0 = _SIM_EPOCH_JD + state.simTime;
  var P = 365.25 * Math.pow(ast.a, 1.5);
  var pts = new Float32Array(segments * 3);
  for (var k = 0; k < segments; k++) {
    var p = getMPCPosition(ast, jd0 + (k / segments) * P);
    pts[k * 3] = p.x; pts[k * 3 + 1] = p.y; pts[k * 3 + 2] = p.z;
  }
  return pts;
}

function _focusTargetPos(t) {
  var tg = state.focusTarget;
  if (tg.type === 'planet') return orbitPos(PLANETS[tg.idx], t);
  if (tg.type === 'neo')    return orbitPos(NEOS[tg.idx], t);
  if (tg.type === 'luna') {
    var ep = orbitPos(PLANETS[2], t), mp = moonPos(t);
    return { x: ep.x + mp.x, y: ep.y + mp.y, z: mp.z };
  }
  return getMPCPosition(tg.ast, _SIM_EPOCH_JD + t);
}

var _fhVel   = document.getElementById('fh-vel');
var _fhSun   = document.getElementById('fh-sun');
var _fhEarth = document.getElementById('fh-earth');

function updateFocusHud(pos, t) {
  var tg = state.focusTarget;
  if (!tg) return;
  var pz = pos.z || 0;
  var r = Math.hypot(pos.x, pos.y, pz);
  var ep = orbitPos(PLANETS[2], t);
  if (tg.type === 'luna') {
    // Circular geocentric orbit: speed is constant, distance stays ≈ MOON_A
    var dGeo = Math.hypot(pos.x - ep.x, pos.y - ep.y, pz);
    _fhVel.textContent   = '1.02 km/s';
    _fhSun.textContent   = r.toFixed(3) + ' AU';
    _fhEarth.textContent = Math.round(384400 * dGeo / MOON_A).toLocaleString('en-US') + ' km';
    return;
  }
  _fhVel.textContent = tg.a && r > 0 ? visVivaKms(tg.a, r).toFixed(1) + ' km/s' : '—';
  _fhSun.textContent = r.toFixed(3) + ' AU';
  if (tg.type === 'planet') {
    if (PLANETS[tg.idx].key === 'earth') {
      _fhEarth.textContent = '—';
    } else {
      var dAU = Math.hypot(pos.x - ep.x, pos.y - ep.y);
      var dLD = dAU / 0.00257;
      _fhEarth.textContent = dAU.toFixed(3) + ' AU · ' +
        (dLD >= 100 ? dLD.toFixed(0) : dLD.toFixed(1)) + ' LD';
    }
    return;
  }
  var dE_LD = Math.hypot(pos.x - ep.x, pos.y - ep.y, pz) / 0.00257;
  _fhEarth.textContent = (dE_LD < 100 ? dE_LD.toFixed(2) : dE_LD.toFixed(0)) + ' LD';
}

// Dolly targets for an object of physical radius r (Part 6): the end distance
// frames the body; "raioEfetivo" folds in the min-px floor at that distance so
// tiny asteroids still land at a sensible range.
function _setFocusDollyTargets(radiusAU) {
  _focusRadiusAU = radiusAU;
  var distGuess = Math.max(radiusAU * 4, 0.002);
  var minWorldR = 6 * (2 * distGuess * Math.tan(FOV_RAD / 2) / H);
  var rEff = Math.max(radiusAU, minWorldR);
  _focusDistTarget = Math.max(rEff * 4, 0.002);
  _focusMinDist = Math.max(rEff * 1.3, 3e-5);
}

function _beginFocusGlide() {
  state.focusLerp = 0;
  _focusFollow = false;
  _exitAnim = null;
  _focusStartCam = { tx: state.cam.tx, ty: state.cam.ty, tz: state.cam.tz, dist: state.cam.dist };
  _camVTheta = 0; _camVPhi = 0;
  _lastInteractT = performance.now();
}

function enterFocus(target) {
  if (state.focusTarget) return;               // already focused / animating out
  state._camBeforeFocus = Object.assign({}, state.cam);
  state.focusMode = true;

  var radiusAU = 0;
  if (target.type === 'planet') {
    var p = PLANETS[target.idx];
    target.a = p.a; target.name = p.name;
    target.desig = 'PLANET · a = ' + p.a.toFixed(3) + ' AU';
    radiusAU = REAL_RADIUS_AU[p.key] || 2e-5;  // shared table from renderer3d.js
  } else if (target.type === 'luna') {
    target.a = 1.0; target.name = 'Moon';
    target.desig = 'EARTH SATELLITE · P = 27.32 D';
    radiusAU = REAL_RADIUS_AU.moon;
  } else if (target.type === 'neo') {
    var n = NEOS[target.idx];
    target.a = n.a; target.name = n.name; target.desig = n.desig;
    radiusAU = 1.7e-9;                         // catalog NEOs carry no H — ~500 m body
  } else {
    var ast = target.ast;
    target.a = ast.a; target.name = ast.name || ast.designation; target.desig = ast.designation;
    radiusAU = _astRadiusAU(ast);
  }
  state.focusTarget = target;

  _setFocusDollyTargets(radiusAU);
  _beginFocusGlide();
  _syncAsteroidMesh();                         // NEO/MPC: 3D mesh in the MAIN scene
  _refreshReprNotice();

  document.getElementById('fh-name').textContent = target.name;
  document.getElementById('fh-desig').textContent = target.desig;
  document.getElementById('focus-hud').classList.add('show');
  _container.classList.add('focus-active');
  document.getElementById('tooltip').classList.remove('show');
  state.hoverId = null; state.hoverPlanet = null; _hoverMPC = null; state.hoverLuna = false;
}

// Click on the Moon while focused on Earth → the Moon becomes the focus:
// same follow mode, so the camera glides Earth → Moon with no cut.
function _switchFocusToLuna() {
  var target = { type: 'luna', a: 1.0, name: 'Moon', desig: 'EARTH SATELLITE · P = 27.32 D' };
  state.focusTarget = target;
  _setFocusDollyTargets(REAL_RADIUS_AU.moon);
  _beginFocusGlide();
  _refreshReprNotice();
  document.getElementById('fh-name').textContent = target.name;
  document.getElementById('fh-desig').textContent = target.desig;
}

function exitFocus() {
  if (!state.focusMode) return;
  state.focusMode = false;
  _focusFollow = false;                        // follow off at animation start
  _exitAnim = { from: Object.assign({}, state.cam), t: 0 };
  document.getElementById('focus-hud').classList.remove('show');
}

function _finishExitFocus() {                  // called by tick() once the glide lands
  if (state._camBeforeFocus) Object.assign(state.cam, state._camBeforeFocus);
  state.focusTarget = null;
  state.focusLerp = 0;
  _exitAnim = null;
  _syncAsteroidMesh();                         // demote unless the dossier still owns it
  _refreshReprNotice();
  _container.classList.remove('focus-active');
}

document.getElementById('fh-exit').addEventListener('click', exitFocus);
document.getElementById('focus-exit-btn').addEventListener('click', exitFocus);
document.getElementById('focus-btn').addEventListener('click', function (e) {
  e.preventDefault();
  var idx = NEOS.findIndex(function (n) { return n.id === state.selectedId; });
  if (idx >= 0) enterFocus({ type: 'neo', idx: idx });
});

// ─── Camera controls (manual — no OrbitControls) ─────────────────────────────
// Left-drag orbits (theta/phi), right-drag or shift+left-drag pans the target
// in the screen plane, wheel dollies exponentially. Inertia decays in tick().
// The focus target follows a moving object, which OrbitControls cannot do.
let _dragMode = null;              // 'orbit' | 'pan' | null — ACTIVE drag
let _dragArmed = null;             // mode armed on mousedown, activated after 4px
let _panSX = 0, _panSY = 0;        // mousedown position (click-vs-drag test)
let _panLX = 0, _panLY = 0;        // last mouse position while dragging
let _camVTheta = 0, _camVPhi = 0;  // angular inertia seeded by the last drag
let _lastInteractT = 0;            // last user input — drives focus auto-rotate

cv.style.cursor = 'grab';
cv.addEventListener('contextmenu', e => e.preventDefault());   // right-drag = pan

// Pan: move the camera target along the screen plane, converting px → AU at
// the target depth. Disabled while focus follow has the target glued.
function camPan(dx, dy) {
  if (state.focusTarget) return;
  const c = state.cam;
  const wpp = 2 * c.dist * Math.tan(FOV_RAD / 2) / H;   // world per pixel
  const ct = Math.cos(c.theta), st = Math.sin(c.theta);
  const cp = Math.cos(c.phi),  sp = Math.sin(c.phi);
  // Camera right/up vectors in world coords (up = +z, spherical position)
  const rx = -ct,      ry = st;                          // rz = 0
  const ux = -sp * st, uy = -sp * ct, uz = cp;
  c.tx -= (rx * dx - ux * dy) * wpp;
  c.ty -= (ry * dx - uy * dy) * wpp;
  c.tz -= (      - uz * dy) * wpp;
}

cv.addEventListener('mousedown', e => {
  if (e.button !== 0 && e.button !== 2) return;
  // Arm only — the drag activates in mousemove after a 4px threshold, so
  // clicks (and double-clicks) never nudge the camera.
  _dragArmed = (e.button === 2 || e.shiftKey) ? 'pan' : 'orbit';
  _dragMode = null;
  _panSX = e.clientX; _panSY = e.clientY;
  _panLX = e.clientX; _panLY = e.clientY;
  _camVTheta = 0; _camVPhi = 0;
  _lastInteractT = performance.now();
});

cv.addEventListener('mouseup', () => {
  _dragArmed = null;
  if (_dragMode) { _dragMode = null; cv.style.cursor = 'grab'; }
});

// Shared by the dblclick listener (desktop) and the touch double-tap detector
// (mobile). Debounced: Chrome Android synthesizes a dblclick for double-taps,
// which would otherwise fire this twice (enter focus, then instantly exit).
let _lastActivateT = 0;
function _handleDoubleActivate(mx, my) {
  const nowA = performance.now();
  if (nowA - _lastActivateT < 500) return;
  _lastActivateT = nowA;
  if (state.focusTarget) {
    const tg = state.focusTarget;
    // A double-click on the orbiting Moon while Earth is focused is a
    // re-focus (handled by the click listener) — don't exit
    if (tg.type === 'planet' && PLANETS[tg.idx].key === 'earth') {
      const luna = _renderer.getLunaScreenPos();
      if (luna && Math.hypot(mx - luna.x, my - luna.y) < Math.max(12, luna.r + 6)) return;
    }
    // Exit when the double-click lands on empty space (off the focused body)
    const tp = _focusTargetPos(state.simTime);
    const s = ws(tp.x, tp.y, tp.z);
    const wpp = 2 * state.cam.dist * Math.tan(FOV_RAD / 2) / H;
    const objPx = Math.max(8, _focusRadiusAU / wpp);
    if (!s || Math.hypot(mx - s.x, my - s.y) > Math.max(40, objPx)) exitFocus();
    return;
  }
  if (state.hoverId) {
    const idx = NEOS.findIndex(n => n.id === state.hoverId);
    if (idx >= 0) enterFocus({ type: 'neo', idx });
  } else if (state.hoverLuna) {
    enterFocus({ type: 'luna' });
  } else if (state.hoverPlanet) {
    const idx = PLANETS.findIndex(p => p.key === state.hoverPlanet);
    if (idx >= 0) enterFocus({ type: 'planet', idx });
  } else if (state.showMPC && _mpcLoaded) {
    // Re-run the spatial-hash hit test: the first click of a double-click on
    // an MPC asteroid opens the dossier, which clears _hoverMPC.
    const hit = _mpcHit(mx, my);
    if (hit) enterFocus({ type: 'mpc', ast: hit.ast });
    else { state.cam.tx = 0; state.cam.ty = 0; state.cam.tz = 0; }
  } else {
    state.cam.tx = 0; state.cam.ty = 0; state.cam.tz = 0;   // recentre on the Sun
  }
}

cv.addEventListener('dblclick', e => {
  const r = cv.getBoundingClientRect();
  _handleDoubleActivate(e.clientX - r.left, e.clientY - r.top);
});

cv.addEventListener('mousemove',e=>{
  const r=cv.getBoundingClientRect(),x=e.clientX-r.left,y=e.clientY-r.top;
  // Armed drag becomes active only after 4px of travel — below that the
  // gesture is still a click and the camera must not move
  if (!_dragMode && _dragArmed &&
      Math.hypot(e.clientX - _panSX, e.clientY - _panSY) > 4) {
    _dragMode = _dragArmed;
    cv.style.cursor = 'grabbing';
  }
  if (_dragMode) {
    // Same orbit/pan math everywhere — in focus the orbit spins around the
    // followed object because the target is glued to it
    const dx = e.clientX - _panLX, dy = e.clientY - _panLY;
    if (_dragMode === 'orbit') {
      state.cam.theta -= dx * 0.005;
      state.cam.phi = Math.min(1.48, Math.max(-1.48, state.cam.phi + dy * 0.005));
      _camVTheta = -dx * 0.005; _camVPhi = dy * 0.005;   // inertia seed
    } else {
      camPan(dx, dy);
    }
    _lastInteractT = performance.now();
    _panLX = e.clientX; _panLY = e.clientY;
    return;
  }
  _panLX = e.clientX; _panLY = e.clientY;
  if (state.focusTarget) return;               // no hover/tooltips while focused
  let best=null,bestD=22;
  for(const n of NEOS){const p=orbitPos(n,state.simTime),s=ws(p.x,p.y,p.z);if(!s)continue;const d=Math.hypot(s.x-x,s.y-y);if(d<bestD){bestD=d;best=n;}}
  // Check planet hover (ws() null = behind the camera — skip)
  let bestPlanet=null,bestPD=18;
  if(state.showPlanets){
    for(const p of PLANETS){
      if(!state.planetToggles[p.key])continue;
      const pos=orbitPos(p,state.simTime),s=ws(pos.x,pos.y,0);
      if(!s)continue;
      const d=Math.hypot(s.x-x,s.y-y);
      if(d<bestPD){bestPD=d;bestPlanet=p;}
    }
  }
  // Moon hover — only once it is visually clear of Earth's disc (sep > 3px),
  // and only when the cursor is closer to the Moon than to any planet
  state.hoverLuna=false;
  let lunaHit=false;
  if(!best && state.showPlanets && state.planetToggles.earth){
    const luna=_renderer.getLunaScreenPos();
    if(luna && luna.sep>3){
      const dL=Math.hypot(x-luna.x,y-luna.y);
      if(dL<luna.r+8 && (!bestPlanet||dL<bestPD)) lunaHit=true;
    }
  }
  const tt=document.getElementById('tooltip');
  if(best){
    state.hoverId=best.id; state.hoverPlanet=null; _hoverMPC=null;
    tt.style.left=x+'px';tt.style.top=y+'px';tt.classList.add('show');
    document.getElementById('tt-name').textContent=best.name;
    document.getElementById('tt-desig').textContent=best.desig;
    document.getElementById('tt-d').textContent=`${best.nextLD} LD · ${best.nextKm} km`;
    document.getElementById('tt-v').textContent=`${best.vel} km/s`;
    cv.style.cursor='pointer';
  } else if(lunaHit){
    state.hoverId=null; state.hoverPlanet=null; _hoverMPC=null; state.hoverLuna=true;
    tt.style.left=x+'px';tt.style.top=y+'px';tt.classList.add('show');
    document.getElementById('tt-name').textContent='Moon';
    document.getElementById('tt-desig').textContent='EARTH SATELLITE · P = 27.32 D';
    document.getElementById('tt-d').textContent='1.00 LD · 384,400 km';
    document.getElementById('tt-v').textContent='1.02 km/s';
    cv.style.cursor='pointer';
  } else if(bestPlanet){
    state.hoverId=null; state.hoverPlanet=bestPlanet.key; _hoverMPC=null;
    tt.style.left=x+'px';tt.style.top=y+'px';tt.classList.add('show');
    const pos=orbitPos(bestPlanet,state.simTime);
    const r_AU=Math.sqrt(pos.x*pos.x+pos.y*pos.y);
    const T_yr=Math.pow(bestPlanet.a,1.5);
    const spd=visVivaKms(bestPlanet.a, r_AU);
    document.getElementById('tt-name').textContent=bestPlanet.name;
    document.getElementById('tt-desig').textContent=`T = ${T_yr.toFixed(2)} yr`;
    document.getElementById('tt-d').textContent=`${r_AU.toFixed(3)} AU`;
    document.getElementById('tt-v').textContent=`${spd} km/s`;
    cv.style.cursor='pointer';
  } else if(state.showMPC && _mpcLoaded) {
    // ── MPC asteroid hover via O(1) spatial hash ──────────────────────────
    const hit = _mpcHit(x, y);
    if(hit){
      state.hoverId=null; state.hoverPlanet=null; _hoverMPC=hit;
      const ast=hit.ast;
      const currentJD = _SIM_EPOCH_JD + state.simTime;
      const astPos = getMPCPosition(ast, currentJD);
      const earthPos = orbitPos(PLANETS[2], state.simTime);
      const dist_AU = Math.hypot(astPos.x - earthPos.x, astPos.y - earthPos.y, astPos.z);
      const dist_LD = (dist_AU / 0.00257).toFixed(2);
      const q = ast.a * (1 - ast.e);
      const type = ast.a < 1 ? 'Aten' : q < 1.017 ? 'Apollo' : q < 1.3 ? 'Amor' : 'MBA';
      tt.style.left=x+'px'; tt.style.top=y+'px'; tt.classList.add('show');
      document.getElementById('tt-name').textContent = ast.name || ast.designation;
      document.getElementById('tt-desig').textContent = ast.designation + ' · ' + type + ' · H=' + (ast.H||'?');
      document.getElementById('tt-d').textContent = dist_LD + ' LD · ' + dist_AU.toFixed(4) + ' AU';
      document.getElementById('tt-v').textContent = 'click for N-body dossier';
      cv.style.cursor='pointer';
    } else {
      state.hoverId=null; state.hoverPlanet=null; _hoverMPC=null;
      tt.classList.remove('show');
      if(!_dragMode) cv.style.cursor='grab';
    }
  } else{
    state.hoverId=null; state.hoverPlanet=null; _hoverMPC=null;
    tt.classList.remove('show');
    if(!_dragMode) cv.style.cursor='grab';
  }
});

cv.addEventListener('mouseleave',()=>{
  _dragMode=null; _dragArmed=null;
  state.hoverId=null; state.hoverPlanet=null; state.hoverLuna=false;
  document.getElementById('tooltip').classList.remove('show');
  cv.style.cursor='grab';
});
cv.addEventListener('click',e=>{
  if(state.focusTarget){
    // Focus mode: the only live click target is the Moon while Earth is focused
    if(state.focusMode
       && state.focusTarget.type==='planet' && PLANETS[state.focusTarget.idx].key==='earth'
       && Math.hypot(e.clientX-_panSX,e.clientY-_panSY)<4){   // ignore drag-release
      const rc=cv.getBoundingClientRect();
      const luna=_renderer.getLunaScreenPos();
      if(luna && Math.hypot((e.clientX-rc.left)-luna.x,(e.clientY-rc.top)-luna.y)<Math.max(12,luna.r+6)){
        _switchFocusToLuna();
      }
    }
    return;
  }
  if(state.hoverId){
    // Close dossier when clicking a tracked NEO
    closeMPCDossier();
    state.selectedId=state.hoverId; renderList(); renderSelected();
  } else if(_hoverMPC) {
    // Promote MPC asteroid to N-body and open dossier
    openMPCDossier(_hoverMPC);
  }
});
cv.addEventListener('wheel',e=>{
  e.preventDefault();
  // Exponential dolly — continuous zoom from the full system to a surface
  const factor = e.deltaY > 0 ? 1.10 : 0.90;
  if (state.focusTarget && !_focusFollow && !_exitAnim) {
    // Mid-entry glide: retarget the dolly endpoint so the wheel never fights
    // the animation
    _focusDistTarget = Math.max(_focusMinDist, Math.min(120, _focusDistTarget * factor));
  } else {
    // Dolly floor is dynamic in focus follow (just above the surface)
    const minD = _focusFollow ? _focusMinDist : 0.0005;
    state.cam.dist = Math.max(minD, Math.min(120, state.cam.dist * factor));
  }
  _lastInteractT = performance.now();
},{passive:false});
document.addEventListener('keydown',e=>{
  if(e.target.tagName==='INPUT')return;
  if(e.key==='Escape'&&state.focusMode){exitFocus();return;}
  if((e.key==='f'||e.key==='F')&&!state.focusTarget){
    if(state.hoverId){const idx=NEOS.findIndex(n=>n.id===state.hoverId);if(idx>=0)enterFocus({type:'neo',idx});}
    else if(state.hoverLuna){enterFocus({type:'luna'});}
    else if(state.hoverPlanet){const idx=PLANETS.findIndex(p=>p.key===state.hoverPlanet);if(idx>=0)enterFocus({type:'planet',idx});}
    else if(_hoverMPC){enterFocus({type:'mpc',ast:_hoverMPC.ast});}
    return;
  }
  if(e.key==='/'){e.preventDefault();document.getElementById('search-input').focus();}
  if(e.key===' '){e.preventDefault();document.getElementById('btn-play').click();}
});

// ─── Return to Live button ─────────────────────────────────────────────────
// J2000.0 = 2000-Jan-01 12:00:00 UTC
const _J2000_MS = Date.UTC(2000, 0, 1, 12, 0, 0);
// Sim epoch offset: simTime=0 corresponds to 2026-05-27 12:00 (9643 days from J2000)
const _T_SIM_MS = _J2000_MS + 9643 * 86400000;

function _nowSimDays() {
  // Current real time expressed as days from T_SIM (the sim epoch)
  return (Date.now() - _T_SIM_MS) / 86400000;
}

// Threshold: within 1 real minute of "now" = 1/(24*60) days
const _LIVE_THRESH_DAYS = 1 / (24 * 60);

function _updateLiveBtn() {
  // is-live class (cobalt + pulsing dot) fires when simulating —
  // it signals "you've left live mode, click to return".
  const isSimulating = state.playing;

  ['btn-live', 'fab-live'].forEach(function (id) {
    const el = document.getElementById(id);
    if (!el) return;
    el.classList.toggle('is-live', isSimulating);
    const label = el.querySelector('#live-label, .fab-label');
    if (label) label.textContent = isSimulating ? '● LIVE' : 'SIMULATE';
    const dot = el.querySelector('#live-dot, .fab-dot');
    if (dot) dot.style.animationPlayState = isSimulating ? 'running' : 'paused';
  });
}

function _handleLive() {
  if (state.playing) {
    // Simulate → Live: stop accumulation, pin immediately to Date.now()
    state.playing  = false;
    state.simTime  = (Date.now() - _T_SIM_RAF) / 86400000;
    playIc.innerHTML = '<path d="M8 5v14l11-7z"/>';  // play icon
  } else {
    // Live → Simulate: start accumulating from current real time
    state.playing = true;
    playIc.innerHTML = '<path d="M6 5h4v14H6zM14 5h4v14h-4z"/>';  // pause icon
  }
  _updateLiveBtn();
}
// Both LIVE buttons (desktop topbar + mobile FAB) share the exact same handler
[document.getElementById('btn-live'), document.getElementById('fab-live')]
  .filter(Boolean)
  .forEach(function (btn) {
    btn.addEventListener('click', _handleLive);
    btn.addEventListener('touchend', function (e) {
      e.preventDefault(); // suppress ghost click after touchend
      _handleLive();
    });
  });

// Poll every second: update button state + optionally sync clock display
setInterval(() => { _updateLiveBtn(); }, 1000);
_updateLiveBtn();

// ─── Bottom-sheet (mobile) ────────────────────────────────────
const _sidebar     = document.getElementById('radar-sidebar');
const _sheetHandle = document.getElementById('sheet-handle');

if (_sheetHandle && _sidebar) {
  var _dragStartY  = null;
  var _dragDeltaY  = 0;
  var CLOSE_THRESH = 80; // px of downward drag required to close

  _sheetHandle.addEventListener('touchstart', function (e) {
    _dragStartY = e.touches[0].clientY;
    _dragDeltaY = 0;
    // Remove CSS transition so the sheet tracks the finger in real time
    _sidebar.style.transition = 'none';
  }, { passive: true });

  _sheetHandle.addEventListener('touchmove', function (e) {
    if (_dragStartY === null) return;
    _dragDeltaY = e.touches[0].clientY - _dragStartY;
    // Only translate downward, and only when the sheet is currently open
    if (_dragDeltaY > 0 && _sidebar.classList.contains('sheet-open')) {
      _sidebar.style.transform = 'translateY(' + _dragDeltaY + 'px)';
      e.preventDefault();
    }
  }, { passive: false });

  _sheetHandle.addEventListener('touchend', function (e) {
    e.preventDefault(); // suppress ghost click
    // Re-enable smooth CSS transition for the snap animation
    _sidebar.style.transition = '';
    _sidebar.style.transform  = ''; // hand control back to CSS class

    if (_sidebar.classList.contains('sheet-open')) {
      // Drag down past threshold OR simple tap → close
      if (_dragDeltaY > CLOSE_THRESH || Math.abs(_dragDeltaY) < 10) {
        _sidebar.classList.remove('sheet-open');
      }
      // else: partial drag — spring back to open (CSS transition handles it)
    } else {
      // Sheet is collapsed: tap → open
      if (Math.abs(_dragDeltaY) < 10) {
        _sidebar.classList.add('sheet-open');
      }
    }

    _dragStartY = null;
    _dragDeltaY = 0;
  }, { passive: false });

  // Desktop fallback: mouse click toggles the sheet
  _sheetHandle.addEventListener('click', function () {
    _sidebar.classList.toggle('sheet-open');
  });
}
// Update the collapsed summary whenever selection changes
function _updateSheetSummary(n) {
  const nameEl = document.getElementById('sheet-name');
  const riskEl = document.getElementById('sheet-risk');
  if (nameEl) nameEl.textContent = n.name;
  if (riskEl) { riskEl.className = 'risk ' + n.risk; riskEl.textContent = n.label; }
  // Mobile bottom bar mirrors the same selection
  const mbName = document.getElementById('mb-name');
  const mbDot  = document.getElementById('mb-dot');
  if (mbName) mbName.textContent = n.name;
  if (mbDot)  mbDot.className = 'mb-dot r-' + n.risk;
}

// ─── Mobile bottom bar — FOCUS on the selected NEO + sheet trigger ──
(function () {
  const mbFocus = document.getElementById('mb-focus');
  const mbSheet = document.getElementById('mb-sheet');
  if (mbFocus) mbFocus.addEventListener('click', function () {
    var idx = NEOS.findIndex(function (n) { return n.id === state.selectedId; });
    if (idx >= 0) enterFocus({ type: 'neo', idx: idx });
  });
  if (mbSheet && _sidebar) mbSheet.addEventListener('click', function () {
    _sidebar.classList.add('sheet-open');
  });
})();

// ─── Mobile tap tooltip ───────────────────────────────────────
// Touch has no hover: a single tap runs the same hit tests as the mouse
// hover and shows the tooltip bottom-centre (clear of the finger), auto-
// hidden after 2 s or on the next tap anywhere. It also seeds the hover
// state, so the synthetic click that follows a tap selects NEOs / opens
// the MPC dossier exactly like the desktop hover→click flow.
var _ttHideTimer = null;
function _hideTapTooltip() {
  if (_ttHideTimer) { clearTimeout(_ttHideTimer); _ttHideTimer = null; }
  var tt = document.getElementById('tooltip');
  tt.classList.remove('show');
  tt.classList.remove('mobile-tap');
}
function _mobileTap(x, y) {
  if (state.focusTarget) return;
  var t = state.simTime;
  var tt = document.getElementById('tooltip');

  // Same hit tests as the mousemove hover, with touch-sized radii
  var best = null, bestD = 28;
  for (var i = 0; i < NEOS.length; i++) {
    var p = orbitPos(NEOS[i], t), s = ws(p.x, p.y, p.z);
    if (!s) continue;
    var d = Math.hypot(s.x - x, s.y - y);
    if (d < bestD) { bestD = d; best = NEOS[i]; }
  }
  var lunaTap = false;
  if (!best && state.showPlanets && state.planetToggles.earth) {
    var luna = _renderer.getLunaScreenPos();
    if (luna && luna.sep > 3 && Math.hypot(x - luna.x, y - luna.y) < luna.r + 12) lunaTap = true;
  }
  var bestPlanet = null, bestPD = 24;
  if (!best && !lunaTap && state.showPlanets) {
    for (var j = 0; j < PLANETS.length; j++) {
      var pl = PLANETS[j];
      if (!state.planetToggles[pl.key]) continue;
      var pp = orbitPos(pl, t), sp = ws(pp.x, pp.y, 0);
      if (!sp) continue;
      var dp = Math.hypot(sp.x - x, sp.y - y);
      if (dp < bestPD) { bestPD = dp; bestPlanet = pl; }
    }
  }

  state.hoverId = null; state.hoverPlanet = null; state.hoverLuna = false; _hoverMPC = null;
  var hit = true;
  if (best) {
    state.hoverId = best.id;
    document.getElementById('tt-name').textContent = best.name;
    document.getElementById('tt-desig').textContent = best.desig;
    document.getElementById('tt-d').textContent = best.nextLD + ' LD · ' + best.nextKm + ' km';
    document.getElementById('tt-v').textContent = best.vel + ' km/s';
  } else if (lunaTap) {
    state.hoverLuna = true;
    document.getElementById('tt-name').textContent = 'Moon';
    document.getElementById('tt-desig').textContent = 'EARTH SATELLITE · P = 27.32 D';
    document.getElementById('tt-d').textContent = '1.00 LD · 384,400 km';
    document.getElementById('tt-v').textContent = '1.02 km/s';
  } else if (bestPlanet) {
    state.hoverPlanet = bestPlanet.key;
    var pos2 = orbitPos(bestPlanet, t);
    var rAU = Math.hypot(pos2.x, pos2.y);
    document.getElementById('tt-name').textContent = bestPlanet.name;
    document.getElementById('tt-desig').textContent = 'T = ' + Math.pow(bestPlanet.a, 1.5).toFixed(2) + ' yr';
    document.getElementById('tt-d').textContent = rAU.toFixed(3) + ' AU';
    document.getElementById('tt-v').textContent = visVivaKms(bestPlanet.a, rAU) + ' km/s';
  } else {
    var mHit = state.showMPC && _mpcLoaded ? _mpcHit(x, y) : null;
    if (mHit) {
      _hoverMPC = mHit;
      var ast = mHit.ast;
      var apos = getMPCPosition(ast, _SIM_EPOCH_JD + t);
      var ep = orbitPos(PLANETS[2], t);
      var dAU = Math.hypot(apos.x - ep.x, apos.y - ep.y, apos.z);
      var q = ast.a * (1 - ast.e);
      var type = ast.a < 1 ? 'Aten' : q < 1.017 ? 'Apollo' : q < 1.3 ? 'Amor' : 'MBA';
      document.getElementById('tt-name').textContent = ast.name || ast.designation;
      document.getElementById('tt-desig').textContent = ast.designation + ' · ' + type + ' · H=' + (ast.H || '?');
      document.getElementById('tt-d').textContent = (dAU / 0.00257).toFixed(2) + ' LD · ' + dAU.toFixed(4) + ' AU';
      document.getElementById('tt-v').textContent = 'double-tap to focus';
    } else {
      hit = false;
    }
  }

  if (hit) {
    tt.classList.add('show');
    tt.classList.add('mobile-tap');
    if (_ttHideTimer) clearTimeout(_ttHideTimer);
    _ttHideTimer = setTimeout(_hideTapTooltip, 2000);   // auto-hide after 2 s
  } else {
    _hideTapTooltip();                                  // tap on empty space
  }
}

// ─── Touch controls ───────────────────────────────────────────
// 1 finger: orbit. 2-finger pinch: dolly (ratio of finger distances).
// 2-finger parallel drag: pan (centroid movement). Same math as the mouse.
// touchend doubles as the tap / double-tap detector (dblclick never fires
// reliably on mobile): a tap = ≤10px travel; two taps within 300 ms = the
// same action as the desktop double-click.
(function () {
  let touchOrbit = null;         // { x, y } — last 1-finger position
  let pinchDist  = null;         // last 2-finger distance
  let lastCX = 0, lastCY = 0;    // last 2-finger centroid
  let tapStart = null;           // 1-finger touchstart position (tap test)
  let lastTapT = 0;              // timestamp of the previous qualifying tap
  let lastTapX = 0, lastTapY = 0;

  cv.addEventListener('touchstart', function (e) {
    _lastInteractT = performance.now();
    if (e.touches.length === 2) {
      pinchDist = Math.hypot(
        e.touches[0].clientX - e.touches[1].clientX,
        e.touches[0].clientY - e.touches[1].clientY
      );
      lastCX = (e.touches[0].clientX + e.touches[1].clientX) / 2;
      lastCY = (e.touches[0].clientY + e.touches[1].clientY) / 2;
      touchOrbit = null;
      tapStart = null;
      e.preventDefault();
    } else if (e.touches.length === 1) {
      touchOrbit = { x: e.touches[0].clientX, y: e.touches[0].clientY };
      tapStart = { x: e.touches[0].clientX, y: e.touches[0].clientY };
      pinchDist = null;
    }
  }, { passive: false });

  cv.addEventListener('touchmove', function (e) {
    e.preventDefault();
    _lastInteractT = performance.now();
    if (e.touches.length === 2 && pinchDist !== null) {
      // Pinch = exponential dolly
      var d = Math.hypot(
        e.touches[0].clientX - e.touches[1].clientX,
        e.touches[0].clientY - e.touches[1].clientY
      );
      if (d > 1) {
        var ratio = pinchDist / d;
        if (state.focusTarget && !_focusFollow && !_exitAnim) {
          _focusDistTarget = Math.max(_focusMinDist, Math.min(120, _focusDistTarget * ratio));
        } else {
          var minD = _focusFollow ? _focusMinDist : 0.0005;
          state.cam.dist = Math.max(minD, Math.min(120, state.cam.dist * ratio));
        }
        pinchDist = d;
      }
      // Parallel drag = pan via centroid movement (no-op while focused)
      var cx = (e.touches[0].clientX + e.touches[1].clientX) / 2;
      var cy = (e.touches[0].clientY + e.touches[1].clientY) / 2;
      camPan(cx - lastCX, cy - lastCY);
      lastCX = cx; lastCY = cy;
    } else if (e.touches.length === 1 && touchOrbit) {
      var dx = e.touches[0].clientX - touchOrbit.x;
      var dy = e.touches[0].clientY - touchOrbit.y;
      state.cam.theta -= dx * 0.005;
      state.cam.phi = Math.min(1.48, Math.max(-1.48, state.cam.phi + dy * 0.005));
      _camVTheta = -dx * 0.005; _camVPhi = dy * 0.005;
      touchOrbit = { x: e.touches[0].clientX, y: e.touches[0].clientY };
    }
  }, { passive: false });

  cv.addEventListener('touchend', function (e) {
    // ── Tap / double-tap detection ──
    // A tap = single finger lifted after ≤10px of travel. Two taps within
    // 300 ms and ~30px of each other = double-tap → same as dblclick.
    var wasTap = false, tx = 0, ty = 0;
    if (tapStart && e.touches.length === 0 && e.changedTouches.length === 1) {
      var ct = e.changedTouches[0];
      if (Math.hypot(ct.clientX - tapStart.x, ct.clientY - tapStart.y) <= 10) {
        wasTap = true; tx = ct.clientX; ty = ct.clientY;
      }
    }
    tapStart = null;
    if (wasTap) {
      var nowT = performance.now();
      var rc = cv.getBoundingClientRect();
      var mx = tx - rc.left, my = ty - rc.top;
      if (nowT - lastTapT < 300 && Math.hypot(tx - lastTapX, ty - lastTapY) < 30) {
        lastTapT = 0;
        _hideTapTooltip();
        _handleDoubleActivate(mx, my);       // same logic as the dblclick handler
      } else {
        lastTapT = nowT; lastTapX = tx; lastTapY = ty;
        _mobileTap(mx, my);                  // tooltip + hover state (single tap)
      }
    }

    if (e.touches.length < 2) pinchDist = null;
    if (e.touches.length === 0) touchOrbit = null;
    else if (e.touches.length === 1) {
      touchOrbit = { x: e.touches[0].clientX, y: e.touches[0].clientY };
    }
  });
})();

// Wrap renderSelected so mobile sheet summary stays in sync
renderSelected = (function (orig) {
  return function () {
    orig();
    var n = NEOS.find(function (x) { return x.id === state.selectedId; });
    if (n) _updateSheetSummary(n);
  };
}(renderSelected));

renderList(); renderSelected(); renderAlignments(); updateScaleBar();

// Custom timezone dropdowns — desktop + mobile stay in sync
(function () {
  var TZLABELS = {
    'UTC':                 'UTC',
    'America/Sao_Paulo':   'BRT (Brasília)',
    'America/New_York':    'EST (New York)',
    'America/Los_Angeles': 'PST (Los Angeles)',
    'Europe/London':       'GMT (London)',
    'Europe/Paris':        'CET (Paris)',
    'Asia/Tokyo':          'JST (Tokyo)',
    'Asia/Shanghai':       'CST (Shanghai)',
    'Australia/Sydney':    'AEST (Sydney)',
  };

  // Collect both dropdown instances (desktop + mobile)
  var instances = [
    { trigger: document.getElementById('tz-trigger'),
      menu:    document.getElementById('tz-menu'),
      current: document.getElementById('tz-current') },
    { trigger: document.getElementById('tz-trigger-mobile'),
      menu:    document.getElementById('tz-menu-mobile'),
      current: document.getElementById('tz-current-mobile') },
  ].filter(function (d) { return d.trigger && d.menu && d.current; });

  function closeAll() {
    instances.forEach(function (d) { d.menu.classList.remove('open'); });
  }

  function applyTz(tz) {
    _selectedTz = tz;
    instances.forEach(function (d) {
      d.current.textContent = TZLABELS[tz] || tz;
      d.menu.querySelectorAll('li').forEach(function (li) {
        li.classList.toggle('active', li.dataset.tz === tz);
      });
    });
    updateClock();
  }

  instances.forEach(function (d) {
    // Toggle open/close on trigger click
    d.trigger.addEventListener('click', function (e) {
      e.stopPropagation();
      var wasOpen = d.menu.classList.contains('open');
      closeAll();
      if (!wasOpen) d.menu.classList.add('open');
    });
    // Select timezone on option click
    d.menu.querySelectorAll('li').forEach(function (li) {
      li.addEventListener('click', function () {
        applyTz(li.dataset.tz);
        closeAll();
      });
    });
  });

  // Close on any outside click
  document.addEventListener('click', closeAll);

  // Initialize both to detected timezone
  applyTz(_selectedTz);
}());
</script>

