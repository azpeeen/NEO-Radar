    state._focusOrientTarget = 'mag';
  }

  _beginFocusGlide();
  _syncAsteroidMesh();                         // NEO/MPC: 3D mesh in the MAIN scene
  _refreshReprNotice();
  _refreshMagHud();

  document.getElementById('fh-name').textContent = target.name;
  document.getElementById('fh-desig').textContent = target.desig;
}

function enterFocus(target) {
  // Piloting: every "focus this" entry point (sidebar button, search, deep
  // links) becomes a destination for the autopilot instead
  if (_pilot && _pilot.active) { _pilotSetTarget(target, true); return; }
  if (state.focusTarget) return;               // already focused / animating out
  state._camBeforeFocus = Object.assign({}, state.cam);
  state.focusMode = true;
  _applyFocusTarget(target);
  document.getElementById('focus-hud').classList.add('show');
  _container.classList.add('focus-active');
  document.getElementById('tooltip').classList.remove('show');
  state.hoverId = null; state.hoverPlanet = null; _hoverMPC = null; state.hoverMoon = null;
  state.hoverDwarf = null; state.hoverComet = null;
}

// Focus → focus swap (single click/tap on another object while focused):
// the entry glide re-runs from the CURRENT camera, so the dolly flows
// object → object — Moon included — with no exit round-trip.
function _switchFocus(target) {
