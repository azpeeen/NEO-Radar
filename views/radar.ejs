// ─── Focus Mode ──────────────────────────────────────────────────────────────
// Double-click any object (planet, tracked NEO, MPC asteroid) — or press F on
// hover, or the sidebar Focus button — for a cinematic single-object view.
// ESC / double-click on empty space exits. tick() drives the fade-through-black
// entry/exit animation via state.focusLerp (~1.2 s, easeInOutCubic).

var _focusSaved = null;        // pan/zoom snapshot restored on exit
var _focusModelText = null;    // #repr-notice override when a NASA GLB is shown
var _promoModelText = null;    // same, for the promoted dossier object

function _easeInOutCubic(t) {
  return t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
}

function _refreshReprNotice() {
  var el = document.getElementById('repr-notice');
  if (!el) return;
  var txt = null;
  if (state.focusTarget) {
    if (state.focusTarget.type !== 'planet' && state.focusTarget.type !== 'luna') {
      txt = _focusModelText || '⚠ ARTISTIC REPRESENTATION · ACTUAL SHAPE UNKNOWN';
    }
  } else if (_promotedAst) {
    txt = _promoModelText || '⚠ ARTISTIC REPRESENTATION';
  }
  if (txt) { el.textContent = txt; el.style.display = ''; }
  else el.style.display = 'none';
}

// Renderer callback: a real NASA shape model replaced the procedural mesh
_renderer.onModelApplied = function (context, key, noticeText) {
  if (context === 'focus') _focusModelText = noticeText;
  else if (context === 'promoted') _promoModelText = noticeText;
  _refreshReprNotice();
};

// Closed orbit loop for an MPC asteroid, sampled over one period from now —
// same solver path as its live position (Kepler + secular), page-side only.
function buildMPCOrbitPts(ast, segments) {
  var jd0 = _SIM_EPOCH_JD + state.simTime;
  var P = 365.25 * Math.pow(ast.a, 1.5);
  var pts = new Float32Array(segments * 3);
  for (var k = 0; k < segments; k++) {
    var p = getMPCPosition(ast, jd0 + (k / segments) * P);
    pts[k * 3] = p.x; pts[k * 3 + 1] = p.y;
  }
  return pts;
}

function _focusTargetPos(t) {
  var tg = state.focusTarget;
  if (tg.type === 'planet') return orbitPos(PLANETS[tg.idx], t);
  if (tg.type === 'neo')    return orbitPos(NEOS[tg.idx], t);
  if (tg.type === 'luna') {
    var ep = orbitPos(PLANETS[2], t), mp = moonPos(t);
    return { x: ep.x + mp.x, y: ep.y + mp.y };
  }
  return getMPCPosition(tg.ast, _SIM_EPOCH_JD + t);
}

var _fhVel   = document.getElementById('fh-vel');
var _fhSun   = document.getElementById('fh-sun');
var _fhEarth = document.getElementById('fh-earth');

function updateFocusHud(pos, t) {
  var tg = state.focusTarget;
  if (!tg) return;
  var r = Math.hypot(pos.x, pos.y);
  if (tg.type === 'luna') {
    // Circular presentation orbit: distance and speed are constants
    _fhVel.textContent   = '1.02 km/s';
    _fhSun.textContent   = r.toFixed(3) + ' AU';
    _fhEarth.textContent = '384,400 km';
    return;
  }
  var ep = orbitPos(PLANETS[2], t);
  var dE_LD = Math.hypot(pos.x - ep.x, pos.y - ep.y) / 0.00257;
  _fhVel.textContent   = tg.a && r > 0 ? visVivaKms(tg.a, r).toFixed(1) + ' km/s' : '—';
  _fhSun.textContent   = r.toFixed(3) + ' AU';
  _fhEarth.textContent = (dE_LD < 100 ? dE_LD.toFixed(2) : dE_LD.toFixed(0)) + ' LD';
}

function enterFocus(target) {
  if (state.focusTarget) return;               // already focused / animating out
  _focusSaved = { panX: state.panX, panY: state.panY, zoom: state.zoom };
  state.focusMode = true;
  state.focusLerp = 0;
  state._focusCamTheta = 0;
  state._focusCamPhi = Math.PI / 4;
  state._focusCamRadius = 1.5;

  var desc;
  if (target.type === 'planet') {
    var p = PLANETS[target.idx];
    target.a = p.a; target.name = p.name;
    target.desig = 'PLANET · a = ' + p.a.toFixed(3) + ' AU';
    desc = { kind: 'planet', index: target.idx, name: p.name, orbitPts: buildOrbitPts(p, 256) };
  } else if (target.type === 'neo') {
    var n = NEOS[target.idx];
    target.a = n.a; target.name = n.name; target.desig = n.desig;
    desc = { kind: 'neo', designation: n.id, name: n.name, orbitPts: buildOrbitPts(n, 256) };
  } else if (target.type === 'luna') {
    target.a = 1.0; target.name = 'Moon';
    target.desig = 'EARTH SATELLITE · P = 27.32 D';
    desc = { kind: 'luna', name: 'Moon' };   // renderer builds the geocentric orbit
  } else {
    var ast = target.ast;
    target.a = ast.a; target.name = ast.name || ast.designation; target.desig = ast.designation;
    desc = { kind: 'mpc', designation: ast.designation, name: ast.name, orbitPts: buildMPCOrbitPts(ast, 256) };
  }
  state.focusTarget = target;

  _focusModelText = null;
  _renderer.setFocusTarget(desc);              // may fire onModelApplied synchronously
  // Start the camera at 2.5× the object's visual radius (min 0.4) — always
  // outside the surface: Earth 0.35, Jupiter 0.7, asteroids/Moon 0.4
  state._focusCamRadius = Math.max(_renderer.getFocusObjectRadius() * 2.5, 0.4);
  _refreshReprNotice();

  document.getElementById('fh-name').textContent = target.name;
  document.getElementById('fh-desig').textContent = target.desig;
  document.getElementById('focus-hud').classList.add('show');
  _container.classList.add('focus-active');
  document.getElementById('tooltip').classList.remove('show');
  state.hoverId = null; state.hoverPlanet = null; _hoverMPC = null; state.hoverLuna = false;
}

// Click on the Moon while focused on Earth → the Moon becomes the focus.
// focusLerp reset to the midpoint replays only the fade-from-black half.
function _switchFocusToLuna() {
  var target = { type: 'luna', a: 1.0, name: 'Moon', desig: 'EARTH SATELLITE · P = 27.32 D' };
  state.focusTarget = target;
  state.focusLerp = 0.5;
  state._focusCamRadius = 1.2;
  _focusModelText = null;
  _renderer.setFocusTarget({ kind: 'luna', name: 'Moon' });
  _refreshReprNotice();
  document.getElementById('fh-name').textContent = target.name;
  document.getElementById('fh-desig').textContent = target.desig;
}

function exitFocus() {
  if (!state.focusMode) return;
  state.focusMode = false;                     // tick() animates focusLerp → 0
  if (_focusSaved) {
    state.panX = _focusSaved.panX; state.panY = _focusSaved.panY; state.zoom = _focusSaved.zoom;
  }
  document.getElementById('focus-hud').classList.remove('show');
}

function _finishExitFocus() {                  // called by tick() once lerp hits 0
  state.focusTarget = null;
  _renderer.clearFocusTarget();
  _focusModelText = null;
  _refreshReprNotice();
  _container.classList.remove('focus-active');
}

document.getElementById('fh-exit').addEventListener('click', exitFocus);
document.getElementById('focus-btn').addEventListener('click', function (e) {
  e.preventDefault();
  var idx = NEOS.findIndex(function (n) { return n.id === state.selectedId; });
  if (idx >= 0) enterFocus({ type: 'neo', idx: idx });
});

// ─── Drag-pan state ──────────────────────────────────────────────────────────
let _panDragging = false, _panSX = 0, _panSY = 0, _panX0 = 0, _panY0 = 0;
let _panLX = 0, _panLY = 0;   // last mouse position (focus-mode camera orbit)

cv.style.cursor = 'grab';

cv.addEventListener('mousedown', e => {
  if (e.button !== 0) return;
  _panDragging = true;
  _panSX = e.clientX; _panSY = e.clientY;
  _panLX = e.clientX; _panLY = e.clientY;
  _panX0 = state.panX; _panY0 = state.panY;
  cv.style.cursor = 'grabbing';
});

cv.addEventListener('mouseup', () => {
  if (_panDragging) { _panDragging = false; cv.style.cursor = 'grab'; }
});

cv.addEventListener('dblclick', e => {
  if (state.focusTarget) {
    // Exit only when the double-click lands on empty space — the focused
    // object always projects to the screen centre, so a centre hit is "on it".
    const r = cv.getBoundingClientRect();
    const dx = (e.clientX - r.left) - r.width / 2;
    const dy = (e.clientY - r.top) - r.height / 2;
    // A double-click on the orbiting Moon is a re-focus (handled by click), not an exit
    const fmp = _renderer.getFocusMoonScreenPos();
    if (fmp && Math.hypot((e.clientX - r.left) - fmp.x, (e.clientY - r.top) - fmp.y) < Math.max(12, fmp.r + 6)) return;
    const objPx = (_renderer.getFocusObjectRadius() / (state._focusCamRadius * Math.tan(25 * Math.PI / 180))) * (r.height / 2);
    if (Math.hypot(dx, dy) > Math.max(40, objPx)) exitFocus();
    return;
  }
  if (state.hoverId) {
    const idx = NEOS.findIndex(n => n.id === state.hoverId);
    if (idx >= 0) enterFocus({ type: 'neo', idx });
  } else if (state.hoverLuna) {
    enterFocus({ type: 'luna' });
  } else if (state.hoverPlanet) {
    const idx = PLANETS.findIndex(p => p.key === state.hoverPlanet);
    if (idx >= 0) enterFocus({ type: 'planet', idx });
  } else if (state.showMPC && _mpcLoaded) {
    // Re-run the spatial-hash hit test: the first click of a double-click on
    // an MPC asteroid opens the dossier, which clears _hoverMPC.
    const rc = cv.getBoundingClientRect();
    const hit = _mpcHit(e.clientX - rc.left, e.clientY - rc.top);
    if (hit) enterFocus({ type: 'mpc', ast: hit.ast });
    else { state.panX = 0; state.panY = 0; }
  } else {
    state.panX = 0; state.panY = 0;            // original behaviour: recentre
  }
});

cv.addEventListener('mousemove',e=>{
  const r=cv.getBoundingClientRect(),x=e.clientX-r.left,y=e.clientY-r.top;
  if (state.focusTarget) {
    // Focus mode: drag orbits the camera around the object (spherical coords)
    if (_panDragging) {
      state._focusCamTheta += (e.clientX - _panLX) * 0.008;
      state._focusCamPhi = Math.min(Math.PI - 0.1, Math.max(0.1,
        state._focusCamPhi + (e.clientY - _panLY) * 0.008));
    }
    _panLX = e.clientX; _panLY = e.clientY;
    return;
  }
  _panLX = e.clientX; _panLY = e.clientY;
  if (_panDragging) {
    state.panX = _panX0 + (e.clientX - _panSX);
    state.panY = _panY0 + (e.clientY - _panSY);
  }
  let best=null,bestD=22;
  for(const n of NEOS){const p=orbitPos(n,state.simTime),s=ws(p.x,p.y),d=Math.hypot(s.x-x,s.y-y);if(d<bestD){bestD=d;best=n;}}
  // Check planet hover
  let bestPlanet=null,bestPD=18;
  if(state.showPlanets){
    for(const p of PLANETS){
      if(!state.planetToggles[p.key])continue;
      const pos=orbitPos(p,state.simTime),s=ws(pos.x,pos.y),d=Math.hypot(s.x-x,s.y-y);
      if(d<bestPD){bestPD=d;bestPlanet=p;}
    }
  }
  // Moon hover — only once it is visually clear of Earth's disc (sep > 3px),
  // and only when the cursor is closer to the Moon than to any planet
  state.hoverLuna=false;
  let lunaHit=false;
  if(!best && state.showPlanets && state.planetToggles.earth){
    const luna=_renderer.getLunaScreenPos(state);
    if(luna && luna.sep>3){
      const dL=Math.hypot(x-luna.x,y-luna.y);
      if(dL<luna.r+8 && (!bestPlanet||dL<bestPD)) lunaHit=true;
    }
  }
  const tt=document.getElementById('tooltip');
  if(best){
    state.hoverId=best.id; state.hoverPlanet=null; _hoverMPC=null;
    tt.style.left=x+'px';tt.style.top=y+'px';tt.classList.add('show');
    document.getElementById('tt-name').textContent=best.name;
    document.getElementById('tt-desig').textContent=best.desig;
    document.getElementById('tt-d').textContent=`${best.nextLD} LD · ${best.nextKm} km`;
    document.getElementById('tt-v').textContent=`${best.vel} km/s`;
    cv.style.cursor='pointer';
  } else if(lunaHit){
    state.hoverId=null; state.hoverPlanet=null; _hoverMPC=null; state.hoverLuna=true;
    tt.style.left=x+'px';tt.style.top=y+'px';tt.classList.add('show');
    document.getElementById('tt-name').textContent='Moon';
    document.getElementById('tt-desig').textContent='EARTH SATELLITE · P = 27.32 D';
    document.getElementById('tt-d').textContent='1.00 LD · 384,400 km';
    document.getElementById('tt-v').textContent='1.02 km/s';
    cv.style.cursor='pointer';
  } else if(bestPlanet){
    state.hoverId=null; state.hoverPlanet=bestPlanet.key; _hoverMPC=null;
    tt.style.left=x+'px';tt.style.top=y+'px';tt.classList.add('show');
    const pos=orbitPos(bestPlanet,state.simTime);
    const r_AU=Math.sqrt(pos.x*pos.x+pos.y*pos.y);
    const T_yr=Math.pow(bestPlanet.a,1.5);
    const spd=visVivaKms(bestPlanet.a, r_AU);
    document.getElementById('tt-name').textContent=bestPlanet.name;
    document.getElementById('tt-desig').textContent=`T = ${T_yr.toFixed(2)} yr`;
    document.getElementById('tt-d').textContent=`${r_AU.toFixed(3)} AU`;
    document.getElementById('tt-v').textContent=`${spd} km/s`;
    cv.style.cursor='pointer';
  } else if(state.showMPC && _mpcLoaded) {
    // ── MPC asteroid hover via O(1) spatial hash ──────────────────────────
    const hit = _mpcHit(x, y);
    if(hit){
      state.hoverId=null; state.hoverPlanet=null; _hoverMPC=hit;
      const ast=hit.ast;
      const currentJD = _SIM_EPOCH_JD + state.simTime;
      const astPos = getMPCPosition(ast, currentJD);
      const earthPos = orbitPos(PLANETS[2], state.simTime);
      const dist_AU = Math.hypot(astPos.x - earthPos.x, astPos.y - earthPos.y);
      const dist_LD = (dist_AU / 0.00257).toFixed(2);
      const q = ast.a * (1 - ast.e);
      const type = ast.a < 1 ? 'Aten' : q < 1.017 ? 'Apollo' : q < 1.3 ? 'Amor' : 'MBA';
      tt.style.left=x+'px'; tt.style.top=y+'px'; tt.classList.add('show');
      document.getElementById('tt-name').textContent = ast.name || ast.designation;
      document.getElementById('tt-desig').textContent = ast.designation + ' · ' + type + ' · H=' + (ast.H||'?');
      document.getElementById('tt-d').textContent = dist_LD + ' LD · ' + dist_AU.toFixed(4) + ' AU';
      document.getElementById('tt-v').textContent = 'click for N-body dossier';
      cv.style.cursor='pointer';
    } else {
      state.hoverId=null; state.hoverPlanet=null; _hoverMPC=null;
      tt.classList.remove('show');
      if(!_panDragging) cv.style.cursor='grab';
    }
  } else{
    state.hoverId=null; state.hoverPlanet=null; _hoverMPC=null;
    tt.classList.remove('show');
    if(!_panDragging) cv.style.cursor='grab';
  }
});

cv.addEventListener('mouseleave',()=>{
  _panDragging=false;
  state.hoverId=null; state.hoverPlanet=null; state.hoverLuna=false;
  document.getElementById('tooltip').classList.remove('show');
  cv.style.cursor='grab';
});
cv.addEventListener('click',e=>{
  if(state.focusTarget){
    // Focus mode: the only live click target is the Moon while Earth is focused
    if(state.focusMode && state.focusLerp>=0.5   // focus scene actually on screen
       && state.focusTarget.type==='planet' && PLANETS[state.focusTarget.idx].key==='earth'
       && Math.hypot(e.clientX-_panSX,e.clientY-_panSY)<4){   // ignore drag-release
      const rc=cv.getBoundingClientRect();
      const mp=_renderer.getFocusMoonScreenPos();
      if(mp && Math.hypot((e.clientX-rc.left)-mp.x,(e.clientY-rc.top)-mp.y)<Math.max(12,mp.r+6)){
        _switchFocusToLuna();
      }
    }
    return;
  }
  if(state.hoverId){
    // Close dossier when clicking a tracked NEO
    closeMPCDossier();
    state.selectedId=state.hoverId; renderList(); renderSelected();
  } else if(_hoverMPC) {
    // Promote MPC asteroid to N-body and open dossier
    openMPCDossier(_hoverMPC);
  }
});
cv.addEventListener('wheel',e=>{
  e.preventDefault();
  if (state.focusTarget) {
    // Focus mode: wheel moves the camera along its orbit radius — floor it
    // just above the focused object's surface (big planets are >1 unit)
    state._focusCamRadius = Math.max(Math.max(0.15, _renderer.getFocusObjectRadius() * 1.15), Math.min(8,
      state._focusCamRadius * (1 + Math.sign(e.deltaY) * 0.12)));
    return;
  }
  state.zoom=Math.max(0.035,Math.min(15,state.zoom*(1-Math.sign(e.deltaY)*0.12)));
  document.getElementById('scale-val').textContent=`1 AU = ${(state.pxPerAU*state.zoom).toFixed(0)} px`;
},{passive:false});
document.addEventListener('keydown',e=>{
  if(e.target.tagName==='INPUT')return;
  if(e.key==='Escape'&&state.focusMode){exitFocus();return;}
  if((e.key==='f'||e.key==='F')&&!state.focusTarget){
    if(state.hoverId){const idx=NEOS.findIndex(n=>n.id===state.hoverId);if(idx>=0)enterFocus({type:'neo',idx});}
    else if(state.hoverLuna){enterFocus({type:'luna'});}
    else if(state.hoverPlanet){const idx=PLANETS.findIndex(p=>p.key===state.hoverPlanet);if(idx>=0)enterFocus({type:'planet',idx});}
    else if(_hoverMPC){enterFocus({type:'mpc',ast:_hoverMPC.ast});}
    return;
  }
  if(e.key==='/'){e.preventDefault();document.getElementById('search-input').focus();}
  if(e.key===' '){e.preventDefault();document.getElementById('btn-play').click();}
});

// ─── Return to Live button ─────────────────────────────────────────────────
// J2000.0 = 2000-Jan-01 12:00:00 UTC
const _J2000_MS = Date.UTC(2000, 0, 1, 12, 0, 0);
// Sim epoch offset: simTime=0 corresponds to 2026-05-27 12:00 (9643 days from J2000)
const _T_SIM_MS = _J2000_MS + 9643 * 86400000;

function _nowSimDays() {
  // Current real time expressed as days from T_SIM (the sim epoch)
  return (Date.now() - _T_SIM_MS) / 86400000;
}

// Threshold: within 1 real minute of "now" = 1/(24*60) days
const _LIVE_THRESH_DAYS = 1 / (24 * 60);

function _updateLiveBtn() {
  // is-live class (cobalt + pulsing dot) fires when simulating —
  // it signals "you've left live mode, click to return".
  const isSimulating = state.playing;

  ['btn-live', 'fab-live'].forEach(function (id) {
    const el = document.getElementById(id);
    if (!el) return;
    el.classList.toggle('is-live', isSimulating);
    const label = el.querySelector('#live-label, .fab-label');
    if (label) label.textContent = isSimulating ? '● LIVE' : 'SIMULATE';
    const dot = el.querySelector('#live-dot, .fab-dot');
    if (dot) dot.style.animationPlayState = isSimulating ? 'running' : 'paused';
  });
}

function _handleLive() {
  if (state.playing) {
    // Simulate → Live: stop accumulation, pin immediately to Date.now()
    state.playing  = false;
    state.simTime  = (Date.now() - _T_SIM_RAF) / 86400000;
    playIc.innerHTML = '<path d="M8 5v14l11-7z"/>';  // play icon
  } else {
    // Live → Simulate: start accumulating from current real time
    state.playing = true;
    playIc.innerHTML = '<path d="M6 5h4v14H6zM14 5h4v14h-4z"/>';  // pause icon
  }
  _updateLiveBtn();
}
// Both LIVE buttons (desktop topbar + mobile FAB) share the exact same handler
[document.getElementById('btn-live'), document.getElementById('fab-live')]
  .filter(Boolean)
  .forEach(function (btn) {
    btn.addEventListener('click', _handleLive);
    btn.addEventListener('touchend', function (e) {
      e.preventDefault(); // suppress ghost click after touchend
      _handleLive();
    });
  });

// Poll every second: update button state + optionally sync clock display
setInterval(() => { _updateLiveBtn(); }, 1000);
_updateLiveBtn();

// ─── Bottom-sheet (mobile) ────────────────────────────────────
const _sidebar     = document.getElementById('radar-sidebar');
const _sheetHandle = document.getElementById('sheet-handle');

if (_sheetHandle && _sidebar) {
  var _dragStartY  = null;
  var _dragDeltaY  = 0;
  var CLOSE_THRESH = 80; // px of downward drag required to close

  _sheetHandle.addEventListener('touchstart', function (e) {
    _dragStartY = e.touches[0].clientY;
    _dragDeltaY = 0;
    // Remove CSS transition so the sheet tracks the finger in real time
    _sidebar.style.transition = 'none';
  }, { passive: true });

  _sheetHandle.addEventListener('touchmove', function (e) {
    if (_dragStartY === null) return;
    _dragDeltaY = e.touches[0].clientY - _dragStartY;
    // Only translate downward, and only when the sheet is currently open
    if (_dragDeltaY > 0 && _sidebar.classList.contains('sheet-open')) {
      _sidebar.style.transform = 'translateY(' + _dragDeltaY + 'px)';
      e.preventDefault();
    }
  }, { passive: false });

  _sheetHandle.addEventListener('touchend', function (e) {
    e.preventDefault(); // suppress ghost click
    // Re-enable smooth CSS transition for the snap animation
    _sidebar.style.transition = '';
    _sidebar.style.transform  = ''; // hand control back to CSS class

    if (_sidebar.classList.contains('sheet-open')) {
      // Drag down past threshold OR simple tap → close
      if (_dragDeltaY > CLOSE_THRESH || Math.abs(_dragDeltaY) < 10) {
        _sidebar.classList.remove('sheet-open');
      }
      // else: partial drag — spring back to open (CSS transition handles it)
    } else {
      // Sheet is collapsed: tap → open
      if (Math.abs(_dragDeltaY) < 10) {
        _sidebar.classList.add('sheet-open');
      }
    }

    _dragStartY = null;
    _dragDeltaY = 0;
  }, { passive: false });

  // Desktop fallback: mouse click toggles the sheet
  _sheetHandle.addEventListener('click', function () {
    _sidebar.classList.toggle('sheet-open');
  });
}
// Update the collapsed summary whenever selection changes
function _updateSheetSummary(n) {
  const nameEl = document.getElementById('sheet-name');
  const riskEl = document.getElementById('sheet-risk');
  if (nameEl) nameEl.textContent = n.name;
  if (riskEl) { riskEl.className = 'risk ' + n.risk; riskEl.textContent = n.label; }
}

// ─── Touch controls ───────────────────────────────────────────
(function () {
  let pinchDist = null;
  let panStart  = null;

  cv.addEventListener('touchstart', function (e) {
    if (e.touches.length === 2) {
      pinchDist = Math.hypot(
        e.touches[0].clientX - e.touches[1].clientX,
        e.touches[0].clientY - e.touches[1].clientY
      );
      panStart = null;
      e.preventDefault();
    } else if (e.touches.length === 1) {
      panStart  = { x: e.touches[0].clientX, y: e.touches[0].clientY };
      pinchDist = null;
    }
  }, { passive: false });

  cv.addEventListener('touchmove', function (e) {
    e.preventDefault();
    if (state.focusTarget) {
      // Focus mode: pinch = camera radius, single-finger drag = orbit
      if (e.touches.length === 2 && pinchDist !== null) {
        var dF = Math.hypot(
          e.touches[0].clientX - e.touches[1].clientX,
          e.touches[0].clientY - e.touches[1].clientY
        );
        state._focusCamRadius = Math.max(Math.max(0.15, _renderer.getFocusObjectRadius() * 1.15), Math.min(8,
          state._focusCamRadius * (pinchDist / dF)));
        pinchDist = dF;
      } else if (e.touches.length === 1 && panStart) {
        state._focusCamTheta += (e.touches[0].clientX - panStart.x) * 0.008;
        state._focusCamPhi = Math.min(Math.PI - 0.1, Math.max(0.1,
          state._focusCamPhi + (e.touches[0].clientY - panStart.y) * 0.008));
        panStart = { x: e.touches[0].clientX, y: e.touches[0].clientY };
      }
      return;
    }
    if (e.touches.length === 2 && pinchDist !== null) {
      var d = Math.hypot(
        e.touches[0].clientX - e.touches[1].clientX,
        e.touches[0].clientY - e.touches[1].clientY
      );
      state.zoom = Math.max(0.008, Math.min(50, state.zoom * (d / pinchDist)));
      pinchDist  = d;
      document.getElementById('scale-val').textContent =
        '1 AU = ' + (state.pxPerAU * state.zoom).toFixed(0) + ' px';
    } else if (e.touches.length === 1 && panStart) {
      state.panX += e.touches[0].clientX - panStart.x;
      state.panY += e.touches[0].clientY - panStart.y;
      panStart = { x: e.touches[0].clientX, y: e.touches[0].clientY };
    }
  }, { passive: false });

  cv.addEventListener('touchend', function (e) {
    if (e.touches.length < 2) pinchDist = null;
    if (e.touches.length === 0) panStart = null;
  });
})();

// Wrap renderSelected so mobile sheet summary stays in sync
renderSelected = (function (orig) {
  return function () {
    orig();
    var n = NEOS.find(function (x) { return x.id === state.selectedId; });
    if (n) _updateSheetSummary(n);
  };
}(renderSelected));

renderList(); renderSelected(); renderAlignments(); updateScaleBar();

// Custom timezone dropdowns — desktop + mobile stay in sync
(function () {
  var TZLABELS = {
    'UTC':                 'UTC',
    'America/Sao_Paulo':   'BRT (Brasília)',
    'America/New_York':    'EST (New York)',
    'America/Los_Angeles': 'PST (Los Angeles)',
    'Europe/London':       'GMT (London)',
    'Europe/Paris':        'CET (Paris)',
    'Asia/Tokyo':          'JST (Tokyo)',
    'Asia/Shanghai':       'CST (Shanghai)',
    'Australia/Sydney':    'AEST (Sydney)',
  };

  // Collect both dropdown instances (desktop + mobile)
  var instances = [
    { trigger: document.getElementById('tz-trigger'),
      menu:    document.getElementById('tz-menu'),
      current: document.getElementById('tz-current') },
    { trigger: document.getElementById('tz-trigger-mobile'),
      menu:    document.getElementById('tz-menu-mobile'),
      current: document.getElementById('tz-current-mobile') },
  ].filter(function (d) { return d.trigger && d.menu && d.current; });

  function closeAll() {
    instances.forEach(function (d) { d.menu.classList.remove('open'); });
  }

  function applyTz(tz) {
    _selectedTz = tz;
    instances.forEach(function (d) {
      d.current.textContent = TZLABELS[tz] || tz;
      d.menu.querySelectorAll('li').forEach(function (li) {
        li.classList.toggle('active', li.dataset.tz === tz);
      });
    });
    updateClock();
  }

  instances.forEach(function (d) {
    // Toggle open/close on trigger click
    d.trigger.addEventListener('click', function (e) {
      e.stopPropagation();
      var wasOpen = d.menu.classList.contains('open');
      closeAll();
      if (!wasOpen) d.menu.classList.add('open');
    });
    // Select timezone on option click
    d.menu.querySelectorAll('li').forEach(function (li) {
      li.addEventListener('click', function () {
        applyTz(li.dataset.tz);
        closeAll();
      });
    });
  });

  // Close on any outside click
  document.addEventListener('click', closeAll);

  // Initialize both to detected timezone
  applyTz(_selectedTz);
}());
</script>

