  if (T && T.custom) { var q = _bodyPos(T.tg, t); T.x = q.x; T.y = q.y; T.z = q.z || 0; }
}

// Unit vector from a body toward the Sun (the Sun itself: +X, arbitrary)
function _pilotSunDir(b, out) {
  var L = Math.hypot(b.x, b.y, b.z);
  if (L < 1e-9) return out.set(1, 0, 0);
  return out.set(-b.x / L, -b.y / L, -b.z / L);
}
// Where the ship should sit to look at body `b`: `dist` from its centre, on
// the day side, pulled a little toward `hint` (where the ship is coming from)
// and above the ecliptic so the terminator shows.
function _pilotViewPoint(b, dist, hint, out) {
  if (b.tg.type === 'sun') {
    out.copy(hint);
  } else {
    _pilotSunDir(b, out).multiplyScalar(0.7);
    out.x += hint.x * 0.3; out.y += hint.y * 0.3; out.z += hint.z * 0.3 + 0.25;
  }
  if (out.lengthSq() < 1e-12) out.set(0, 0, 1);
