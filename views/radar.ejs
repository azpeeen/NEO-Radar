async function openMPCDossier(entry) {
  const ast = entry.ast || entry;
  _promotedAst    = ast;
  _promotedResult = null;
  _hoverMPC       = null;

  // 3D mesh — NASA shape model when the designation has one, procedural
  // otherwise. promote() fires onModelApplied when a real GLB lands and the
  // #repr-notice text upgrades from "artistic" to the mission credit.
  _promoModelText = null;
  _renderer.promote(ast.designation, ast.name);
  _refreshReprNotice();

  const dossier = document.getElementById('mpc-dossier');
  dossier.classList.add('open');

  // Reset CA section to loading state
  document.getElementById('dos-ca-idle').style.display = '';
  document.getElementById('dos-ca-spinner').style.display = 'none';
  document.getElementById('dos-ca-content').style.display = 'none';
  document.getElementById('dos-ca-error').style.display = 'none';

  // Update HUD
  const hudLine = document.getElementById('hud-promoted-line');
  const hudName = document.getElementById('hud-promoted-name');
  if (hudLine) hudLine.style.display = '';
  if (hudName) hudName.textContent = ast.name || ast.designation;

  const desig = encodeURIComponent(ast.designation);

  // ── Fetch static dossier data ──────────────────────────────────────────
  try {
    const resp = await fetch('/api/asteroid/' + desig);
    if (resp.ok) {
      const data = await resp.json();
      _renderDossierStatic(data);
    }
  } catch (e) {
    console.warn('[Dossier] static fetch error:', e.message);
  }

  // ── Fetch RK4 trajectory ───────────────────────────────────────────────
  document.getElementById('dos-ca-idle').style.display = 'none';
  document.getElementById('dos-ca-spinner').style.display = '';

  try {
    const currentJD = _SIM_EPOCH_JD + state.simTime;
    const resp = await fetch('/api/asteroid/' + desig + '/trajectory?jd=' + currentJD.toFixed(4));
    if (resp.ok) {
      const result = await resp.json();
      _renderDossierTrajectory(result);
    } else {
      const err = await resp.json().catch(() => ({ error: 'Server error' }));
      document.getElementById('dos-ca-spinner').style.display = 'none';
      _setText('dos-ca-error', 'Error: ' + (err.error || resp.statusText));
      document.getElementById('dos-ca-error').style.display = '';
    }
  } catch (e) {
    document.getElementById('dos-ca-spinner').style.display = 'none';
    _setText('dos-ca-error', 'Network error: ' + e.message);
    document.getElementById('dos-ca-error').style.display = '';
  }
}

function closeMPCDossier() {
  _promotedAst    = null;
  _promotedResult = null;
  _renderer.demote();  // disposes mesh + trajectory geometry/materials
  _promoModelText = null;
  _refreshReprNotice();
  document.getElementById('mpc-dossier').classList.remove('open');
  const hudLine = document.getElementById('hud-promoted-line');
  if (hudLine) hudLine.style.display = 'none';
}

