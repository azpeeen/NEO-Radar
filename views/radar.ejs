var _pilotKeys = {};
var _pilotDrag = null;              // { x, y, moved } while the left button is down
var _pilotV = null, _pilotV2 = null, _pilotV3 = null, _pilotQ = null, _pilotM = null;   // THREE scratch

// Position / radius / name of any focus-style target descriptor (+ the Sun)
