// ─── Focus Mode ──────────────────────────────────────────────────────────────
// Double-click any object (planet, Moon, tracked NEO, MPC asteroid) — or press
// F on hover, or the sidebar Focus button — for a cinematic single-object view.
// ONE scene, ONE camera: focus is pure camera state. Entry animates the camera
// target onto the (moving) object with a log-space dolly (~1.4 s); afterwards
// the camera FOLLOWS the object every frame while the user orbits/dollies
// around it, and 5 s without input starts a slow auto-rotate (Eyes signature).
// Asteroids get their 3D shape model (NASA GLB or procedural) promoted into
// the main scene at the real position, radius estimated from H.
// ESC / double-click on empty space glides back to the pre-focus camera (~1 s).

var _promoModelText = null;    // #repr-notice override when a NASA GLB is shown

// Focus runtime (tick() drives these)
var _focusFollow     = false;  // entry animation done → target glued to object
var _focusStartCam   = null;   // {tx,ty,tz,dist} snapshot at glide start
var _focusDistTarget = 0.002;  // dolly end distance (AU)
var _focusMinDist    = 3e-5;   // dolly floor while following (≈ radius · 1.3)
var _focusRadiusAU   = 0;      // physical radius of the focused object (AU)
var _exitAnim        = null;   // { from:{cam…}, t:0..1 } while exiting
var _focusBaseDist   = 0.002;  // framing distance WITHOUT the magnetic field (AU)
var _magDolly        = null;   // { from, to, t } while (un)framing the magnetic field

// ─── Magnetic field (focus mode toggle, planets and moons) ───────────────────
// Data + geometry live in renderer3d.js (MAGNETOSPHERES / NO_MAGNETOSPHERE).
// The page owns the toggle, the camera framing and the HUD numbers.
function _magKey(tg) {
  if (!tg) return null;
  if (tg.type === 'planet') return PLANETS[tg.idx].key;
  if (tg.type === 'moon') return tg.id;
  return null;                                  // asteroids, comets, dwarf planets: no toggle
}
function _magDef(tg) {
  var k = _magKey(tg);
  return k && MAGNETOSPHERES[k] ? MAGNETOSPHERES[k] : null;
}
// Camera distance (AU) that fits the dayside and both flanks in the view:
// the magnetopause is r0·2^α wide at the terminator.
function _magFrameDist(def) {
  var extent = def.noShell ? def.rOut : def.r0 * Math.pow(2, def.alpha);
  // ×1.7: the flanks take ~60% of the height, leaving room for the tail
  return extent * _focusRadiusAU / Math.tan(FOV_RAD / 2) * 1.7;
}
// Side-on view for the field: camera in the terminator plane, a little above
// the ecliptic, with the Sun to the RIGHT of the screen. The compact dayside
// and its label then sit in the open part of the canvas, the long tail runs
// left behind the HUD card, and the planet's axis is roughly upright (the
// textbook picture). Camera offset = (cosφ·sinθ, cosφ·cosθ, sinφ), as in
// _cometViewOrient; screen-right for a horizontal offset d is (−d.y, d.x).
function _magViewOrient(pos, curTheta) {
  var L = Math.hypot(pos.x, pos.y) || 1e-9;
  var dx = -pos.y / L, dy = pos.x / L;          // offset ⟂ Sun line, Sun on screen-right
  var d = Math.atan2(dx, dy) - curTheta;
  while (d > Math.PI) d -= 2 * Math.PI;
  while (d < -Math.PI) d += 2 * Math.PI;
  return { dTheta: d, phi: 0.30 };
}
// Only move the camera when the field would be off-screen or tiny from `cur`
function _magPreferredDist(def, cur) {
  var f = _magFrameDist(def);
  return (cur < f * 0.6 || cur > f * 2.5) ? f : cur;
}
function _fmtKmShort(km) {
  if (km >= 1e6) return (km / 1e6).toFixed(2) + ' M km';
  return (Math.round(km / 100) * 100).toLocaleString('en-US') + ' km';
}
function _refreshMagHud() {
  var tg = state.focusTarget, key = _magKey(tg);
  var box = document.getElementById('fh-mag');
  if (!key) { box.hidden = true; return; }
  box.hidden = false;
  var btn = document.getElementById('fh-mag-btn');
  btn.classList.toggle('on', state.showMag);
  btn.setAttribute('aria-pressed', state.showMag ? 'true' : 'false');
  document.getElementById('fh-mag-sw').textContent = state.showMag ? 'ON' : 'OFF';
  document.getElementById('fh-mag-info').hidden = !state.showMag;
  if (!state.showMag) return;
  var def = MAGNETOSPHERES[key];
  var rows = document.getElementById('fh-mag-rows'), note = document.getElementById('fh-mag-note');
  var tail = document.getElementById('fh-mag-tail'), legend = document.getElementById('fh-mag-legend');
  if (!def) {
    // No intrinsic field: say so (and why) instead of drawing one
    rows.hidden = true; legend.hidden = true; tail.hidden = true;
    note.textContent = NO_MAGNETOSPHERE[key] || (tg.type === 'moon' ? NO_MAGNETOSPHERE._moon : 'NO INTRINSIC GLOBAL FIELD KNOWN.');
    return;
  }
  rows.hidden = false; legend.hidden = false;
  document.getElementById('fh-mag-k1').textContent = def.noShell ? 'CLOSED FIELD TO' : 'MAGNETOPAUSE';
  document.getElementById('fh-mag-v1').textContent =
    def.r0 + ' radii · ' + _fmtKmShort(def.r0 * _focusRadiusAU * 1.495979e8);
  document.getElementById('fh-mag-r2').hidden = def.r0lo == null;
  if (def.r0lo != null) document.getElementById('fh-mag-v2').textContent = def.r0lo + '–' + def.r0hi + ' radii';
  // Tilt is shown as the acute angle to the spin axis; the sense of the
  // moment (tilt > 90° = pointing south, as on Earth) goes in its own row and
  // only where a source states it.
  document.getElementById('fh-mag-v3').textContent =
    def.tiltShown || ((def.tilt > 90 ? 180 - def.tilt : def.tilt).toFixed(1) + '°');
  document.getElementById('fh-mag-r5').hidden = !def.polarityKnown;
  if (def.polarityKnown) {
    document.getElementById('fh-mag-v5').textContent = key === 'earth' ? 'moment points south'
      : def.tilt > 90 ? 'same as Earth\'s' : 'opposite to Earth\'s';
  }
  document.getElementById('fh-mag-v4').textContent = def.eqField >= 1
    ? def.eqField + ' µT' : Math.round(def.eqField * 1000) + ' nT';
  note.textContent = def.note + (def.alphaAssumed ? ' Magnetopause flaring assumed (no published fit used).' : '');
  document.getElementById('fh-mag-lg-mp').hidden = !!def.noShell;
  tail.hidden = !!def.noShell;
  if (!def.noShell) {
    tail.textContent = 'TAIL DRAWN TO ' + Math.round(def.tail * def.r0) + ' RADII. '
      + (def.tailNote || 'THE REAL ONE KEEPS GOING.');
  }
}
function setMagField(on) {
  state.showMag = !!on;
  var def = _magDef(state.focusTarget);
  _magDolly = null;
  if (state.focusMode && state.focusTarget && !_exitAnim) {
    if (state.showMag && def) {
      if (_focusFollow) {
        var to = _magPreferredDist(def, state.cam.dist);
        var o = _magViewOrient(_focusTargetPos(state.simTime), state.cam.theta);
        _magDolly = { from: state.cam.dist, to: to, t: 0,
                      th0: state.cam.theta, dTh: o.dTheta, ph0: state.cam.phi, ph1: o.phi };
        _focusDistTarget = Math.max(_focusBaseDist, to);   // also the zoom-out exit threshold (×4)
      } else {
        _focusDistTarget = _magPreferredDist(def, _focusBaseDist);   // entry glide lands there
        state._focusOrientTarget = 'mag';
      }
    } else {
      // Field off: back to the normal framing if the camera is far enough
      // out that the next wheel tick would drop focus
      if (_focusFollow && state.cam.dist > _focusBaseDist * 3) {
        _magDolly = { from: state.cam.dist, to: _focusBaseDist, t: 0 };
      }
      _focusDistTarget = _focusBaseDist;
    }
    _lastInteractT = performance.now();
  }
  _refreshMagHud();
}

function _easeInOutCubic(t) {
  return t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
}

// Radius in AU from absolute magnitude H (mid albedo 0.14):
// D_km = 1329/√p · 10^(−H/5). Fallback ≈ 250 m for objects without H.
function _astRadiusAU(ast) {
  var H = ast && ast.H;
  if (H == null || !isFinite(H)) return 1.7e-9;
  var D_km = (1329 / Math.sqrt(0.14)) * Math.pow(10, -H / 5);
  return (D_km / 2) / 1.496e8;
}

function _refreshReprNotice() {
  var el = document.getElementById('repr-notice');
  if (!el) return;
  var txt = null;
  var tg = state.focusTarget;
  if (tg && (tg.type === 'neo' || tg.type === 'mpc')) {
    txt = _promoModelText || '⚠ ARTISTIC REPRESENTATION · ACTUAL SHAPE UNKNOWN';
  } else if (_promotedAst) {
    txt = _promoModelText || '⚠ ARTISTIC REPRESENTATION';
  }
  if (txt) { el.textContent = txt; el.style.display = ''; }
  else el.style.display = 'none';
}

// Renderer callback: a real NASA shape model replaced the procedural mesh
_renderer.onModelApplied = function (context, key, noticeText) {
  _promoModelText = noticeText;
  _refreshReprNotice();
};

// ONE shared mesh slot in the renderer serves both the dossier's promoted
// asteroid and the focused NEO/MPC. Promote whatever should carry the mesh
// now; demote (with dispose) when nothing should.
function _syncAsteroidMesh() {
  var want = null;
  var tg = state.focusTarget || (_pilot && _pilot.active && _pilot.target ? _pilot.target.tg : null);
  if (tg && tg.type === 'neo') {
    var n = NEOS[tg.idx];
    // The NEO's own orbit LineLoop already lives in the scene
    want = { desig: n.id, name: n.name, orbit: null, ast: null };
  } else if (tg && tg.type === 'mpc') {
    want = { desig: tg.ast.designation, name: tg.ast.name,
             orbit: buildMPCOrbitPts(tg.ast, 256), ast: tg.ast };
  } else if (_promotedAst) {
    want = { desig: _promotedAst.designation, name: _promotedAst.name,
             orbit: buildMPCOrbitPts(_promotedAst, 256), ast: _promotedAst };
  }
  if (!want) {
    if (_promoKey !== null) {
      _renderer.demote();                      // disposes mesh + orbit + trajectory
      _promoKey = null; _promoAstRef = null; _promoModelText = null;
    }
    return;
  }
  _promoAstRef = want.ast;
  if (want.desig === _promoKey) return;        // same object — keep mesh/trajectory
  _promoModelText = null;
  _renderer.promote(want.desig, want.name, want.orbit);  // may fire onModelApplied synchronously
  _promoKey = want.desig;
}

// Closed orbit loop for an MPC asteroid, sampled over one period from now —
// same solver path as its live position (Kepler + secular), page-side only.
function buildMPCOrbitPts(ast, segments) {
  var jd0 = _SIM_EPOCH_JD + state.simTime;
  var P = 365.25 * Math.pow(ast.a, 1.5);
  var pts = new Float32Array(segments * 3);
  for (var k = 0; k < segments; k++) {
    var p = getMPCPosition(ast, jd0 + (k / segments) * P);
    pts[k * 3] = p.x; pts[k * 3 + 1] = p.y; pts[k * 3 + 2] = p.z;
  }
  return pts;
}

function _focusTargetPos(t) {
  var tg = state.focusTarget;
  if (tg.type === 'planet') return orbitPos(PLANETS[tg.idx], t);
  if (tg.type === 'neo')    return orbitPos(NEOS[tg.idx], t);
  if (tg.type === 'moon')   return _moonWorldPos(tg.id, t);
  if (tg.type === 'dwarf')  return orbitPos(DWARF_ELEMS[tg.idx], t);
  if (tg.type === 'comet')  return orbitPos(COMET_ELEMS[tg.idx], t);
  return getMPCPosition(tg.ast, _SIM_EPOCH_JD + t);
}

var _fhVel    = document.getElementById('fh-vel');
var _fhSun    = document.getElementById('fh-sun');
var _fhEarth  = document.getElementById('fh-earth');
var _fhSunK   = document.getElementById('fh-sun-k');
var _fhEarthK = document.getElementById('fh-earth-k');

function updateFocusHud(pos, t) {
  var tg = state.focusTarget;
  if (!tg) return;
  var pz = pos.z || 0;
  var r = Math.hypot(pos.x, pos.y, pz);
  var ep = orbitPos(PLANETS[2], t);
  if (tg.type === 'moon') {
    // Circular orbit around the parent: speed and radius are constant
    var md = MOONS_BY_ID[tg.id];
    _fhVel.textContent    = _moonOrbSpeedKms(md).toFixed(2) + ' km/s';
    _fhSunK.textContent   = 'PERIOD';
    _fhSun.textContent    = Math.abs(md.T).toFixed(2) + ' d';
    _fhEarthK.textContent = 'DIST ' + md.parent.toUpperCase();
    _fhEarth.textContent  = Math.round(md.a * 1.496e8).toLocaleString('en-US') + ' km';
    return;
  }
  _fhSunK.textContent   = 'DIST SUN';
  _fhEarthK.textContent = 'DIST EARTH';
  _fhVel.textContent = tg.a && r > 0 ? visVivaKms(tg.a, r).toFixed(1) + ' km/s' : '—';
  _fhSun.textContent = r.toFixed(3) + ' AU';
  if (tg.type === 'planet') {
    if (PLANETS[tg.idx].key === 'earth') {
      _fhEarth.textContent = '—';
    } else {
      var dAU = Math.hypot(pos.x - ep.x, pos.y - ep.y);
      var dLD = dAU / 0.00257;
      _fhEarth.textContent = dAU.toFixed(3) + ' AU · ' +
        (dLD >= 100 ? dLD.toFixed(0) : dLD.toFixed(1)) + ' LD';
    }
    return;
  }
  var dE_LD = Math.hypot(pos.x - ep.x, pos.y - ep.y, pz) / 0.00257;
  _fhEarth.textContent = (dE_LD < 100 ? dE_LD.toFixed(2) : dE_LD.toFixed(0)) + ' LD';
}

// Dolly targets for an object of physical radius r (Part 6): the end distance
// frames the body; "raioEfetivo" folds in the min-px floor at that distance so
// tiny asteroids still land at a sensible range. `kind` tightens the framing
// for big bodies ('earth' | 'luna' | 'gas' → real-radius multiples); asteroids
// and the remaining rocky planets keep the min-px-aware default.
function _setFocusDollyTargets(radiusAU, kind) {
  _focusRadiusAU = radiusAU;
  var distGuess = Math.max(radiusAU * 4, 0.002);
  var minWorldR = 6 * (2 * distGuess * Math.tan(FOV_RAD / 2) / H);
  var rEff = Math.max(radiusAU, minWorldR);
  if (kind === 'earth')     _focusDistTarget = Math.max(radiusAU * 8, 0.0003);
  // Moons: the 0.00005 AU (~7,500 km) absolute floor keeps tiny moons
  // (Phobos/Deimos) at a sane framing — their r×8 would be sub-near-plane
  else if (kind === 'luna') _focusDistTarget = Math.max(radiusAU * 8, 0.00005);
  else if (kind === 'gas')  _focusDistTarget = radiusAU * 5;
  else                      _focusDistTarget = 0.0006;   // asteroids + rocky planets
  // Dolly floor: moons and asteroids may scroll in VERY close; the big
  // bodies keep the tighter surface-hugging floor.
  if (kind === 'luna') {
    _focusMinDist = Math.max(radiusAU * 1.2, 8e-6);
  } else if (kind === 'ast') {
    // NEO/MPC: while focused the renderer freezes the PROMO_MIN_PX floor at
    // FOCUS_FRAME_DIST (renderer3d.js), so the on-screen rock keeps an
    // effective world radius the camera floor must clear — 1.2× it lands the
    // dolly just above the surface with the rock filling the screen.
    var promoR = PROMO_MIN_PX * (2 * FOCUS_FRAME_DIST * Math.tan(FOV_RAD / 2) / H);
    var rEffAst = Math.max(radiusAU, promoR);
    _focusMinDist = Math.max(rEffAst * 1.2, 0.00003);
  } else if (kind) {
    _focusMinDist = Math.max(rEff * 1.5, 3e-5);
  } else {
    _focusMinDist = 0.00003;
  }
}

function _beginFocusGlide() {
  state.focusLerp = 0;
  _focusFollow = false;
  _exitAnim = null;
  _focusStartCam = { tx: state.cam.tx, ty: state.cam.ty, tz: state.cam.tz, dist: state.cam.dist,
                     theta: state.cam.theta, phi: state.cam.phi };
  _camVTheta = 0; _camVPhi = 0;
  _lastInteractT = performance.now();
}

// Camera azimuth/elevation for a cinematic view of a comet. The camera sits
// ABOVE the orbital plane (mostly along the ecliptic normal), tilted a little
// to the side and to the solar side. From there the anti-solar ion tail AND the
// dust tail's bend toward the trailing side both lie across the frame; a pure
// edge-on side view looks straight down the trailing axis and flattens the
// curve. Convention matches renderer3d _updateCamera:
// offset = (cosφ·sinθ, cosφ·cosθ, sinφ).
function _cometViewOrient(pos) {
  var L = Math.hypot(pos.x, pos.y, pos.z || 0) || 1e-9;
  var ax = pos.x / L, ay = pos.y / L, az = (pos.z || 0) / L;   // anti-solar unit
  // In-plane perpendicular to the tail (anti × up)
  var ux = 0, uy = 0, uz = 1;
  if (Math.abs(az) > 0.9) { uy = 1; uz = 0; }
  var px = ay*uz - az*uy, py = az*ux - ax*uz, pz = ax*uy - ay*ux;
  var pl = Math.hypot(px, py, pz) || 1e-9; px/=pl; py/=pl; pz/=pl;
  // offset dir: 80% up the ecliptic normal, 38% sideways, 28% toward the Sun
  var dx = px*0.38 - ax*0.28, dy = py*0.38 - ay*0.28, dz = 0.80 + pz*0.38 - az*0.28;
  var dl = Math.hypot(dx, dy, dz) || 1e-9; dx/=dl; dy/=dl; dz/=dl;
  return {
    theta: Math.atan2(dx, dy),
    phi: Math.max(-1.48, Math.min(1.48, Math.atan2(dz, Math.hypot(dx, dy)))),
  };
}

// Shared focus-target setup: fills target.a/name/desig, derives the physical
// radius + dolly kind, starts the glide and refreshes mesh/notice/HUD. Used
// by enterFocus (map → focus) and _switchFocus (focus → focus).
function _applyFocusTarget(target) {
  var radiusAU = 0, focusKind = null;
  if (target.type === 'planet') {
    var p = PLANETS[target.idx];
    target.a = p.a; target.name = p.name;
    target.desig = 'PLANET · a = ' + p.a.toFixed(3) + ' AU';
    radiusAU = REAL_RADIUS_AU[p.key] || 2e-5;  // shared table from renderer3d.js
    focusKind = p.key === 'earth' ? 'earth'
      : (p.key === 'jupiter' || p.key === 'saturn' || p.key === 'uranus' || p.key === 'neptune') ? 'gas'
      : null;
  } else if (target.type === 'moon') {
    var md = MOONS_BY_ID[target.id];
    var mpar = PLANETS.find(function (p) { return p.key === md.parent; });
    target.a = mpar ? mpar.a : 1.0;            // heliocentric fallback for the HUD
    target.name = md.name;
    target.desig = 'MOON OF ' + md.parent.toUpperCase() + ' · P = ' + Math.abs(md.T).toFixed(2) + ' D';
    radiusAU = md.r;
    focusKind = 'luna';
  } else if (target.type === 'dwarf') {
    var dw = DWARF_PLANETS[target.idx];
    target.a = dw.a; target.name = dw.name;
    target.desig = 'DWARF PLANET · a = ' + dw.a.toFixed(3) + ' AU';
    radiusAU = dw.r;
    focusKind = 'luna';                        // r×8 framing — same as big moons
  } else if (target.type === 'comet') {
    var cm = COMETS[target.idx];
    target.a = cm.a; target.name = cm.name;
    target.desig = 'COMET · P = ' + Math.pow(cm.a, 1.5).toFixed(1) + ' YR · q = ' + (cm.a * (1 - cm.e)).toFixed(2) + ' AU';
    radiusAU = cm.r;
    focusKind = 'luna';                        // tiny-body floor keeps sane framing
  } else if (target.type === 'neo') {
    var n = NEOS[target.idx];
    target.a = n.a; target.name = n.name; target.desig = n.desig;
    radiusAU = 1.7e-9;                         // catalog NEOs carry no H — ~500 m body
    focusKind = 'ast';
  } else {
    var ast = target.ast;
    target.a = ast.a; target.name = ast.name || ast.designation; target.desig = ast.designation;
    radiusAU = _astRadiusAU(ast);
    focusKind = 'ast';
  }
  state.focusTarget = target;

  _setFocusDollyTargets(radiusAU, focusKind);

  // Comet focus: pull the camera BACK to frame the whole head + tail (the
  // default r×8 luna framing dives onto the nucleus, so only a slice of the
  // tail is ever on screen), and orient to a cinematic side view. Distance
  // scales with the tail length (∝ activity). Null orient for every other body.
  state._focusOrientTarget = null;
  if (target.type === 'comet') {
    var cp = _focusTargetPos(state.simTime);
    var ds = Math.hypot(cp.x, cp.y, cp.z || 0);
    var actE = Math.max(0, (COMET_ACTIVE_AU - ds) / COMET_ACTIVE_AU);
    var tailLen = actE * 1.5;                         // ion tail length (AU)
    _focusDistTarget = Math.max(0.05, tailLen * 0.9); // frame head + full tail
    _focusMinDist = 0.004;                            // still allow a closer look
    state._focusOrientTarget = _cometViewOrient(cp);
  }

