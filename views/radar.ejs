function ws(x,y){return{x:W/2+state.panX+x*state.pxPerAU*state.zoom, y:H/2+state.panY+y*state.pxPerAU*state.zoom};}

function isActiveConjunctionPlanet(key, t) {
  if (!ALIGNMENTS || !ALIGNMENTS.length) return false;
  const nameToKey = { Earth:'earth', Jupiter:'jupiter', Saturn:'saturn', Uranus:'uranus', Neptune:'neptune' };
  return ALIGNMENTS.some(al =>
    Math.abs(t - al.simDay) <= 3 &&
    al.bodies.some(name => (nameToKey[name] || name.toLowerCase()) === key)
  );
}

// Active conjunctions in WORLD coordinates — the renderer projects and draws
function computeActiveConjunctions(t) {
  if (!ALIGNMENTS || !ALIGNMENTS.length) return [];
  const nameToKey = { Earth:'earth', Jupiter:'jupiter', Saturn:'saturn', Uranus:'uranus', Neptune:'neptune' };
  const keyToPlanet = {};
  for (const p of PLANETS) keyToPlanet[p.key] = p;
  const out = [];
  for (const al of ALIGNMENTS) {
    if (Math.abs(t - al.simDay) > 3) continue;
    const pts = al.bodies.map(name => {
      const planet = keyToPlanet[nameToKey[name] || name.toLowerCase()];
      return planet ? orbitPos(planet, t) : null;
    }).filter(Boolean);
    if (pts.length >= 2) out.push({ pts });
  }
  return out;
}

// Uncertainty ribbon in WORLD coordinates — same math as before, fixed-size
// arrays so the renderer can update one BufferGeometry with zero allocation
const _CONE_N = 101;
const _coneUpper = new Float32Array(_CONE_N * 2);
const _coneLower = new Float32Array(_CONE_N * 2);
function computeUncertaintyCone(o, t) {
  const pts=[];
  for(let k=0;k<_CONE_N;k++){const dt=(k-50)*8,tt=t+dt,period=Math.pow(o.a,1.5),Mt=((tt/365.25)/period)*2*Math.PI+(o.phase||0),E=solveKepler(Mt,o.e),x=o.a*(Math.cos(E)-o.e),y=o.a*Math.sqrt(1-o.e*o.e)*Math.sin(E),ang=((o.w||0)+(o.om||0))*Math.PI/180,wx=x*Math.cos(ang)-y*Math.sin(ang),wy=x*Math.sin(ang)+y*Math.cos(ang),jup=orbitPos(PLANETS[4],tt),dJ=Math.hypot(wx-jup.x,wy-jup.y);pts.push({x:wx,y:wy,w:0.005+0.05/(dJ*dJ+0.4)});}
  for(let k=0;k<pts.length;k++){const p=pts[k],next=pts[Math.min(k+1,pts.length-1)],dx=next.x-p.x,dy=next.y-p.y,len=Math.hypot(dx,dy)||1e-9,nx=-dy/len,ny=dx/len;_coneUpper[k*2]=p.x+nx*p.w;_coneUpper[k*2+1]=p.y+ny*p.w;_coneLower[k*2]=p.x-nx*p.w;_coneLower[k*2+1]=p.y-ny*p.w;}
}

// Jupiter Δv vector endpoints in WORLD coordinates
function computeJupiterVector(t, f) {
  f.active = false;
  if (!state.jupiter) return;
  const sel = NEOS.find(n => n.id === state.selectedId); if (!sel) return;
  const ap = orbitPos(sel, t), jp = orbitPos(PLANETS[4], t);
  const dx = jp.x - ap.x, dy = jp.y - ap.y, d = Math.hypot(dx, dy);
  if (d > 6) return;
  f.active = true;
  f.ax = ap.x; f.ay = ap.y; f.bx = ap.x + dx*0.06; f.by = ap.y + dy*0.06;
}

const _J2000_RAF = Date.UTC(2000, 0, 1, 12, 0, 0);
const _T_SIM_RAF = _J2000_RAF + 9643 * 86400000; // sim epoch = 2026-05-27

// Per-frame flat data handed to the renderer (preallocated — no GC churn)
const _frame = {
  planets: PLANETS.map(() => ({ x:0, y:0, visible:false, conj:false })),
  neos:    NEOS.map(() => ({ x:0, y:0 })),
  selIdx: -1, hovIdx: -1,
  cone: { active:false, risky:false, count:_CONE_N, upper:_coneUpper, lower:_coneLower },
  jup:  { active:false, ax:0, ay:0, bx:0, by:0 },
  conjs: [],
  mpcDirty: false,
  hoverMPC: null,
  luna: { x:0, y:0, visible:false },
  promoted: { active:false, x:0, y:0, ex:0, ey:0, distLD:'' },
  focus: { active:false, shown:false, x:0, y:0, camTheta:0, camPhi:Math.PI/4, camRadius:1.5 },
  focusFade: 0,
};

let last=performance.now();
function tick(now) {
  const dt=Math.min(0.1,(now-last)/1000); last=now;
  if (state.playing) {
    // Simulate mode: advance time by wall-clock dt × simulation speed
    state.simTime += dt * state.daysPerSec * state.speed;
  } else {
    // Live mode: pin to real time every frame — zero drift, zero accumulation error
    state.simTime = (Date.now() - _T_SIM_RAF) / 86400000;
  }
  const t = state.simTime;

  for (let i=0;i<PLANETS.length;i++) {
    const p=PLANETS[i], f=_frame.planets[i];
    f.visible = state.showPlanets && !!state.planetToggles[p.key];
    if (f.visible) {
      const pos=orbitPos(p,t);
      f.x=pos.x; f.y=pos.y;
      f.conj=isActiveConjunctionPlanet(p.key,t);
    }
  }

  // Moon: heliocentric = Earth + geocentric circle (visual only, no physics)
  {
    const ef=_frame.planets[2], lf=_frame.luna;
    lf.visible = ef.visible;
    if (ef.visible) { const mp=moonPos(t); lf.x=ef.x+mp.x; lf.y=ef.y+mp.y; }
  }

  _frame.selIdx=-1; _frame.hovIdx=-1;
  for (let i=0;i<NEOS.length;i++) {
    const n=NEOS[i], pos=orbitPos(n,t), f=_frame.neos[i];
    f.x=pos.x; f.y=pos.y;
    if (n.id===state.selectedId) _frame.selIdx=i;
    if (n.id===state.hoverId)    _frame.hovIdx=i;
  }

  _frame.cone.active = false;
  if (state.uncertainty && _frame.selIdx>=0) {
    const n=NEOS[_frame.selIdx];
    computeUncertaintyCone(n,t);
    _frame.cone.active = true;
    _frame.cone.risky  = (n.risk==='caution'||n.risk==='hazard');
  }

  computeJupiterVector(t, _frame.jup);
  _frame.conjs = computeActiveConjunctions(t);
  _frame.mpcDirty = updateMPCFrame();
  _frame.hoverMPC = _hoverMPC;

  if (_promotedAst) {
    const currentJD=_SIM_EPOCH_JD+t;
    const pos=getMPCPosition(_promotedAst,currentJD);
    const ep=orbitPos(PLANETS[2],t);
    const pr=_frame.promoted;
    pr.active=true; pr.x=pos.x; pr.y=pos.y; pr.ex=ep.x; pr.ey=ep.y;
    pr.distLD=(Math.hypot(pos.x-ep.x,pos.y-ep.y)/0.00257).toFixed(2);
  } else {
    _frame.promoted.active=false;
  }

  // ── Focus mode: animation progress + per-frame target data ──
  const fo=_frame.focus;
  fo.active=false; fo.shown=false; _frame.focusFade=0;
  if (state.focusTarget) {
    // focusMode true → lerp toward 1 (enter); false → back to 0 (exit)
    const dirF=state.focusMode?1:-1;
    state.focusLerp=Math.min(1,Math.max(0,state.focusLerp+dirF*dt/1.2));
    const eF=_easeInOutCubic(state.focusLerp);
    _frame.focusFade=1-Math.abs(eF*2-1);           // black at the midpoint
    fo.active=true;
    fo.shown=eF>=0.5;                              // second half renders the focus scene
    const tp=_focusTargetPos(t);
    fo.x=tp.x; fo.y=tp.y;
    fo.camTheta=state._focusCamTheta;
    fo.camPhi=state._focusCamPhi;
    // Dolly-in on entry / dolly-out on exit, on top of the user's zoom radius
    const t2=Math.min(1,Math.max(0,(eF-0.5)*2));
    fo.camRadius=state._focusCamRadius*(1+(1-t2)*1.8);
    updateFocusHud(tp,t);
    if (!state.focusMode && state.focusLerp<=0) _finishExitFocus();
  }

  _renderer.render(state, _frame);
  updateScaleBar();
  updateClock();
  requestAnimationFrame(tick);
}
requestAnimationFrame(tick);

// Display timezone — physics always runs in UTC/J2000 internally
var _selectedTz = (function () {
  try {
    var known = ['UTC','America/Sao_Paulo','America/New_York','America/Los_Angeles',
                 'Europe/London','Europe/Paris','Asia/Tokyo','Asia/Shanghai','Australia/Sydney'];
    var btz = Intl.DateTimeFormat().resolvedOptions().timeZone;
    return known.includes(btz) ? btz : 'UTC';
  } catch (e) { return 'UTC'; }
}());

function updateClock() {
  var epoch = new Date(Date.UTC(2026, 4, 27, 12, 0, 0));
  var d     = new Date(epoch.getTime() + state.simTime * 86400000);
  var fmt   = new Intl.DateTimeFormat('en-CA', {
    timeZone: _selectedTz,
    year: 'numeric', month: '2-digit', day: '2-digit',
    hour: '2-digit', minute: '2-digit', hour12: false,
  });
  var p = Object.fromEntries(fmt.formatToParts(d).map(function (x) { return [x.type, x.value]; }));
  var tzLabel = _selectedTz === 'UTC' ? 'UTC' : _selectedTz.split('/').pop().replace(/_/g, ' ');
  document.getElementById('sim-clock-val').textContent =
    p.year + '·' + p.month + '·' + p.day + ' ' + p.hour + ':' + p.minute + ' ' + tzLabel;
}
function updateScaleBar() {
  const ROUND = [0.01,0.02,0.05,0.1,0.2,0.5,1,2,5,10,20,50,100];
  const scale = state.pxPerAU * state.zoom;
  let chosen = ROUND[0];
  for (const v of ROUND) {
    chosen = v;
    if (v * scale >= 80) break;
  }
  const barPx = Math.round(chosen * scale);
  const label = chosen < 1 ? chosen + ' AU' : (chosen >= 1 ? chosen + ' AU' : chosen + ' AU');
  const line = document.getElementById('dyn-scale-line');
  const lbl  = document.getElementById('dyn-scale-label');
  if (line) line.style.width = barPx + 'px';
  if (lbl)  lbl.textContent  = label;
}

// Vis-viva orbital speed: v = sqrt(GM*(2/r - 1/a)) in km/s
function visVivaKms(a, r) {
  const GM = 4*Math.PI*Math.PI; // AU³/yr²
  const v_AU_per_yr = Math.sqrt(GM * (2/r - 1/a));
  return +(v_AU_per_yr * 29.7827).toFixed(1); // 1 AU/yr = 29.7827 km/s
}

function renderList() {
  const q=state.search.toLowerCase().trim();
  const filtered=NEOS.filter(n=>{
    if(state.filter!=='all'&&n.risk!==state.filter)return false;
    if(q&&!(n.name.toLowerCase().includes(q)||n.desig.toLowerCase().includes(q)))return false;
    return true;
  }).sort((a,b)=>a.nextLD-b.nextLD);
  document.getElementById('result-count').textContent=`${filtered.length} result${filtered.length===1?'':'s'}`;
  document.getElementById('neo-list').innerHTML=filtered.map(n=>`
    <div class="neo-item r-${n.risk}${state.selectedId===n.id?' selected':''}" data-id="${n.id}">
      <div class="name"><span class="risk-dot"></span>${n.name}</div>
      <div class="desig">${n.desig}</div>
      <div class="ld">${n.nextLD<1?n.nextLD.toFixed(2):n.nextLD.toFixed(1)}<small>LUNAR DIST</small></div>
    </div>`).join('');
  document.querySelectorAll('.neo-item').forEach(el=>el.addEventListener('click',()=>{state.selectedId=el.dataset.id;renderList();renderSelected();}));
}
function renderSelected() {
  const n=NEOS.find(x=>x.id===state.selectedId); if(!n)return;
  document.getElementById('sel-name').textContent=n.name;
  document.getElementById('sel-desig').textContent=`${n.desig} · NEA`;
  const re=document.getElementById('sel-risk'); re.className=`risk ${n.risk}`; re.textContent=n.label;
  document.getElementById('sel-figure').innerHTML=`${n.nextKm}<small>km</small>`;
