  P.yawRate += (yawIn * 1.1 - P.yawRate) * kr;
  P.pitchRate += (pitchIn * 0.9 - P.pitchRate) * kr;
  P.rollRate += (rollIn * 1.4 - P.rollRate) * kr;
  var dYaw = P.yawRate * dt + P.dragYaw, dPitch = P.pitchRate * dt + P.dragPitch;
  P.dragYaw = 0; P.dragPitch = 0;
  if (!P.auto) {
    // Local axes: +Y up (yaw left positive), +X right (nose up positive),
    // +Z back (roll left positive)
    P.q.multiply(_pilotQ.setFromAxisAngle(_pilotV.set(0, 1, 0), dYaw));
    P.q.multiply(_pilotQ.setFromAxisAngle(_pilotV.set(1, 0, 0), dPitch));
    P.q.multiply(_pilotQ.setFromAxisAngle(_pilotV.set(0, 0, 1), P.rollRate * dt));
    P.q.normalize();
  }
  var kv = Math.min(1, dt * 6);
  P.visYaw += ((dt > 0 ? dYaw / dt : 0) - P.visYaw) * kv;
  P.visPitch += ((dt > 0 ? dPitch / dt : 0) - P.visPitch) * kv;

  _pilotScan();
  var vScale = Math.max(PILOT_VMIN, Math.min(PILOT_VMAX, PILOT_K * Math.max(0, P.nearSurf)));
  var boost = K.shift ? 4 : 1;

  if (P.auto && P.target) {
    // ── Autopilot ──
    var T2 = P.target;
    var stop = Math.max(T2.r * PILOT_STOP_R, T2.r + 4e-10);
    var A = _pilotViewPoint(T2, stop, P.autoHint, _pilotV2);
    var ax = A.x - P.x, ay = A.y - P.y, az = A.z - P.z;
    var LA = Math.hypot(ax, ay, az);
    // Nose on the body the whole way in (the ship drifts to the day side)
    var goal = _pilotLookAt(P.x, P.y, P.z, T2, _pilotV3.set(0, 1, 0).applyQuaternion(P.q), _pilotQ);
    var off = P.q.angleTo(goal);
    P.q.rotateTowards(goal, 1.9 * dt);
    // Exponential approach (covers any distance in ~10 s), eased in, and held
    // back while the nose is still swinging round
    var want = Math.min(60, LA * 1.6) * (off > 0.6 ? 0.12 : 1);
    P.autoV += (want - P.autoV) * Math.min(1, dt * (want > P.autoV ? 1.4 : 6));
    var step = Math.min(LA, P.autoV * dt);
    if (LA > 0) { P.x += ax / LA * step; P.y += ay / LA * step; P.z += az / LA * step; }
    P.speed = P.autoV;
    P.throttle += (Math.min(1, P.autoV / Math.max(1e-12, vScale)) - P.throttle) * Math.min(1, dt * 4);
    if (LA - step < Math.max(stop * 0.02, 2e-11) && off < 0.05) {
      P.auto = false; P.autoV = 0; P.speed = 0;      // arrived
    }
  } else {
    // ── Manual flight ──
    var tt = thrIn > 0 ? 1 : thrIn < 0 ? -0.5 : 0;
    P.throttle += (tt - P.throttle) * Math.min(1, dt * (thrIn ? 2.4 : 4));
    if (Math.abs(P.throttle) < 0.002 && !thrIn) P.throttle = 0;
    P.speed = P.throttle * vScale * P.limit * boost;
    var f = _pilotV.set(0, 0, -1).applyQuaternion(P.q);
    P.x += f.x * P.speed * dt; P.y += f.y * P.speed * dt; P.z += f.z * P.speed * dt;
  }

  // ── Bodies are solid (the autopilot keeps a wider berth, so a pass behind a
  // planet slides round it instead of skimming the surface) ──
  var berth = P.auto ? 1.6 : 1.012;
  for (i = 0; i < B.length; i++) _pilotPushOut(B[i], berth);
  if (P.target && P.target.custom) _pilotPushOut(P.target, berth);
  _pilotScan();

  // ── Anchor: ride the body the ship is closest to, in units of its radius.
  // Switching needs a clearly better candidate, so two bodies never trade the
  // ship back and forth. ──
  if (P.auto && P.target) {
    _pilotSetAnchor(P.target);
  } else {
    var best = null, bestS = PILOT_ANCHOR_IN, sc;
    for (i = 0; i < B.length; i++) {
      sc = _pilotAnchorScore(B[i]);
      if (sc < bestS) { bestS = sc; best = B[i]; }
    }
    if (P.target && P.target.custom) {
      sc = _pilotAnchorScore(P.target);
      if (sc < bestS) { bestS = sc; best = P.target; }
    }
    if (!P.anchor) {
      if (best) _pilotSetAnchor(best);
    } else {
      var cur = _pilotAnchorScore(P.anchor);
      if (cur > PILOT_ANCHOR_OUT) _pilotSetAnchor(best);          // may be null: back to heliocentric
      else if (best && best !== P.anchor && bestS < cur * 0.6) _pilotSetAnchor(best);
    }
  }
  _pilotSetWorld(P.x, P.y, P.z);

  // ── Camera trails the hull a little, so turns read on the model first ──
  P.cq.slerp(P.q, 1 - Math.exp(-dt * 7));
  var rel = _pilotQ.copy(P.cq).invert().multiply(P.q);

  var S = _frame.ship;
  S.active = true;
  S.near = Math.max(1e-10, Math.min(1e-6, P.nearSurf * 0.25));
  S.x = P.x; S.y = P.y; S.z = P.z;
  S.cqx = P.cq.x; S.cqy = P.cq.y; S.cqz = P.cq.z; S.cqw = P.cq.w;
  S.rqx = rel.x; S.rqy = rel.y; S.rqz = rel.z; S.rqw = rel.w;
  S.yaw = P.visYaw; S.pitch = P.visPitch;
  S.throttle = P.throttle; S.boost = (P.auto || boost > 1) ? 1.5 : 1;
  S.auto = P.auto;
  S.hasTarget = !!P.target;
  if (P.target) {
    var T3 = P.target;
    S.tx = T3.x; S.ty = T3.y; S.tz = T3.z; S.tr = T3.r; S.tName = T3.name;
    S.tDist = _pilotFmtDist(Math.max(0, Math.hypot(P.x - T3.x, P.y - T3.y, P.z - T3.z) - T3.r));
  }
  _pilotHud(false);
}

function _pilotFmtDist(au) {
  var km = au * 1.495979e8;
  if (km < 10) return km.toFixed(2) + ' km';
  if (km < 1000) return km.toFixed(0) + ' km';
  if (au < 0.01) return Math.round(km).toLocaleString('en-US') + ' km';
  return au.toFixed(au < 10 ? 3 : 2) + ' AU';
}
function _pilotFmtLight(au) {
  var s = au * 499.004784;                      // light time: 499.005 s per AU
  if (s < 90) return s.toFixed(1) + ' s';
  if (s < 5400) return Math.floor(s / 60) + ' m ' + ('0' + Math.floor(s % 60)).slice(-2) + ' s';
  return (s / 3600).toFixed(2) + ' h';
}
function _pilotHud(force) {
  var P = _pilot, now = performance.now();
  if (!force && now - P.hudT < 100) return;      // 10 Hz is plenty for text
  P.hudT = now;
  var v = Math.abs(P.speed), kms = v * 1.495979e8, c = v / PILOT_C;
  var sp = document.getElementById('ph-speed'), su = document.getElementById('ph-speed-u');
  var pc = document.getElementById('ph-c');
  if (c >= 1) { sp.textContent = c < 100 ? c.toFixed(1) : Math.round(c).toLocaleString('en-US'); su.textContent = '× light speed'; }
  else if (kms >= 1000) { sp.textContent = Math.round(kms).toLocaleString('en-US'); su.textContent = 'km/s'; }
  else { sp.textContent = kms < 10 ? kms.toFixed(2) : kms.toFixed(1); su.textContent = 'km/s'; }
  pc.classList.toggle('ftl', c >= 1);
  pc.textContent = v === 0 ? 'AT REST'
    : c >= 1 ? 'FASTER THAN LIGHT · NOT PHYSICAL'
    : (c * 100 < 0.01 ? '< 0.01' : (c * 100).toFixed(2)) + '% OF LIGHT SPEED';
  var tag = document.getElementById('ph-mode');
  tag.textContent = P.auto ? 'AUTOPILOT' : 'MANUAL';
  tag.classList.toggle('auto', P.auto);
  document.getElementById('ph-near').textContent = P.near
    ? P.near.name + ' · ' + _pilotFmtDist(Math.max(0, P.nearSurf)) : '—';
  var rs = Math.hypot(P.x, P.y, P.z);
  document.getElementById('ph-sun').textContent = rs.toFixed(rs < 10 ? 3 : 2) + ' AU · light ' + _pilotFmtLight(rs);
  document.getElementById('ph-target').textContent = P.target
    ? P.target.name + ' · ' + _pilotFmtDist(Math.max(0, Math.hypot(P.x - P.target.x, P.y - P.target.y, P.z - P.target.z) - P.target.r))
    : 'none · click a body';
  var dl = P.target ? Math.hypot(P.x - P.target.x, P.y - P.target.y, P.z - P.target.z) : 0;
  document.getElementById('ph-light').textContent = P.target ? _pilotFmtLight(dl) : '—';
  document.getElementById('ph-limit').textContent = '×' + (P.limit < 1 ? P.limit.toFixed(2) : P.limit.toFixed(1));
}

// Quick destinations (the sidebar search flies the ship anywhere else)
function _pilotBuildChips() {
  var wrap = document.getElementById('ph-dest');
  var list = [
    { type: 'planet', key: 'earth' }, { type: 'moon', id: 'moon' }, { type: 'planet', key: 'mars' },
    { type: 'planet', key: 'jupiter' }, { type: 'moon', id: 'io' }, { type: 'planet', key: 'saturn' },
    { type: 'moon', id: 'titan' }, { type: 'planet', key: 'neptune' }, { type: 'dwarf', id: 'pluto' },
    { type: 'comet', id: 'halley' }, { type: 'sun' },
  ];
  list.forEach(function (d) {
    var tg = null;
    if (d.type === 'planet') { var pi = PLANETS.findIndex(function (p) { return p.key === d.key; }); if (pi >= 0) tg = { type: 'planet', idx: pi }; }
    else if (d.type === 'moon') { if (MOONS_BY_ID[d.id]) tg = { type: 'moon', id: d.id }; }
    else if (d.type === 'dwarf') { var di = DWARF_PLANETS.findIndex(function (x) { return x.id === d.id; }); if (di >= 0) tg = { type: 'dwarf', idx: di }; }
    else if (d.type === 'comet') { var ci = COMETS.findIndex(function (x) { return x.id === d.id; }); if (ci >= 0) tg = { type: 'comet', idx: ci }; }
    else tg = { type: 'sun' };
    if (!tg) return;
    var btn = document.createElement('button');
    btn.type = 'button';
    btn.textContent = _bodyName(tg);
    btn.addEventListener('click', function () { _pilotSetTarget(tg, true); btn.blur(); });
    wrap.appendChild(btn);
  });
}

// ── Pilot input (the map/focus handlers below hand over while piloting) ──
var _PILOT_KEYMAP = {
  w: 'w', s: 's', a: 'a', d: 'd', q: 'q', e: 'e',
  arrowup: 'up', arrowdown: 'down', arrowleft: 'left', arrowright: 'right', shift: 'shift',
};
// Returns true when the key was consumed by pilot mode
function _pilotKeyDown(e) {
  var k = (e.key || '').toLowerCase();
  if (!_pilot.active) {
    if (k === 'p' && !e.ctrlKey && !e.metaKey && !e.altKey) { enterPilot(); return true; }
    return false;
  }
  if (e.ctrlKey || e.metaKey || e.altKey) return false;
  if (_PILOT_KEYMAP[k]) { _pilotKeys[_PILOT_KEYMAP[k]] = true; e.preventDefault(); return true; }
  if (k === 'escape' || k === 'p') { exitPilot(); return true; }
  if (k === 'x') { _pilot.auto = false; _pilot.autoV = 0; _pilot.throttle = 0; _pilot.speed = 0; return true; }
  if (k === 't') { _pilotTargetAhead(); return true; }
  if (k === 'g') {
    if (!_pilot.target) _pilotTargetAhead();
    if (_pilot.target) { if (_pilot.auto) { _pilot.auto = false; _pilot.autoV = 0; } else _pilotEngage(); }
    _pilotHud(true);
    return true;
  }
  return false;
}
document.addEventListener('keyup', function (e) {
  var k = (e.key || '').toLowerCase();
  if (_PILOT_KEYMAP[k]) _pilotKeys[_PILOT_KEYMAP[k]] = false;
});
window.addEventListener('blur', function () { _pilotKeys = {}; _pilotDrag = null; });

function _pilotMouseMove(e) {
  if (!_pilotDrag) return;
  if (!(e.buttons & 1)) { _pilotDrag = null; return; }      // released outside the canvas
  var dx = e.clientX - _pilotDrag.x, dy = e.clientY - _pilotDrag.y;
  _pilotDrag.x = e.clientX; _pilotDrag.y = e.clientY;
  if (!_pilotDrag.moved && Math.hypot(e.clientX - _pilotDrag.sx, e.clientY - _pilotDrag.sy) < 4) return;
  _pilotDrag.moved = true;
  // Steer like a stick: drag right = turn right, drag up = nose up
  _pilot.dragYaw -= dx * 0.0032;
  _pilot.dragPitch -= dy * 0.0032;
}
function _pilotClick(e, engage) {
  if (Math.hypot(e.clientX - _panSX, e.clientY - _panSY) > 5) return;   // that was a steering drag
  var rc = cv.getBoundingClientRect();
  var hit = _focusHitTest(e.clientX - rc.left, e.clientY - rc.top);
  if (hit) _pilotSetTarget(hit, engage);
}
document.getElementById('pilot-btn').addEventListener('click', function () { enterPilot(); this.blur(); });
document.getElementById('pilot-exit-btn').addEventListener('click', exitPilot);

// ─── Camera controls (manual — no OrbitControls) ─────────────────────────────
// Left-drag orbits (theta/phi), right-drag or shift+left-drag pans the target
// in the screen plane, wheel dollies exponentially. Inertia decays in tick().
// The focus target follows a moving object, which OrbitControls cannot do.
let _dragMode = null;              // 'orbit' | 'pan' | null — ACTIVE drag
let _dragArmed = null;             // mode armed on mousedown, activated after 4px
let _panSX = 0, _panSY = 0;        // mousedown position (click-vs-drag test)
let _panLX = 0, _panLY = 0;        // last mouse position while dragging
let _camVTheta = 0, _camVPhi = 0;  // angular inertia seeded by the last drag
let _lastInteractT = 0;            // last user input — drives focus auto-rotate
let _mouseX = W / 2, _mouseY = H / 2;  // last cursor position — wheel zoom-to-cursor

cv.style.cursor = 'grab';
cv.addEventListener('contextmenu', e => e.preventDefault());   // right-drag = pan

// Pan: move the camera target along the ECLIPTIC plane, converting px → AU at
// the target depth. The camera right/up vectors (matrixWorld columns 0 and 1)
// are projected onto the XY plane and re-normalized, so a vertical drag never
// pushes the target out of the ecliptic — tz stays put.
// Disabled while focus follow has the target glued.
function camPan(dx, dy) {
  if (state.focusTarget) return;
  const c = state.cam;
  const wpp = 2 * c.dist * Math.tan(FOV_RAD / 2) / H;   // world per pixel
  const me = _renderer.camera.matrixWorld.elements;
  let rx = me[0], ry = me[1];        // right — rz ignored (stay in-plane)
  let ux = me[4], uy = me[5];        // up    — uz ignored
  const rLen = Math.hypot(rx, ry);
  if (rLen > 1e-6) { rx /= rLen; ry /= rLen; } else { rx = 0; ry = 0; }
  const uLen = Math.hypot(ux, uy);
  if (uLen > 1e-6) { ux /= uLen; uy /= uLen; } else { ux = 0; uy = 0; }
  c.tx -= (rx * dx - ux * dy) * wpp;
  c.ty -= (ry * dx - uy * dy) * wpp;
  // c.tz unchanged — pan never leaves the ecliptic plane
}

cv.addEventListener('mousedown', e => {
  if (_pilot.active) {
    if (e.button === 0) {
      _pilotDrag = { x: e.clientX, y: e.clientY, sx: e.clientX, sy: e.clientY, moved: false };
      _panSX = e.clientX; _panSY = e.clientY;     // click-vs-drag test in _pilotClick
    }
    return;
  }
  if (e.button !== 0 && e.button !== 2) return;
  // Arm only — the drag activates in mousemove after a 4px threshold, so
  // clicks (and double-clicks) never nudge the camera.
  _dragArmed = (e.button === 2 || e.shiftKey) ? 'pan' : 'orbit';
  _dragMode = null;
  _panSX = e.clientX; _panSY = e.clientY;
  _panLX = e.clientX; _panLY = e.clientY;
  _camVTheta = 0; _camVPhi = 0;
  _lastInteractT = performance.now();
});

cv.addEventListener('mouseup', () => {
  _pilotDrag = null;
  _dragArmed = null;
  if (_dragMode) { _dragMode = null; cv.style.cursor = 'grab'; }
});

// Shared by the dblclick listener (desktop) and the touch double-tap detector
// (mobile). Debounced: Chrome Android synthesizes a dblclick for double-taps,
// which would otherwise fire this twice (enter focus, then instantly exit).
let _lastActivateT = 0;
function _handleDoubleActivate(mx, my) {
  const nowA = performance.now();
  if (nowA - _lastActivateT < 500) return;
  _lastActivateT = nowA;
  if (state.focusTarget) {
    // A double-click that lands on any object is a focus switch (the single
    // click already handled it) — never an exit
    if (_focusHitTest(mx, my)) return;
    // Exit when the double-click lands on empty space (off the focused body)
    const tp = _focusTargetPos(state.simTime);
    const s = ws(tp.x, tp.y, tp.z);
    const wpp = 2 * state.cam.dist * Math.tan(FOV_RAD / 2) / H;
    const objPx = Math.max(8, _focusRadiusAU / wpp);
    if (!s || Math.hypot(mx - s.x, my - s.y) > Math.max(40, objPx)) exitFocus();
    return;
  }
  if (state.hoverId) {
    const idx = NEOS.findIndex(n => n.id === state.hoverId);
    if (idx >= 0) enterFocus({ type: 'neo', idx });
  } else if (state.hoverMoon) {
    enterFocus({ type: 'moon', id: state.hoverMoon });
  } else if (state.hoverDwarf != null) {
    enterFocus({ type: 'dwarf', idx: state.hoverDwarf });
  } else if (state.hoverComet != null) {
    enterFocus({ type: 'comet', idx: state.hoverComet });
  } else if (state.hoverPlanet) {
    const idx = PLANETS.findIndex(p => p.key === state.hoverPlanet);
    if (idx >= 0) enterFocus({ type: 'planet', idx });
  } else if (state.showMPC && _mpcLoaded) {
    // Re-run the spatial-hash hit test: the first click of a double-click on
    // an MPC asteroid opens the dossier, which clears _hoverMPC.
    const hit = _mpcHit(mx, my);
    if (hit) enterFocus({ type: 'mpc', ast: hit.ast });
    else { state.cam.tx = 0; state.cam.ty = 0; state.cam.tz = 0; }
  } else {
    state.cam.tx = 0; state.cam.ty = 0; state.cam.tz = 0;   // recentre on the Sun
  }
}

cv.addEventListener('dblclick', e => {
  if (_pilot.active) { _pilotClick(e, true); return; }
  const r = cv.getBoundingClientRect();
  _handleDoubleActivate(e.clientX - r.left, e.clientY - r.top);
});

cv.addEventListener('mousemove',e=>{
  if (_pilot.active) { _pilotMouseMove(e); return; }
  const r=cv.getBoundingClientRect(),x=e.clientX-r.left,y=e.clientY-r.top;
  _mouseX = x; _mouseY = y;          // wheel handler zooms toward this point
  // e.buttons is the LIVE button state: when the button was released outside
  // the canvas our mouseup never fired, so any armed/active drag is stale —
  // end it here instead of dragging with no button pressed.
  if ((_dragMode || _dragArmed) && e.buttons === 0) {
    _dragMode = null; _dragArmed = null;
    cv.style.cursor = 'grab';
  }
  // Armed drag becomes active only after 4px of travel — below that the
  // gesture is still a click and the camera must not move
  if (!_dragMode && _dragArmed && e.buttons !== 0 &&
      Math.hypot(e.clientX - _panSX, e.clientY - _panSY) > 4) {
    _dragMode = _dragArmed;
    cv.style.cursor = 'grabbing';
  }
  if (_dragMode) {
    // Same orbit/pan math everywhere — in focus the orbit spins around the
    // followed object because the target is glued to it
    const dx = e.clientX - _panLX, dy = e.clientY - _panLY;
    if (_dragMode === 'orbit') {
      if (_magDolly) _magDolly.dTh = null;      // the user's orbit beats the side-view swing
      state.cam.theta -= dx * 0.005;
      state.cam.phi = Math.min(1.48, Math.max(-1.48, state.cam.phi + dy * 0.005));
      _camVTheta = -dx * 0.005; _camVPhi = dy * 0.005;   // inertia seed
    } else {
      camPan(dx, dy);
    }
    _lastInteractT = performance.now();
    _panLX = e.clientX; _panLY = e.clientY;
    return;
  }
  _panLX = e.clientX; _panLY = e.clientY;
  if (state.focusTarget) return;               // no hover/tooltips while focused
  let best=null,bestD=22;
  for(const n of NEOS){const p=orbitPos(n,state.simTime),s=ws(p.x,p.y,p.z);if(!s)continue;const d=Math.hypot(s.x-x,s.y-y);if(d<bestD){bestD=d;best=n;}}
  // Check planet hover (ws() null = behind the camera — skip)
  let bestPlanet=null,bestPD=18;
  if(state.showPlanets){
    for(const p of PLANETS){
      if(!state.planetToggles[p.key])continue;
      const pos=orbitPos(p,state.simTime),s=ws(pos.x,pos.y,0);
      if(!s)continue;
      const d=Math.hypot(s.x-x,s.y-y);
      if(d<bestPD){bestPD=d;bestPlanet=p;}
    }
  }
  // Moon hover — checked after NEOs and planets (a planet within its hit
  // radius wins); sep>3 skips moons buried inside the parent's disc
  state.hoverMoon=null;
  let moonHit=null;
  if(!best && !bestPlanet && state.showPlanets){
    for(let mi=0;mi<MOONS.length;mi++){
      const msp=_renderer.getMoonScreenPos(MOONS[mi].id);
      if(!msp||msp.sep<=3)continue;
      if(Math.hypot(x-msp.x,y-msp.y)<msp.r+8){moonHit=MOONS[mi];break;}
    }
  }
  // Dwarf planets + comets — after moons, before the MPC cloud
  state.hoverDwarf=null; state.hoverComet=null;
  let dwarfHit=-1, cometHit=-1;
  if(!best && !bestPlanet && !moonHit){
    for(let di=0;di<DWARF_PLANETS.length;di++){
      const s=_renderer.getDwarfScreenPos(di);
      if(s&&Math.hypot(x-s.x,y-s.y)<s.r+8){dwarfHit=di;break;}
    }
    if(dwarfHit<0)for(let ci=0;ci<COMETS.length;ci++){
      const s=_renderer.getCometScreenPos(ci);
      if(s&&Math.hypot(x-s.x,y-s.y)<s.r+8){cometHit=ci;break;}
    }
  }
  const tt=document.getElementById('tooltip');
  if(best){
    state.hoverId=best.id; state.hoverPlanet=null; _hoverMPC=null;
    tt.style.left=x+'px';tt.style.top=y+'px';tt.classList.add('show');
    document.getElementById('tt-name').textContent=best.name;
    document.getElementById('tt-desig').textContent=best.desig;
    document.getElementById('tt-d').textContent=`${best.nextLD} LD · ${best.nextKm} km`;
    document.getElementById('tt-v').textContent=`${best.vel} km/s`;
    cv.style.cursor='pointer';
  } else if(bestPlanet){
    state.hoverId=null; state.hoverPlanet=bestPlanet.key; _hoverMPC=null;
    tt.style.left=x+'px';tt.style.top=y+'px';tt.classList.add('show');
    const pos=orbitPos(bestPlanet,state.simTime);
    const r_AU=Math.sqrt(pos.x*pos.x+pos.y*pos.y);
    const T_yr=Math.pow(bestPlanet.a,1.5);
    const spd=visVivaKms(bestPlanet.a, r_AU);
    document.getElementById('tt-name').textContent=bestPlanet.name;
    document.getElementById('tt-desig').textContent=`T = ${T_yr.toFixed(2)} yr`;
    document.getElementById('tt-d').textContent=`${r_AU.toFixed(3)} AU`;
    document.getElementById('tt-v').textContent=`${spd} km/s`;
    cv.style.cursor='pointer';
  } else if(moonHit){
    state.hoverId=null; state.hoverPlanet=null; _hoverMPC=null; state.hoverMoon=moonHit.id;
    tt.style.left=x+'px';tt.style.top=y+'px';tt.classList.add('show');
    const mw=_moonWorldPos(moonHit.id,state.simTime);
    const epm=orbitPos(PLANETS[2],state.simTime);
    const dAUm=Math.hypot(mw.x-epm.x,mw.y-epm.y,mw.z);
    document.getElementById('tt-name').textContent=moonHit.name;
    document.getElementById('tt-desig').textContent='MOON OF '+moonHit.parent.toUpperCase()+' · P = '+Math.abs(moonHit.T).toFixed(2)+' D';
    document.getElementById('tt-d').textContent=Math.round(dAUm*1.496e8).toLocaleString('en-US')+' km · '+(dAUm/0.00257).toFixed(2)+' LD';
    document.getElementById('tt-v').textContent=_moonOrbSpeedKms(moonHit).toFixed(2)+' km/s';
    cv.style.cursor='pointer';
  } else if(dwarfHit>=0){
    state.hoverId=null; state.hoverPlanet=null; _hoverMPC=null; state.hoverDwarf=dwarfHit;
    const dd=DWARF_PLANETS[dwarfHit];
    const dp=orbitPos(DWARF_ELEMS[dwarfHit],state.simTime);
    const rAUd=Math.hypot(dp.x,dp.y,dp.z||0);
    tt.style.left=x+'px';tt.style.top=y+'px';tt.classList.add('show');
    document.getElementById('tt-name').textContent=dd.name;
    document.getElementById('tt-desig').textContent='DWARF PLANET · T = '+Math.pow(dd.a,1.5).toFixed(1)+' yr';
    document.getElementById('tt-d').textContent=rAUd.toFixed(3)+' AU';
    document.getElementById('tt-v').textContent=visVivaKms(dd.a,rAUd)+' km/s';
    cv.style.cursor='pointer';
  } else if(cometHit>=0){
    state.hoverId=null; state.hoverPlanet=null; _hoverMPC=null; state.hoverComet=cometHit;
    const cc=COMETS[cometHit];
    const cp=orbitPos(COMET_ELEMS[cometHit],state.simTime);
    const rAUc=Math.hypot(cp.x,cp.y,cp.z||0);
    tt.style.left=x+'px';tt.style.top=y+'px';tt.classList.add('show');
    document.getElementById('tt-name').textContent=cc.name;
    document.getElementById('tt-desig').textContent='COMET · T = '+Math.pow(cc.a,1.5).toFixed(1)+' yr · q = '+(cc.a*(1-cc.e)).toFixed(2)+' AU';
    document.getElementById('tt-d').textContent=rAUc.toFixed(3)+' AU';
    document.getElementById('tt-v').textContent=visVivaKms(cc.a,rAUc)+' km/s';
    cv.style.cursor='pointer';
  } else if(state.showMPC && _mpcLoaded) {
    // ── MPC asteroid hover via O(1) spatial hash ──────────────────────────
    const hit = _mpcHit(x, y);
    if(hit){
      state.hoverId=null; state.hoverPlanet=null; _hoverMPC=hit;
      const ast=hit.ast;
      const currentJD = _SIM_EPOCH_JD + state.simTime;
      const astPos = getMPCPosition(ast, currentJD);
      const earthPos = orbitPos(PLANETS[2], state.simTime);
      const dist_AU = Math.hypot(astPos.x - earthPos.x, astPos.y - earthPos.y, astPos.z);
      const dist_LD = (dist_AU / 0.00257).toFixed(2);
      const q = ast.a * (1 - ast.e);
      const type = ast.a < 1 ? 'Aten' : q < 1.017 ? 'Apollo' : q < 1.3 ? 'Amor' : 'MBA';
      tt.style.left=x+'px'; tt.style.top=y+'px'; tt.classList.add('show');
      document.getElementById('tt-name').textContent = ast.name || ast.designation;
      document.getElementById('tt-desig').textContent = ast.designation + ' · ' + type + ' · H=' + (ast.H||'?');
      document.getElementById('tt-d').textContent = dist_LD + ' LD · ' + dist_AU.toFixed(4) + ' AU';
      document.getElementById('tt-v').textContent = 'click for N-body dossier';
      cv.style.cursor='pointer';
    } else {
      state.hoverId=null; state.hoverPlanet=null; _hoverMPC=null;
      tt.classList.remove('show');
      if(!_dragMode) cv.style.cursor='grab';
    }
  } else{
    state.hoverId=null; state.hoverPlanet=null; _hoverMPC=null;
    tt.classList.remove('show');
    if(!_dragMode) cv.style.cursor='grab';
  }
});

cv.addEventListener('mouseleave',()=>{
  if (_pilot.active) return;                  // a steering drag may leave and re-enter the canvas
  _dragMode=null; _dragArmed=null;
  state.hoverId=null; state.hoverPlanet=null; state.hoverMoon=null;
  state.hoverDwarf=null; state.hoverComet=null;
  document.getElementById('tooltip').classList.remove('show');
  cv.style.cursor='grab';
});
cv.addEventListener('click',e=>{
  if (_pilot.active) { _pilotClick(e, false); return; }
  // A click that travelled more than 5px from the mousedown was a camera
  // drag, not a selection — the browser still fires click on drag-release.
  // (mouseup only resets the drag state; selection is processed here.)
  if(Math.hypot(e.clientX-_panSX,e.clientY-_panSY)>5) return;
  if(state.focusTarget){
    // Focus mode: a single click on any OTHER object swaps the focus to it —
    // the camera dollies straight there, no exit round-trip. Empty space or
    // the focused object itself: no-op. Drag-releases are ignored.
    if(state.focusMode && !_exitAnim
       && Math.hypot(e.clientX-_panSX,e.clientY-_panSY)<4){
      const rc=cv.getBoundingClientRect();
      const hit=_focusHitTest(e.clientX-rc.left,e.clientY-rc.top);
      if(hit && !_sameFocusTarget(hit,state.focusTarget)) _switchFocus(hit);
    }
    return;
  }
  if(state.hoverId){
    // Close dossier when clicking a tracked NEO
    closeMPCDossier();
    state.selectedId=state.hoverId; renderList(); renderSelected();
  } else if(_hoverMPC) {
    // Promote MPC asteroid to N-body and open dossier
    openMPCDossier(_hoverMPC);
  }
});
cv.addEventListener('wheel',e=>{
  e.preventDefault();
  if (_pilot.active) {
    // Wheel = thrust limit (×0.02 … ×25): the fine control for close passes
    _pilot.limit = Math.max(0.02, Math.min(25, _pilot.limit * (e.deltaY > 0 ? 0.8 : 1.25)));
    _pilotHud(true);
    return;
  }
  // Exponential dolly — continuous zoom from the full system to a surface
  const factor = e.deltaY > 0 ? 1.10 : 0.90;
  _magDolly = null;                            // the user takes over the dolly
  if (state.focusTarget && !_focusFollow && !_exitAnim) {
    // Mid-entry glide: retarget the dolly endpoint so the wheel never fights
    // the animation
    _focusDistTarget = Math.max(_focusMinDist, Math.min(CAM_MAX_DIST, _focusDistTarget * factor));
  } else {
    // Zoom-to-cursor: nudge the target toward the point under the mouse so
    // the dolly heads for the cursor, not the Sun. Skipped while focused —
    // tick() glues the target to the followed object.
    if (!state.focusTarget) {
      const wpp = 2 * state.cam.dist * Math.tan(FOV_RAD / 2) / H;
      const cx = (_mouseX / W - 0.5) * 2, cy = (_mouseY / H - 0.5) * 2;
      const me = _renderer.camera.matrixWorld.elements;  // col 0 = right, col 1 = up
      const frac = e.deltaY > 0 ? -0.15 : 0.15;  // 15% of the dolly goes to the target
      const k = wpp * H * frac;
      state.cam.tx += (me[0] * cx - me[4] * cy) * k;
      state.cam.ty += (me[1] * cx - me[5] * cy) * k;
      state.cam.tz += (me[2] * cx - me[6] * cy) * k;
    }
    // Dolly floor is dynamic in focus follow (just above the surface)
    const minD = _focusFollow ? _focusMinDist : 0.0005;
    state.cam.dist = Math.max(minD, Math.min(CAM_MAX_DIST, state.cam.dist * factor));
    // Zooming far out of a focused object (4× the dolly target) leaves focus
    // silently — no return glide, the camera keeps this exact distance
    if (state.focusMode && _focusFollow && !_exitAnim &&
        state.cam.dist > _focusDistTarget * 4) {
      exitFocusSilent();
    }
  }
  _lastInteractT = performance.now();
},{passive:false});
document.addEventListener('keydown',e=>{
  if(e.target.tagName==='INPUT')return;
  if(_pilotKeyDown(e))return;
  if(e.key==='Escape'&&state.focusMode){exitFocus();return;}
  if((e.key==='m'||e.key==='M')&&state.focusMode&&_magKey(state.focusTarget)){setMagField(!state.showMag);return;}
  if((e.key==='f'||e.key==='F')&&!state.focusTarget){
    if(state.hoverId){const idx=NEOS.findIndex(n=>n.id===state.hoverId);if(idx>=0)enterFocus({type:'neo',idx});}
    else if(state.hoverMoon){enterFocus({type:'moon',id:state.hoverMoon});}
    else if(state.hoverDwarf!=null){enterFocus({type:'dwarf',idx:state.hoverDwarf});}
    else if(state.hoverComet!=null){enterFocus({type:'comet',idx:state.hoverComet});}
    else if(state.hoverPlanet){const idx=PLANETS.findIndex(p=>p.key===state.hoverPlanet);if(idx>=0)enterFocus({type:'planet',idx});}
    else if(_hoverMPC){enterFocus({type:'mpc',ast:_hoverMPC.ast});}
    return;
  }
  if(e.key==='/'){e.preventDefault();document.getElementById('search-input').focus();}
  if(e.key===' '){e.preventDefault();document.getElementById('btn-play').click();}
});

// ─── Return to Live button ─────────────────────────────────────────────────
// J2000.0 = 2000-Jan-01 12:00:00 UTC
const _J2000_MS = Date.UTC(2000, 0, 1, 12, 0, 0);
// Sim epoch offset: simTime=0 corresponds to 2026-05-27 12:00 (9643 days from J2000)
const _T_SIM_MS = _J2000_MS + 9643 * 86400000;

function _nowSimDays() {
  // Current real time expressed as days from T_SIM (the sim epoch)
  return (Date.now() - _T_SIM_MS) / 86400000;
}

// Threshold: within 1 real minute of "now" = 1/(24*60) days
const _LIVE_THRESH_DAYS = 1 / (24 * 60);

function _updateLiveBtn() {
  // is-live class (cobalt + pulsing dot) fires when simulating —
  // it signals "you've left live mode, click to return".
  const isSimulating = state.playing;

  ['btn-live', 'fab-live'].forEach(function (id) {
    const el = document.getElementById(id);
    if (!el) return;
    el.classList.toggle('is-live', isSimulating);
    const label = el.querySelector('#live-label, .fab-label');
    if (label) label.textContent = isSimulating ? '● LIVE' : 'SIMULATE';
    const dot = el.querySelector('#live-dot, .fab-dot');
    if (dot) dot.style.animationPlayState = isSimulating ? 'running' : 'paused';
  });
}

function _handleLive() {
  if (state.playing) {
    // Simulate → Live: stop accumulation, pin immediately to Date.now()
    state.playing  = false;
    state.simTime  = (Date.now() - _T_SIM_RAF) / 86400000;
    playIc.innerHTML = '<path d="M8 5v14l11-7z"/>';  // play icon
  } else {
    // Live → Simulate: start accumulating from current real time
    state.playing = true;
    playIc.innerHTML = '<path d="M6 5h4v14H6zM14 5h4v14h-4z"/>';  // pause icon
  }
  _updateLiveBtn();
}
// Both LIVE buttons (desktop topbar + mobile FAB) share the exact same handler
[document.getElementById('btn-live'), document.getElementById('fab-live')]
  .filter(Boolean)
  .forEach(function (btn) {
    btn.addEventListener('click', _handleLive);
    btn.addEventListener('touchend', function (e) {
      e.preventDefault(); // suppress ghost click after touchend
      _handleLive();
    });
  });

// Poll every second: update button state + optionally sync clock display
setInterval(() => { _updateLiveBtn(); }, 1000);
_updateLiveBtn();

// ─── Bottom-sheet (mobile) ────────────────────────────────────
const _sidebar     = document.getElementById('radar-sidebar');
const _sheetHandle = document.getElementById('sheet-handle');

if (_sheetHandle && _sidebar) {
  var _dragStartY  = null;
  var _dragDeltaY  = 0;
  var CLOSE_THRESH = 80; // px of downward drag required to close

  _sheetHandle.addEventListener('touchstart', function (e) {
    _dragStartY = e.touches[0].clientY;
    _dragDeltaY = 0;
    // Remove CSS transition so the sheet tracks the finger in real time
    _sidebar.style.transition = 'none';
  }, { passive: true });

  _sheetHandle.addEventListener('touchmove', function (e) {
    if (_dragStartY === null) return;
    _dragDeltaY = e.touches[0].clientY - _dragStartY;
    // Only translate downward, and only when the sheet is currently open
    if (_dragDeltaY > 0 && _sidebar.classList.contains('sheet-open')) {
      _sidebar.style.transform = 'translateY(' + _dragDeltaY + 'px)';
      e.preventDefault();
    }
  }, { passive: false });

  _sheetHandle.addEventListener('touchend', function (e) {
    e.preventDefault(); // suppress ghost click
    // Re-enable smooth CSS transition for the snap animation
    _sidebar.style.transition = '';
    _sidebar.style.transform  = ''; // hand control back to CSS class

    if (_sidebar.classList.contains('sheet-open')) {
      // Drag down past threshold OR simple tap → close
      if (_dragDeltaY > CLOSE_THRESH || Math.abs(_dragDeltaY) < 10) {
        _sidebar.classList.remove('sheet-open');
      }
      // else: partial drag — spring back to open (CSS transition handles it)
    } else {
      // Sheet is collapsed: tap → open
      if (Math.abs(_dragDeltaY) < 10) {
        _sidebar.classList.add('sheet-open');
      }
    }

    _dragStartY = null;
    _dragDeltaY = 0;
  }, { passive: false });

  // Desktop fallback: mouse click toggles the sheet
  _sheetHandle.addEventListener('click', function () {
    _sidebar.classList.toggle('sheet-open');
  });
}
// Update the collapsed summary whenever selection changes
function _updateSheetSummary(n) {
  const nameEl = document.getElementById('sheet-name');
  const riskEl = document.getElementById('sheet-risk');
  if (nameEl) nameEl.textContent = n.name;
  if (riskEl) { riskEl.className = 'risk ' + n.risk; riskEl.textContent = n.label; }
  // Mobile bottom bar mirrors the same selection
  const mbName = document.getElementById('mb-name');
  const mbDot  = document.getElementById('mb-dot');
  if (mbName) mbName.textContent = n.name;
  if (mbDot)  mbDot.className = 'mb-dot r-' + n.risk;
}

// ─── Mobile bottom bar — FOCUS on the selected NEO + sheet trigger ──
(function () {
  const mbFocus = document.getElementById('mb-focus');
  const mbSheet = document.getElementById('mb-sheet');
  if (mbFocus) mbFocus.addEventListener('click', function () {
    var idx = NEOS.findIndex(function (n) { return n.id === state.selectedId; });
    if (idx >= 0) enterFocus({ type: 'neo', idx: idx });
  });
  if (mbSheet && _sidebar) mbSheet.addEventListener('click', function () {
    _sidebar.classList.add('sheet-open');
  });
})();

// ─── Mobile tap tooltip ───────────────────────────────────────
// Touch has no hover: a single tap runs the same hit tests as the mouse
// hover and shows the tooltip bottom-centre (clear of the finger), auto-
// hidden after 2 s or on the next tap anywhere. It also seeds the hover
// state, so the synthetic click that follows a tap selects NEOs / opens
// the MPC dossier exactly like the desktop hover→click flow.
var _ttHideTimer = null;
function _hideTapTooltip() {
  if (_ttHideTimer) { clearTimeout(_ttHideTimer); _ttHideTimer = null; }
  var tt = document.getElementById('tooltip');
  tt.classList.remove('show');
  tt.classList.remove('mobile-tap');
}
function _mobileTap(x, y) {
  if (state.focusTarget) {
    // Focus mode: a single tap on another object swaps the focus — same rule
    // as the desktop click
    if (state.focusMode && !_exitAnim) {
      var hitF = _focusHitTest(x, y);
      if (hitF && !_sameFocusTarget(hitF, state.focusTarget)) _switchFocus(hitF);
    }
    return;
  }
  var t = state.simTime;
  var tt = document.getElementById('tooltip');

  // Same hit tests as the mousemove hover, with touch-sized radii
  var best = null, bestD = 28;
  for (var i = 0; i < NEOS.length; i++) {
    var p = orbitPos(NEOS[i], t), s = ws(p.x, p.y, p.z);
    if (!s) continue;
    var d = Math.hypot(s.x - x, s.y - y);
    if (d < bestD) { bestD = d; best = NEOS[i]; }
  }
  var bestPlanet = null, bestPD = 24;
  if (!best && state.showPlanets) {
    for (var j = 0; j < PLANETS.length; j++) {
      var pl = PLANETS[j];
      if (!state.planetToggles[pl.key]) continue;
      var pp = orbitPos(pl, t), sp = ws(pp.x, pp.y, 0);
      if (!sp) continue;
      var dp = Math.hypot(sp.x - x, sp.y - y);
      if (dp < bestPD) { bestPD = dp; bestPlanet = pl; }
    }
  }
  // Moons — after planets; sep>3 skips moons buried in the parent's disc
  var moonTap = null;
  if (!best && !bestPlanet && state.showPlanets) {
    for (var mi = 0; mi < MOONS.length; mi++) {
      var msp = _renderer.getMoonScreenPos(MOONS[mi].id);
      if (!msp || msp.sep <= 3) continue;
      if (Math.hypot(x - msp.x, y - msp.y) < msp.r + 12) { moonTap = MOONS[mi]; break; }
    }
  }
  // Dwarf planets + comets — touch-sized radius
  var dwarfTap = -1, cometTap = -1;
  if (!best && !bestPlanet && !moonTap) {
    for (var dti = 0; dti < DWARF_PLANETS.length; dti++) {
      var dts = _renderer.getDwarfScreenPos(dti);
      if (dts && Math.hypot(x - dts.x, y - dts.y) < dts.r + 12) { dwarfTap = dti; break; }
    }
    if (dwarfTap < 0) for (var cti = 0; cti < COMETS.length; cti++) {
      var cts = _renderer.getCometScreenPos(cti);
      if (cts && Math.hypot(x - cts.x, y - cts.y) < cts.r + 12) { cometTap = cti; break; }
    }
  }

  state.hoverId = null; state.hoverPlanet = null; state.hoverMoon = null; _hoverMPC = null;
  state.hoverDwarf = null; state.hoverComet = null;
  var hit = true;
  if (best) {
    state.hoverId = best.id;
    document.getElementById('tt-name').textContent = best.name;
    document.getElementById('tt-desig').textContent = best.desig;
    document.getElementById('tt-d').textContent = best.nextLD + ' LD · ' + best.nextKm + ' km';
    document.getElementById('tt-v').textContent = best.vel + ' km/s';
  } else if (bestPlanet) {
    state.hoverPlanet = bestPlanet.key;
    var pos2 = orbitPos(bestPlanet, t);
    var rAU = Math.hypot(pos2.x, pos2.y);
    document.getElementById('tt-name').textContent = bestPlanet.name;
    document.getElementById('tt-desig').textContent = 'T = ' + Math.pow(bestPlanet.a, 1.5).toFixed(2) + ' yr';
    document.getElementById('tt-d').textContent = rAU.toFixed(3) + ' AU';
    document.getElementById('tt-v').textContent = visVivaKms(bestPlanet.a, rAU) + ' km/s';
  } else if (moonTap) {
    state.hoverMoon = moonTap.id;
    var mwT = _moonWorldPos(moonTap.id, t);
    var epT2 = orbitPos(PLANETS[2], t);
    var dAUt = Math.hypot(mwT.x - epT2.x, mwT.y - epT2.y, mwT.z);
    document.getElementById('tt-name').textContent = moonTap.name;
    document.getElementById('tt-desig').textContent = 'MOON OF ' + moonTap.parent.toUpperCase() + ' · P = ' + Math.abs(moonTap.T).toFixed(2) + ' D';
    document.getElementById('tt-d').textContent = Math.round(dAUt * 1.496e8).toLocaleString('en-US') + ' km · ' + (dAUt / 0.00257).toFixed(2) + ' LD';
    document.getElementById('tt-v').textContent = _moonOrbSpeedKms(moonTap).toFixed(2) + ' km/s';
  } else if (dwarfTap >= 0) {
    state.hoverDwarf = dwarfTap;
    var ddT = DWARF_PLANETS[dwarfTap];
    var dpT = orbitPos(DWARF_ELEMS[dwarfTap], t);
    var rT = Math.hypot(dpT.x, dpT.y, dpT.z || 0);
    document.getElementById('tt-name').textContent = ddT.name;
    document.getElementById('tt-desig').textContent = 'DWARF PLANET · T = ' + Math.pow(ddT.a, 1.5).toFixed(1) + ' yr';
    document.getElementById('tt-d').textContent = rT.toFixed(3) + ' AU';
    document.getElementById('tt-v').textContent = visVivaKms(ddT.a, rT) + ' km/s';
  } else if (cometTap >= 0) {
    state.hoverComet = cometTap;
    var ccT = COMETS[cometTap];
    var cpT = orbitPos(COMET_ELEMS[cometTap], t);
    var rT2 = Math.hypot(cpT.x, cpT.y, cpT.z || 0);
    document.getElementById('tt-name').textContent = ccT.name;
    document.getElementById('tt-desig').textContent = 'COMET · T = ' + Math.pow(ccT.a, 1.5).toFixed(1) + ' yr';
    document.getElementById('tt-d').textContent = rT2.toFixed(3) + ' AU';
    document.getElementById('tt-v').textContent = visVivaKms(ccT.a, rT2) + ' km/s';
  } else {
    var mHit = state.showMPC && _mpcLoaded ? _mpcHit(x, y) : null;
    if (mHit) {
      _hoverMPC = mHit;
      var ast = mHit.ast;
      var apos = getMPCPosition(ast, _SIM_EPOCH_JD + t);
      var ep = orbitPos(PLANETS[2], t);
      var dAU = Math.hypot(apos.x - ep.x, apos.y - ep.y, apos.z);
      var q = ast.a * (1 - ast.e);
      var type = ast.a < 1 ? 'Aten' : q < 1.017 ? 'Apollo' : q < 1.3 ? 'Amor' : 'MBA';
      document.getElementById('tt-name').textContent = ast.name || ast.designation;
      document.getElementById('tt-desig').textContent = ast.designation + ' · ' + type + ' · H=' + (ast.H || '?');
      document.getElementById('tt-d').textContent = (dAU / 0.00257).toFixed(2) + ' LD · ' + dAU.toFixed(4) + ' AU';
      document.getElementById('tt-v').textContent = 'double-tap to focus';
    } else {
      hit = false;
    }
  }

  if (hit) {
    tt.classList.add('show');
    tt.classList.add('mobile-tap');
    if (_ttHideTimer) clearTimeout(_ttHideTimer);
    _ttHideTimer = setTimeout(_hideTapTooltip, 2000);   // auto-hide after 2 s
  } else {
    _hideTapTooltip();                                  // tap on empty space
  }
}

// ─── Touch controls ───────────────────────────────────────────
// 1 finger: orbit. 2-finger pinch: dolly (ratio of finger distances).
// 2-finger parallel drag: pan (centroid movement). Same math as the mouse.
// touchend doubles as the tap / double-tap detector (dblclick never fires
// reliably on mobile): a tap = ≤10px travel; two taps within 300 ms = the
// same action as the desktop double-click.
(function () {
  let touchOrbit = null;         // { x, y } — last 1-finger position
  let pinchDist  = null;         // last 2-finger distance
  let lastCX = 0, lastCY = 0;    // last 2-finger centroid
  let tapStart = null;           // 1-finger touchstart position (tap test)
  let lastTapT = 0;              // timestamp of the previous qualifying tap
  let lastTapX = 0, lastTapY = 0;

  cv.addEventListener('touchstart', function (e) {
    _lastInteractT = performance.now();
    if (e.touches.length === 2) {
      pinchDist = Math.hypot(
        e.touches[0].clientX - e.touches[1].clientX,
        e.touches[0].clientY - e.touches[1].clientY
      );
      lastCX = (e.touches[0].clientX + e.touches[1].clientX) / 2;
      lastCY = (e.touches[0].clientY + e.touches[1].clientY) / 2;
      touchOrbit = null;
      tapStart = null;
      e.preventDefault();
    } else if (e.touches.length === 1) {
      touchOrbit = { x: e.touches[0].clientX, y: e.touches[0].clientY };
      tapStart = { x: e.touches[0].clientX, y: e.touches[0].clientY };
      pinchDist = null;
    }
  }, { passive: false });

  cv.addEventListener('touchmove', function (e) {
    e.preventDefault();
    _lastInteractT = performance.now();
    if (e.touches.length === 2 && pinchDist !== null) {
      // Pinch = exponential dolly
      var d = Math.hypot(
        e.touches[0].clientX - e.touches[1].clientX,
        e.touches[0].clientY - e.touches[1].clientY
      );
      if (d > 1) {
        var ratio = pinchDist / d;
        if (state.focusTarget && !_focusFollow && !_exitAnim) {
          _focusDistTarget = Math.max(_focusMinDist, Math.min(CAM_MAX_DIST, _focusDistTarget * ratio));
        } else {
          var minD = _focusFollow ? _focusMinDist : 0.0005;
          state.cam.dist = Math.max(minD, Math.min(CAM_MAX_DIST, state.cam.dist * ratio));
        }
        pinchDist = d;
      }
      // Parallel drag = pan via centroid movement (no-op while focused)
      var cx = (e.touches[0].clientX + e.touches[1].clientX) / 2;
      var cy = (e.touches[0].clientY + e.touches[1].clientY) / 2;
      camPan(cx - lastCX, cy - lastCY);
      lastCX = cx; lastCY = cy;
    } else if (e.touches.length === 1 && touchOrbit) {
      var dx = e.touches[0].clientX - touchOrbit.x;
      var dy = e.touches[0].clientY - touchOrbit.y;
      if (_magDolly) _magDolly.dTh = null;
      state.cam.theta -= dx * 0.005;
      state.cam.phi = Math.min(1.48, Math.max(-1.48, state.cam.phi + dy * 0.005));
      _camVTheta = -dx * 0.005; _camVPhi = dy * 0.005;
      touchOrbit = { x: e.touches[0].clientX, y: e.touches[0].clientY };
    }
  }, { passive: false });

  cv.addEventListener('touchend', function (e) {
    // ── Tap / double-tap detection ──
    // A tap = single finger lifted after ≤10px of travel. Two taps within
    // 300 ms and ~30px of each other = double-tap → same as dblclick.
    var wasTap = false, tx = 0, ty = 0;
    if (tapStart && e.touches.length === 0 && e.changedTouches.length === 1) {
      var ct = e.changedTouches[0];
      if (Math.hypot(ct.clientX - tapStart.x, ct.clientY - tapStart.y) <= 10) {
        wasTap = true; tx = ct.clientX; ty = ct.clientY;
      }
    }
    tapStart = null;
    if (wasTap) {
      var nowT = performance.now();
      var rc = cv.getBoundingClientRect();
      var mx = tx - rc.left, my = ty - rc.top;
      if (nowT - lastTapT < 300 && Math.hypot(tx - lastTapX, ty - lastTapY) < 30) {
        lastTapT = 0;
        _hideTapTooltip();
        _handleDoubleActivate(mx, my);       // same logic as the dblclick handler
      } else {
        lastTapT = nowT; lastTapX = tx; lastTapY = ty;
        _mobileTap(mx, my);                  // tooltip + hover state (single tap)
      }
    }

    if (e.touches.length < 2) pinchDist = null;
    if (e.touches.length === 0) touchOrbit = null;
    else if (e.touches.length === 1) {
      touchOrbit = { x: e.touches[0].clientX, y: e.touches[0].clientY };
    }
  });
})();

// ─── Controls hint — mobile wording + fade-out 8 s after first interaction ───
(function () {
  var hint = document.getElementById('controls-hint');
  if (!hint) return;
  if (window.innerWidth < 768 || 'ontouchstart' in window) {
    hint.innerHTML = '1 FINGER · orbit<br>2 FINGERS · pan &amp; zoom';
  }
  var armed = false;
  function _hintArm() {
    if (armed) return;
    armed = true;
    setTimeout(function () { hint.style.opacity = '0'; }, 8000);
  }
  cv.addEventListener('mousedown', _hintArm);
  cv.addEventListener('touchstart', _hintArm, { passive: true });
}());

// Wrap renderSelected so mobile sheet summary stays in sync
renderSelected = (function (orig) {
  return function () {
    orig();
    var n = NEOS.find(function (x) { return x.id === state.selectedId; });
    if (n) _updateSheetSummary(n);
  };
}(renderSelected));

renderList(); renderSelected(); renderAlignments(); updateScaleBar();

// Custom timezone dropdowns — desktop + mobile stay in sync
(function () {
  var TZLABELS = {
    'UTC':                 'UTC',
    'America/Sao_Paulo':   'BRT (Brasília)',
    'America/New_York':    'EST (New York)',
    'America/Los_Angeles': 'PST (Los Angeles)',
    'Europe/London':       'GMT (London)',
    'Europe/Paris':        'CET (Paris)',
    'Asia/Tokyo':          'JST (Tokyo)',
    'Asia/Shanghai':       'CST (Shanghai)',
    'Australia/Sydney':    'AEST (Sydney)',
  };

  // Collect both dropdown instances (desktop + mobile)
  var instances = [
    { trigger: document.getElementById('tz-trigger'),
      menu:    document.getElementById('tz-menu'),
      current: document.getElementById('tz-current') },
    { trigger: document.getElementById('tz-trigger-mobile'),
      menu:    document.getElementById('tz-menu-mobile'),
      current: document.getElementById('tz-current-mobile') },
  ].filter(function (d) { return d.trigger && d.menu && d.current; });

  function closeAll() {
    instances.forEach(function (d) { d.menu.classList.remove('open'); });
  }

  function applyTz(tz) {
    _selectedTz = tz;
    instances.forEach(function (d) {
      d.current.textContent = TZLABELS[tz] || tz;
      d.menu.querySelectorAll('li').forEach(function (li) {
        li.classList.toggle('active', li.dataset.tz === tz);
      });
    });
    updateClock();
  }

  instances.forEach(function (d) {
    // Toggle open/close on trigger click
    d.trigger.addEventListener('click', function (e) {
      e.stopPropagation();
      var wasOpen = d.menu.classList.contains('open');
      closeAll();
      if (!wasOpen) d.menu.classList.add('open');
    });
    // Select timezone on option click
    d.menu.querySelectorAll('li').forEach(function (li) {
      li.addEventListener('click', function () {
        applyTz(li.dataset.tz);
        closeAll();
      });
    });
  });

  // Close on any outside click
  document.addEventListener('click', closeAll);

  // Initialize both to detected timezone
  applyTz(_selectedTz);
}());
</script>

