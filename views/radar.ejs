  for (var i = 0; i < P.bodies.length; i++) {
    var b = P.bodies[i];
    var dx = b.x - P.x, dy = b.y - P.y, dz = b.z - P.z, L = Math.hypot(dx, dy, dz);
    if (L < b.r * 1.05) continue;
