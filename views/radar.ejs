function enterPilot() {
  var P = _pilot;
  if (P.active || window.innerWidth < 768) return;
  // Start next to whatever is focused, otherwise next to Earth
  var startTg = state.focusTarget
    ? Object.assign({}, state.focusTarget)
    : { type: 'planet', idx: PLANETS.findIndex(function (p) { return p.key === 'earth'; }) };
  if (state.focusTarget) exitFocusSilent();
  closeMPCDossier();
  if (!_pilotV) {
    _pilotV = new THREE.Vector3(); _pilotV2 = new THREE.Vector3(); _pilotV3 = new THREE.Vector3();
    _pilotQ = new THREE.Quaternion(); _pilotM = new THREE.Matrix4();
    P.q = new THREE.Quaternion(); P.cq = new THREE.Quaternion();
    P.bodies = _pilotBuildBodies();
    _pilotBuildChips();
  }
  state._camBeforePilot = Object.assign({}, state.cam);
  P.active = true;
  _pilotKeys = {}; _pilotDrag = null;
  P.yawRate = P.pitchRate = P.rollRate = P.dragYaw = P.dragPitch = P.visYaw = P.visPitch = 0;
  P.throttle = 0; P.speed = 0; P.limit = 1; P.auto = false; P.autoV = 0;
  _pilotRefreshBodies(state.simTime);
  var b = _pilotBodyFor(startTg);
  P.anchor = b;
  var hint = new THREE.Vector3(0.35, -0.55, 0.2).normalize();
  var at = _pilotViewPoint(b, b.r * 4.6, hint, new THREE.Vector3());
  _pilotSetWorld(at.x, at.y, at.z);
  _pilotLookAt(P.x, P.y, P.z, b, new THREE.Vector3(0, 0, 1), P.q);
  P.cq.copy(P.q);
