  if (tg.type === 'planet') return PLANETS[tg.idx].name;
  if (tg.type === 'moon')   return MOONS_BY_ID[tg.id].name;
  if (tg.type === 'dwarf')  return DWARF_PLANETS[tg.idx].name;
  if (tg.type === 'comet')  return COMETS[tg.idx].short || COMETS[tg.idx].name;
  if (tg.type === 'neo')    return NEOS[tg.idx].name;
