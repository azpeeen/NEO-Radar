document.getElementById('focus-exit-btn').addEventListener('click', exitFocus);
document.getElementById('focus-btn').addEventListener('click', function (e) {
  e.preventDefault();
  var idx = NEOS.findIndex(function (n) { return n.id === state.selectedId; });
  if (idx >= 0) enterFocus({ type: 'neo', idx: idx });
});

// ─── Pilot mode ──────────────────────────────────────────────────────────────
// Fly a ship through the live system (P, or the PILOT SHIP button). This is a
// free camera with a hull, NOT a physical spacecraft: there is no gravity on
// the ship and no speed-of-light limit, and the HUD says so whenever the ship
// goes faster than light. Everything the ship flies past is the real scene:
// same positions, same sizes, same clock.
//
// Three ideas make it flyable across twelve orders of magnitude:
//   1. Speed scales with the distance to the nearest surface, so one throttle
//      crosses 30 AU in seconds and still creeps up on a 300 m asteroid.
//   2. The ship's position is stored relative to an ANCHOR body while it is
//      close to one. Planets move at ~30 km/s (and far faster under time
//      acceleration); without this they would simply leave the ship behind.
//   3. The autopilot flies to a point on the DAY side of the target and stops
//      where the body spans about 60% of the view height.
//
// The renderer (renderer3d.js) draws the hull in its own pass; this file owns
