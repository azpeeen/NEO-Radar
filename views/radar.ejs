}
// Attitude that looks from (x,y,z) at body b, keeping `up` as far as possible
function _pilotLookAt(x, y, z, b, up, out) {
  _pilotM.lookAt(_pilotV.set(x, y, z), _pilotV2.set(b.x, b.y, b.z), up);
  return out.setFromRotationMatrix(_pilotM);
}
function _pilotSetWorld(x, y, z) {
  var P = _pilot, a = P.anchor;
  P.x = x; P.y = y; P.z = z;
  P.rx = x - (a ? a.x : 0); P.ry = y - (a ? a.y : 0); P.rz = z - (a ? a.z : 0);
}
function _pilotSetAnchor(b) {
  var P = _pilot;
  if (P.anchor === b) return;
  P.anchor = b;                                 // world position is continuous across the switch
  P.rx = P.x - (b ? b.x : 0); P.ry = P.y - (b ? b.y : 0); P.rz = P.z - (b ? b.z : 0);
}

function _pilotSetTarget(tg, engage) {
  var P = _pilot;
  if (!P.active) return;
  P.target = tg ? _pilotBodyFor(tg) : null;
  P.auto = false; P.autoV = 0;
  if (P.target && engage) _pilotEngage();
  _syncAsteroidMesh();                          // NEO/MPC targets get their rock mesh
  _pilotHud(true);
}
function _pilotEngage() {
  var P = _pilot, T = P.target;
  if (!T) return;
  // Remember which side the ship came from: the arrival point leans that way
  var dx = P.x - T.x, dy = P.y - T.y, dz = P.z - T.z, L = Math.hypot(dx, dy, dz) || 1;
  P.autoHint = { x: dx / L, y: dy / L, z: dz / L };
  P.auto = true; P.autoV = 0;
  _pilotSetAnchor(T);                           // fly in the target's own moving frame
}
// T key: the body nearest the crosshair, within 25° of the nose
function _pilotTargetAhead() {
