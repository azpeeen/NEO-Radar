        state.cam.phi = S.phi + (om.phi - S.phi) * eF;
      } else if (state._focusOrientTarget) {
        const o = _cometViewOrient(tp);
        let dTheta = o.theta - S.theta;
        while (dTheta > Math.PI) dTheta -= 2 * Math.PI;
        while (dTheta < -Math.PI) dTheta += 2 * Math.PI;
        state.cam.theta = S.theta + dTheta * eF;
        state.cam.phi = S.phi + (o.phi - S.phi) * eF;
