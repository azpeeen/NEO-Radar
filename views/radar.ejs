<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<!-- GLTFLoader served locally (CSP allows 'self' + cdnjs only; cdnjs lacks examples/).
     Fetched by scripts/downloadAsteroidModels.js — if absent, the renderer
     detects the missing THREE.GLTFLoader and uses procedural meshes only. -->
<script src="/js/GLTFLoader.js"></script>
<script src="/js/renderer3d.js"></script>

<script>
// Catalog injected server-side from src/data/catalog.js (47 objects)
const NEOS = <%- JSON.stringify(neos.map(n => ({
  id:       n.id,
  name:     n.name,
  desig:    n.desig,
  risk:     n.riskLevel,
  label:    n.label,
  a:        n.a,
  e:        n.e,
  i:        n.i,
  om:       n.Omega,
  w:        n.omega,
  phase:    n.phase,
  nextLD:   n.missDist_ld,
  nextDate: n.nextDate,
  nextKm:   n.nextKm,
  vel:      n.velocity_kms,
}))) %>;

// Deep-link initial state
const _FOCUS_ID   = <%- JSON.stringify(focusId) %>;
const _FOCUS_DATE = <%- JSON.stringify(focusDate) %>;
const PLANETS = [
  { name:'Mercury', a:0.387,  e:0.206, phase:1.50, color:'#b5b5b5', r:3, key:'mercury', inner:true  },
  { name:'Venus',   a:0.723,  e:0.007, phase:4.20, color:'#e8cda0', r:3, key:'venus',   inner:true  },
  { name:'Earth',   a:1.000,  e:0.017, phase:2.60, color:'#4f8fff', r:4, key:'earth',   inner:false, glow:true },
  { name:'Mars',    a:1.524,  e:0.093, phase:0.80, color:'#e07050', r:3, key:'mars',    inner:true  },
  { name:'Jupiter', a:5.204,  e:0.048, phase:5.70, color:'#c79b6e', r:7, key:'jupiter', inner:false, glow:true },
  { name:'Saturn',  a:9.583,  e:0.054, phase:1.30, color:'#c9b079', r:6, key:'saturn',  inner:false, ring:true },
  { name:'Uranus',  a:19.218, e:0.047, phase:4.45, color:'#7de8e8', r:5, key:'uranus',  inner:false },
  { name:'Neptune', a:30.070, e:0.009, phase:5.48, color:'#4b6eff', r:5, key:'neptune', inner:false },
];

// Alignment data from server
const ALIGNMENTS = <%- JSON.stringify(alignments || []) %>;
// Apply deep-link date if provided (?date=2029-04-13)
let _initSimTime = 0;
if (_FOCUS_DATE) {
  const epoch = new Date(Date.UTC(2026,4,27,12,0,0));
  const target = new Date(_FOCUS_DATE + 'T00:00:00Z');
  _initSimTime = Math.max(0, (target - epoch) / 86400000);
}

const state = {
  selectedId: (_FOCUS_ID && NEOS.find(n => n.id === _FOCUS_ID)) ? _FOCUS_ID : (NEOS[0] && NEOS[0].id),
  hoverId: null, hoverPlanet: null, hoverLuna: false,
  filter: 'all', search: '',
  // playing=false → live mode (JD pinned to Date.now() every frame)
  // playing=true  → simulate mode (dt accumulates)
  // Deep-link dates start in simulate so the specific date is shown.
  playing: !!_FOCUS_DATE, speed: 1.0,
  daysPerSec: 12,
  simTime: _FOCUS_DATE
    ? _initSimTime
    : (Date.now() - (Date.UTC(2000, 0, 1, 12, 0, 0) + 9643 * 86400000)) / 86400000,
  jupiter: true, saturn: true, uncertainty: true, trails: true, inner: false,
  // ── Free-orbit perspective camera (NASA Eyes style) ──
  // The renderer derives the camera position by spherical coordinates around
  // the target; the ecliptic plane is world XY and +z is "up".
  cam: {
    tx: 0, ty: 0, tz: 0,   // target: point the camera looks at (AU)
    dist: 7.0,             // camera→target distance (AU)
    theta: 0,              // azimuth, rad (rotation about the ecliptic normal)
    phi: 1.20,             // elevation, rad (~69° — tilted near-top-down, Eyes-like)
  },
  showPlanets: true, showOrbits: true, showMPC: true,
  planetToggles: { mercury:false, venus:false, earth:true, mars:false, jupiter:true, saturn:true, uranus:true, neptune:true },
  // ── Focus mode — cinematic camera follow on the MAIN scene ──
  focusMode: false,        // true while focused (exit animation runs after → false)
  focusTarget: null,       // { type:'neo'|'planet'|'luna'|'mpc', idx?|ast?, name, desig, a }
  focusLerp: 0,            // 0→1 entry animation progress (eased in tick)
  _camBeforeFocus: null,   // cam snapshot (6 numbers) restored on exit
};

function solveKepler(M, e) {
  let E = M + e*Math.sin(M);
  for (let k=0; k<20; k++) { const dE=(E-e*Math.sin(E)-M)/(1-e*Math.cos(E)); E-=dE; if(Math.abs(dE)<1e-10)break; }
  return E;
}
function orbitPos(o, t) {
  const period=Math.pow(o.a,1.5), M=((t/365.25)/period)*2*Math.PI+(o.phase||0), E=solveKepler(M,o.e);
  const x=o.a*(Math.cos(E)-o.e), y=o.a*Math.sqrt(1-o.e*o.e)*Math.sin(E);
  if (o.i) {
    // Full orbital→ecliptic rotation (ω, i, Ω) — inclination becomes real z
    const D2R=Math.PI/180, W=(o.w||0)*D2R, N=(o.om||0)*D2R, I=o.i*D2R;
    const cN=Math.cos(N), sN=Math.sin(N), cW=Math.cos(W), sW=Math.sin(W), cI=Math.cos(I), sI=Math.sin(I);
    return {
      x: (cN*cW - sN*sW*cI)*x + (-cN*sW - sN*cW*cI)*y,
      y: (sN*cW + cN*sW*cI)*x + (-sN*sW + cN*cW*cI)*y,
      z: (sW*sI)*x + (cW*sI)*y,
    };
  }
  const ang=((o.w||0)+(o.om||0))*Math.PI/180;
  return { x:x*Math.cos(ang)-y*Math.sin(ang), y:x*Math.sin(ang)+y*Math.cos(ang), z:0 };
}

// ─── Moon — visual-only circular orbit ───────────────────────────────────────
// Sole declaration of these globals: renderer3d.js (loaded earlier) reads them
// at render time — do NOT redeclare there (classic scripts share global scope).
const MOON_PERIOD = 27.321661;                                   // days, sidereal
const MOON_A      = 0.00257;                                     // AU (384,400 km)
const MOON_PHASE0 = ((9643 % MOON_PERIOD) / MOON_PERIOD) * 2 * Math.PI; // at sim epoch
function moonPos(simTime) {                                      // geocentric, AU
  var angle = MOON_PHASE0 + (simTime / MOON_PERIOD) * 2 * Math.PI;
  // MOON_INCL (5.145° vs ecliptic) is declared by renderer3d.js — the tilt
  // matches the renderer's inclined orbit circle exactly (node along +x)
  var sa = Math.sin(angle);
  return {
    x: MOON_A * Math.cos(angle),
    y: MOON_A * sa * Math.cos(MOON_INCL),
    z: MOON_A * sa * Math.sin(MOON_INCL),
  };
}

// ─── MPC asteroid layer (Layer 2 — Keplerian + Laplace-Lagrange secular) ─────
// Sim epoch: 2026-05-27 12:00 UTC = J2000 + 9643 days → JD 2461188.0
const _SIM_EPOCH_JD = 2451545.0 + 9643;
const _J2000_OFFSET = 9643; // _SIM_EPOCH_JD - J2000_JD

let _mpcAsteroids = [];
let _mpcLoaded    = false;

// ─── Browser-side Laplace-Lagrange secular theory ────────────────────────────
// Mirror of src/physics/secular.js — runs once at load time per asteroid.

function _secLaplace(alpha, n) {
  // b_{3/2}^{(1)}(alpha) via composite Simpson's rule (n intervals)
  var h = Math.PI / n, a2 = alpha * alpha, sum = 0;
  for (var k = 0; k <= n; k++) {
    var t = k * h, ct = Math.cos(t);
    var denom = Math.pow(1 - 2 * alpha * ct + a2, 1.5);
    var f = ct / denom; // cos(1·θ) = cos(θ)
    var w = (k === 0 || k === n) ? 1 : (k % 2 === 0 ? 2 : 4);
    sum += w * f;
  }
  return (2 / Math.PI) * (h / 3) * sum;
}

function computeSecularRates(ast) {
  var a = ast.a;
  if (!a || !isFinite(a) || a <= 0) return { dperi_dt: 0, dnode_dt: 0 };
  var n_ast = (2 * Math.PI) / (365.25 * Math.pow(a, 1.5)); // rad/day
  var planets = [{ a: 5.204267, m: 9.55e-4 }, { a: 9.582017, m: 2.86e-4 }];
  var rate = 0;
  for (var k = 0; k < planets.length; k++) {
    var p = planets[k];
    var alpha = a < p.a ? a / p.a : p.a / a;
    if (alpha >= 1) alpha = 0.9999;
    rate += (3 / 4) * n_ast * p.m * Math.pow(alpha, 3) * _secLaplace(alpha, 32);
  }
  return { dperi_dt: rate, dnode_dt: -rate };
}

// ─── Spatial hash for O(1) hit detection on 41k asteroids ────────────────────
const _GRID = 40; // px per cell
var _mpcVisible = []; // [{ast, sx, sy}, ...] rebuilt each frame
var _mpcGrid = new Map();

function _buildGrid() {
  _mpcGrid = new Map();
  for (var gi = 0; gi < _mpcVisible.length; gi++) {
    var e = _mpcVisible[gi];
    var gx = (e.sx / _GRID) | 0;
    var gy = (e.sy / _GRID) | 0;
    var key = gx * 100000 + gy;
    var bucket = _mpcGrid.get(key);
    if (!bucket) { bucket = []; _mpcGrid.set(key, bucket); }
    bucket.push(e);
  }
}

function _mpcHit(mx, my) {
  if (!_mpcGrid.size) return null;
  var gx = (mx / _GRID) | 0;
  var gy = (my / _GRID) | 0;
  var best = null, bestD2 = 14 * 14; // 14px hit radius
  for (var dx = -1; dx <= 1; dx++) {
    for (var dy = -1; dy <= 1; dy++) {
      var bucket = _mpcGrid.get((gx + dx) * 100000 + (gy + dy));
      if (!bucket) continue;
      for (var bi = 0; bi < bucket.length; bi++) {
        var be = bucket[bi];
        var d2 = (be.sx - mx) * (be.sx - mx) + (be.sy - my) * (be.sy - my);
        if (d2 < bestD2) { bestD2 = d2; best = be; }
      }
    }
  }
  return best; // { ast, sx, sy } or null
}

// ─── Promoted object state (Layer 3 — N-body on click) ───────────────────────
var _promotedAst     = null;  // the clicked MPC asteroid (dossier open)
var _promotedResult  = null;  // { trajectory, closeApproach, uncertainty }
var _promotedLoading = false;
var _hoverMPC        = null;  // currently hovered MPC entry { ast, sx, sy }
// Single shared 3D-mesh slot in the renderer: serves BOTH the dossier's
// promoted asteroid and the focused NEO/MPC (Part 6 — no separate scene).
var _promoKey        = null;  // designation currently promoted in the renderer
var _promoAstRef     = null;  // MPC ast whose cloud point is parked off-world

async function loadMPCAsteroids() {
  try {
    // Load ALL catalog asteroids (chunked: two requests of 25k)
    const [r1, r2] = await Promise.all([
      fetch('/api/asteroids/bulk?limit=25000&offset=0').then(r => r.json()),
      fetch('/api/asteroids/bulk?limit=25000&offset=25000').then(r => r.json()),
    ]);
    const combined = (r1.asteroids || []).concat(r2.asteroids || []);
    // Mobile: cap the cloud at 20k — halves the per-frame Kepler pass and the
    // vertex load on small screens (HUD count stays honest: it shows 20,000)
    _mpcAsteroids = window.innerWidth < 768 ? combined.slice(0, 20000) : combined;

    // Pre-compute secular rates once — O(1) per frame from here on
    for (var k = 0; k < _mpcAsteroids.length; k++) {
      _mpcAsteroids[k]._sec = computeSecularRates(_mpcAsteroids[k]);
    }
    _mpcLoaded = true;
    _initMPCBuffers();

    // Update HUD catalog count
    var el = document.getElementById('hud-catalog-count');
    var el2 = document.getElementById('hud-catalog-line');
    if (el) el.textContent = _mpcAsteroids.length.toLocaleString();
    if (el2) el2.style.display = '';
  } catch (e) {
    console.warn('[MPC] Failed to load asteroids:', e.message);
  }
}

function getMPCPosition(ast, currentJD) {
  var dt = currentJD - ast.epoch_jd;
  var n  = 0.9856076686 / Math.pow(ast.a, 1.5); // deg/day
  var M  = (ast.M + n * dt) % 360;
  if (M < 0) M += 360;

  var Mrad = M * Math.PI / 180;
  var E    = solveKepler(Mrad, ast.e);

  var x_orb = ast.a * (Math.cos(E) - ast.e);
  var y_orb = ast.a * Math.sqrt(1 - ast.e * ast.e) * Math.sin(E);

  // Apply secular perturbation (Laplace-Lagrange) — O(1), pre-computed rates
  var w_eff = ast.w, node_eff = ast.node;
  if (ast._sec) {
    var R2D = 180 / Math.PI;
    w_eff    += ast._sec.dperi_dt * R2D * dt;
    node_eff += ast._sec.dnode_dt * R2D * dt;
  }

  var w    = w_eff    * Math.PI / 180;
  var node = node_eff * Math.PI / 180;
  var i    = ast.i    * Math.PI / 180;

  var cosN = Math.cos(node), sinN = Math.sin(node);
  var cosW = Math.cos(w),    sinW = Math.sin(w);
  var cosI = Math.cos(i),    sinI = Math.sin(i);

  var x = (cosN * cosW - sinN * sinW * cosI) * x_orb
         + (-cosN * sinW - sinN * cosW * cosI) * y_orb;
  var y = (sinN * cosW + cosN * sinW * cosI) * x_orb
         + (-sinN * sinW + cosN * cosW * cosI) * y_orb;
  var z = (sinW * sinI) * x_orb + (cosW * sinI) * y_orb;

  return { x, y, z };
}

// ─── MPC point-cloud bridge ──────────────────────────────────────────────────
// Positions are still solved HERE (Layer 2 Kepler + secular) and written into
// a flat Float32Array that the renderer uploads as ONE THREE.Points draw call.
let _mpcPositions = null, _mpcColors = null;

function _initMPCBuffers() {
  const N = _mpcAsteroids.length;
  _mpcPositions = new Float32Array(N * 3);
  _mpcColors    = new Float32Array(N * 3);
  for (var k = 0; k < N; k++) {
    const ast = _mpcAsteroids[k];
    const q = ast.a * (1 - ast.e);
    let r, g, b;
    if      (ast.a < 1.0) { r = 1;    g = 0.39; b = 0.39; }  // Aten
    else if (q < 1.017)   { r = 1;    g = 0.71; b = 0.20; }  // Apollo
    else                  { r = 0.31; g = 0.50; b = 0.80; }  // Amor (dimmed — 2D drew it at lower alpha)
    _mpcColors[k*3] = r; _mpcColors[k*3+1] = g; _mpcColors[k*3+2] = b;
  }
  _renderer.setMPC(_mpcPositions, _mpcColors, N);
}

function updateMPCFrame() {
  if (!state.showMPC || !_mpcLoaded || !_mpcPositions) return false;
  const currentJD = _SIM_EPOCH_JD + state.simTime;

  // Reset per-frame visibility list (used for spatial hash + hit test)
  _mpcVisible = [];

  for (var mi = 0; mi < _mpcAsteroids.length; mi++) {
    const ast = _mpcAsteroids[mi];
    const pos = getMPCPosition(ast, currentJD);
    const i3  = mi * 3;

    // Promoted/focused asteroid is rendered as its own mesh — park its point
    if (_promoAstRef && ast === _promoAstRef) {
      _mpcPositions[i3] = 1e6; _mpcPositions[i3+1] = 1e6; _mpcPositions[i3+2] = 1e6;
    } else {
      _mpcPositions[i3] = pos.x; _mpcPositions[i3+1] = pos.y; _mpcPositions[i3+2] = pos.z;
    }

    // Viewport culling now only matters for hit detection — GPU clips the
    // rest (ws() null = behind the camera)
    const s = ws(pos.x, pos.y, pos.z);
    if (!s || s.x < -4 || s.x > W + 4 || s.y < -4 || s.y > H + 4) continue;

    _mpcVisible.push({ ast, sx: s.x, sy: s.y });
  }

  // Rebuild spatial hash from this frame's visible set
  _buildGrid();
  return true;
}

// Start loading MPC data (non-blocking)
if (state.showMPC) loadMPCAsteroids();

// ─── Promoted object (Layer 3) ────────────────────────────────────────────────
// Rendered by ThreeJSRenderer: procedural mesh + RK4 trajectory + MC cloud.
// Per-frame position/Earth-distance data is packed into _frame.promoted in tick().

// ─── MPC Dossier panel — static rendering helpers ────────────────────────────

function _fmt(v, digits, unit) {
  if (v == null || !isFinite(v)) return '—';
  return v.toFixed(digits) + (unit ? ' <small>' + unit + '</small>' : '');
}
function _fmtSci(v) {
  if (v == null || !isFinite(v)) return '—';
  const e = Math.floor(Math.log10(Math.abs(v)));
  const m = (v / Math.pow(10, e)).toFixed(2);
  return m + ' × 10<sup>' + e + '</sup>';
}
function _setText(id, html) {
  const el = document.getElementById(id);
  if (el) el.innerHTML = html;
}

function _renderDossierStatic(data) {
  const ast = data.elements || {};
  const d   = data.derived  || {};
  const jpl = data.jpl      || {};

  // Header
  _setText('dos-name', data.name || data.designation || '—');
  _setText('dos-desig', data.designation || '—');

  const typeEl = document.getElementById('dos-type');
  if (typeEl && d.type) {
    typeEl.textContent = d.type;
    typeEl.className = 'dos-type-badge dos-type-' + d.type;
  }
  const phaEl = document.getElementById('dos-pha');
  if (phaEl) phaEl.style.display = d.isPHA ? '' : 'none';

  // Orbital elements
  _setText('dos-a',      ast.a  != null ? ast.a.toFixed(4)  + ' <small>AU</small>' : '—');
  _setText('dos-e',      ast.e  != null ? ast.e.toFixed(6)  : '—');
  _setText('dos-i',      ast.i  != null ? ast.i.toFixed(3)  + ' <small>°</small>'  : '—');
  _setText('dos-angles', (ast.node != null ? ast.node.toFixed(2) : '—') + ' · ' + (ast.w != null ? ast.w.toFixed(2) : '—'));
  _setText('dos-M',      ast.M  != null ? ast.M.toFixed(3)  + ' <small>°</small>'  : '—');
  _setText('dos-H',      ast.H  != null ? ast.H.toFixed(1)  : '—');

  // Derived geometry
  _setText('dos-q',      d.q_AU    != null ? d.q_AU.toFixed(4)    + ' <small>AU</small>' : '—');
  _setText('dos-Q',      d.Q_AU    != null ? d.Q_AU.toFixed(4)    + ' <small>AU</small>' : '—');
  _setText('dos-P',      d.P_yr    != null ? d.P_yr.toFixed(3)    + ' <small>yr</small>' + (d.P_days != null ? ' (' + d.P_days.toFixed(0) + ' d)' : '') : '—');
  _setText('dos-n',      d.n_deg   != null ? d.n_deg.toFixed(4)   + ' <small>°/d</small>' : '—');
  _setText('dos-vperi',  d.v_peri_kms != null ? d.v_peri_kms.toFixed(2) + ' <small>km/s</small>' : '—');

  const moidAU = d.MOID_AU;
  let moidStr = '—';
  if (moidAU != null && isFinite(moidAU)) {
    const moidLD = (moidAU / 0.00257).toFixed(2);
    const moidClass = moidAU <= 0.05 ? 'color:var(--amber)' : '';
    moidStr = '<span style="' + moidClass + '">' + moidAU.toFixed(5) + ' <small>AU</small></span> · ' + moidLD + ' <small>LD</small>';
  }
  _setText('dos-moid', moidStr);

  const tj = d.tisserand;
  _setText('dos-tj', tj != null ? tj.toFixed(3) : '—');
  _setText('dos-tj-note', tj != null ? (tj < 3 ? '← cometary origin?' : tj > 3.5 ? '← typical asteroid' : '← near boundary') : '');

  // Physical estimates
  let diamStr = '—';
  if (d.diam_mid_km != null) {
    diamStr = d.diam_mid_km.toFixed(3) + ' <small>km mid</small> '
            + '(' + d.diam_dark_km.toFixed(3) + '–' + d.diam_bright_km.toFixed(3) + ' <small>km range</small>)';
  }
  _setText('dos-diam', diamStr);

  _setText('dos-mass', d.mass_kg != null ? _fmtSci(d.mass_kg) + ' <small>kg</small>' : '—');
  _setText('dos-vesc', d.v_escape_ms != null ? (d.v_escape_ms < 1 ? (d.v_escape_ms * 100).toFixed(1) + ' <small>cm/s</small>' : d.v_escape_ms.toFixed(2) + ' <small>m/s</small>') : '—');

  // Impact energy
  if (d.impact_Mt != null) {
    let impStr, impCmp;
    if (d.impact_Mt < 0.001) {
      impStr = (d.impact_Mt * 1000).toFixed(3) + ' <small>kt TNT</small>';
    } else if (d.impact_Mt < 1000) {
      impStr = d.impact_Mt.toFixed(2) + ' <small>Mt TNT</small>';
    } else {
      impStr = (d.impact_Mt / 1000).toFixed(1) + ' <small>Gt TNT</small>';
    }
    const hiro = d.impact_vs_hiroshima;
    const tung = d.impact_vs_tunguska;
    if (hiro < 0.1) impCmp = '< 0.1× Hiroshima';
    else if (hiro < 1) impCmp = (hiro * 1000).toFixed(0) + '× Hiroshima bomb';
    else if (hiro < 100) impCmp = hiro.toFixed(1) + '× Hiroshima';
    else if (tung < 2) impCmp = (d.impact_Mt / 12).toFixed(2) + '× Tunguska';
    else impCmp = (d.impact_Mt / 12).toFixed(0) + '× Tunguska';
    _setText('dos-impact', impStr);
    _setText('dos-impact-cmp', impCmp);
  } else {
    _setText('dos-impact', '—'); _setText('dos-impact-cmp', '—');
  }

  // JPL discovery & physical data
  const na = '<span style="color:var(--ink-4);">n/a</span>';
  _setText('dos-disc-date', jpl.discovery_date || na);
  _setText('dos-disc-who',  jpl.discoverer     || na);
  _setText('dos-albedo',    jpl.albedo != null  ? jpl.albedo.toFixed(3) : na);
  _setText('dos-rot',       jpl.rotation_h != null ? jpl.rotation_h.toFixed(2) + ' <small>h</small>' : na);
  _setText('dos-spec',      jpl.spectral_class  || na);
  _setText('dos-arc',       jpl.arc_years       || na);

  const jplBtn = document.getElementById('dos-jpl-btn');
  if (jplBtn && jpl.jpl_url) jplBtn.href = jpl.jpl_url;
}

function _renderDossierTrajectory(result) {
  const ca = result.closeApproach || {};
  const unc = result.uncertainty  || {};

  // Show content, hide spinner and idle
  document.getElementById('dos-ca-spinner').style.display = 'none';
  document.getElementById('dos-ca-idle').style.display = 'none';
  document.getElementById('dos-ca-error').style.display = 'none';
  document.getElementById('dos-ca-content').style.display = '';

  // Distance
  let distStr = '—', subStr = '—';
  if (ca.dist_AU != null) {
    if (ca.dist_AU < 0.00257) {
      distStr = (ca.dist_AU / 0.00257 * 384400).toFixed(0) + ' <small>km</small>';
    } else {
      distStr = (ca.dist_AU / 0.00257).toFixed(3) + ' <small>LD</small>';
    }
    subStr = (ca.date || '—') + ' · ' +
             ca.dist_AU.toFixed(5) + ' AU · ' +
             (ca.rel_vel_kms != null ? 'Δv ' + ca.rel_vel_kms.toFixed(2) + ' km/s' : '—');
  }
  _setText('dos-ca-dist', distStr);
  _setText('dos-ca-sub',  subStr);

  // Monte Carlo 3σ
  const sig = unc.sigma3_AU;
  _setText('dos-sigma', sig != null ? sig.toExponential(3) + ' AU (' + (sig/0.00257).toFixed(4) + ' LD)' : '—');

  // Hand the RK4 trajectory + Monte Carlo cloud to the renderer as flat arrays
  _promotedResult = result;
  _renderer.setPromotedTrajectory(
    result.trajectory || [],
    (result.uncertainty && result.uncertainty.caPositions) || []
  );
}

// ─── Open / close dossier ─────────────────────────────────────────────────────

async function openMPCDossier(entry) {
  const ast = entry.ast || entry;
  _promotedAst    = ast;
  _promotedResult = null;
  _hoverMPC       = null;

  // 3D mesh in the MAIN scene — NASA shape model when the designation has
  // one, procedural otherwise, plus its 3D orbit line. promote() fires
  // onModelApplied when a real GLB lands and the #repr-notice text upgrades
  // from "artistic" to the mission credit.
  _syncAsteroidMesh();
  _refreshReprNotice();

  const dossier = document.getElementById('mpc-dossier');
  dossier.classList.add('open');

  // Reset CA section to loading state
  document.getElementById('dos-ca-idle').style.display = '';
  document.getElementById('dos-ca-spinner').style.display = 'none';
  document.getElementById('dos-ca-content').style.display = 'none';
  document.getElementById('dos-ca-error').style.display = 'none';

  // Update HUD
  const hudLine = document.getElementById('hud-promoted-line');
  const hudName = document.getElementById('hud-promoted-name');
  if (hudLine) hudLine.style.display = '';
  if (hudName) hudName.textContent = ast.name || ast.designation;

  const desig = encodeURIComponent(ast.designation);

  // ── Fetch static dossier data ──────────────────────────────────────────
  try {
    const resp = await fetch('/api/asteroid/' + desig);
    if (resp.ok) {
      const data = await resp.json();
      _renderDossierStatic(data);
    }
  } catch (e) {
    console.warn('[Dossier] static fetch error:', e.message);
  }

  // ── Fetch RK4 trajectory ───────────────────────────────────────────────
  document.getElementById('dos-ca-idle').style.display = 'none';
  document.getElementById('dos-ca-spinner').style.display = '';

  try {
    const currentJD = _SIM_EPOCH_JD + state.simTime;
    const resp = await fetch('/api/asteroid/' + desig + '/trajectory?jd=' + currentJD.toFixed(4));
    if (resp.ok) {
      const result = await resp.json();
      _renderDossierTrajectory(result);
    } else {
      const err = await resp.json().catch(() => ({ error: 'Server error' }));
      document.getElementById('dos-ca-spinner').style.display = 'none';
      _setText('dos-ca-error', 'Error: ' + (err.error || resp.statusText));
      document.getElementById('dos-ca-error').style.display = '';
    }
  } catch (e) {
    document.getElementById('dos-ca-spinner').style.display = 'none';
    _setText('dos-ca-error', 'Network error: ' + e.message);
    document.getElementById('dos-ca-error').style.display = '';
  }
}

function closeMPCDossier() {
  _promotedAst    = null;
  _promotedResult = null;
  _syncAsteroidMesh();  // demotes (with dispose) unless the focus still owns the mesh
  _refreshReprNotice();
  document.getElementById('mpc-dossier').classList.remove('open');
  const hudLine = document.getElementById('hud-promoted-line');
  if (hudLine) hudLine.style.display = 'none';
}

document.getElementById('dos-close').addEventListener('click', closeMPCDossier);

// ─── Three.js renderer bootstrap ─────────────────────────────────────────────
// Orbit polylines are precomputed HERE (the Kepler solver stays page-side —
// src/renderer/ receives flat vertex arrays only, never solves anything).
function buildOrbitPts(o, segments) {
  const pts = new Float32Array(segments * 3);
  // Same rotation as orbitPos(): full 3D (ω, i, Ω) when the object has an
  // inclination — orbit polylines become real 3D loops out of the ecliptic
  const D2R = Math.PI/180;
  const hasI = !!o.i;
  const W = (o.w||0)*D2R, N = (o.om||0)*D2R, I = (o.i||0)*D2R;
  const cN = Math.cos(N), sN = Math.sin(N), cW = Math.cos(W), sW = Math.sin(W);
  const cI = Math.cos(I), sI = Math.sin(I);
  const ang = ((o.w||0)+(o.om||0))*D2R, ca = Math.cos(ang), sa = Math.sin(ang);
  for (let k = 0; k < segments; k++) {
    const M = (k/segments)*2*Math.PI + (o.phase||0);
    const E = solveKepler(M, o.e);
    const x = o.a*(Math.cos(E)-o.e), y = o.a*Math.sqrt(1-o.e*o.e)*Math.sin(E);
    if (hasI) {
      pts[k*3]   = (cN*cW - sN*sW*cI)*x + (-cN*sW - sN*cW*cI)*y;
      pts[k*3+1] = (sN*cW + cN*sW*cI)*x + (-sN*sW + cN*cW*cI)*y;
      pts[k*3+2] = (sW*sI)*x + (cW*sI)*y;
    } else {
      pts[k*3]   = x*ca - y*sa;
      pts[k*3+1] = x*sa + y*ca;
    }
  }
  return pts;
}

const _container = document.querySelector('.canvas-area');
const _renderer  = new ThreeJSRenderer(_container, {
  planets: PLANETS.map(p => ({ key:p.key, name:p.name, color:p.color, r:p.r, glow:!!p.glow, ring:!!p.ring, orbitPts: buildOrbitPts(p, 200) })),
  neos:    NEOS.map(n => ({ id:n.id, name:n.name, risk:n.risk, orbitPts: buildOrbitPts(n, 200) })),
  textureBase: '/assets/textures/',
});
// Same #radar-canvas node as before — every mouse/touch listener stays valid
const cv = _renderer.domElement;
let W=0, H=0, DPR=1;
function resize() {
  const r=_container.getBoundingClientRect();
  W=r.width; H=r.height; DPR=Math.max(1,window.devicePixelRatio||1);
  _renderer.resize();
}
resize(); window.addEventListener('resize', resize);
// The mobile canvas also resizes WITHOUT a window resize (45vh squeeze while
// the bottom sheet is open) — observe the container itself
if (typeof ResizeObserver !== 'undefined') {
  new ResizeObserver(function () { resize(); }).observe(_container);
}

// ─── World → screen through the renderer's view-projection matrix ────────────
// _vp is the SAME Float32Array the renderer refreshes every render() — no
// copies, no callbacks. Returns null when the point is behind the camera:
// every call site must tolerate that.
const _vp = _renderer.getVPMatrix();
const FOV_RAD = 45 * Math.PI / 180;
function ws(x, y, z) {
  z = z || 0;
  const e = _vp;                       // column-major (Three.js convention)
  const cw = e[3]*x + e[7]*y + e[11]*z + e[15];
  if (cw <= 0) return null;            // behind the camera
  const cx = (e[0]*x + e[4]*y + e[8]*z  + e[12]) / cw;
  const cy = (e[1]*x + e[5]*y + e[9]*z  + e[13]) / cw;
  return { x: (cx + 1) * 0.5 * W, y: (1 - cy) * 0.5 * H, w: cw };
}
// CSS px per AU measured at the camera-target plane (perspective: varies with dist)
function pxPerAU() {
  return H / (2 * state.cam.dist * Math.tan(FOV_RAD / 2));
}

function isActiveConjunctionPlanet(key, t) {
  if (!ALIGNMENTS || !ALIGNMENTS.length) return false;
  const nameToKey = { Earth:'earth', Jupiter:'jupiter', Saturn:'saturn', Uranus:'uranus', Neptune:'neptune' };
  return ALIGNMENTS.some(al =>
    Math.abs(t - al.simDay) <= 3 &&
    al.bodies.some(name => (nameToKey[name] || name.toLowerCase()) === key)
  );
}

// Active conjunctions in WORLD coordinates — the renderer projects and draws
function computeActiveConjunctions(t) {
  if (!ALIGNMENTS || !ALIGNMENTS.length) return [];
  const nameToKey = { Earth:'earth', Jupiter:'jupiter', Saturn:'saturn', Uranus:'uranus', Neptune:'neptune' };
  const keyToPlanet = {};
  for (const p of PLANETS) keyToPlanet[p.key] = p;
  const out = [];
  for (const al of ALIGNMENTS) {
    if (Math.abs(t - al.simDay) > 3) continue;
    const pts = al.bodies.map(name => {
      const planet = keyToPlanet[nameToKey[name] || name.toLowerCase()];
      return planet ? orbitPos(planet, t) : null;
    }).filter(Boolean);
    if (pts.length >= 2) out.push({ pts });
  }
  return out;
}

// Uncertainty ribbon in WORLD coordinates — fixed-size stride-3 arrays so the
// renderer can update one BufferGeometry with zero allocation. Sampled through
// orbitPos() so the ribbon carries the same real z as the NEO it belongs to.
const _CONE_N = 101;
const _coneUpper = new Float32Array(_CONE_N * 3);
const _coneLower = new Float32Array(_CONE_N * 3);
function computeUncertaintyCone(o, t) {
  const pts=[];
  for(let k=0;k<_CONE_N;k++){
    const tt=t+(k-50)*8;
    const p=orbitPos(o,tt);
    const jup=orbitPos(PLANETS[4],tt);
    const dJ=Math.hypot(p.x-jup.x,p.y-jup.y);
    pts.push({x:p.x,y:p.y,z:p.z,w:0.005+0.05/(dJ*dJ+0.4)});
  }
  for(let k=0;k<pts.length;k++){
    const p=pts[k],next=pts[Math.min(k+1,pts.length-1)];
    const dx=next.x-p.x,dy=next.y-p.y,len=Math.hypot(dx,dy)||1e-9;
    const nx=-dy/len,ny=dx/len;                      // in-plane normal
    _coneUpper[k*3]=p.x+nx*p.w;_coneUpper[k*3+1]=p.y+ny*p.w;_coneUpper[k*3+2]=p.z;
    _coneLower[k*3]=p.x-nx*p.w;_coneLower[k*3+1]=p.y-ny*p.w;_coneLower[k*3+2]=p.z;
  }
}

// Jupiter Δv vector endpoints in WORLD coordinates
function computeJupiterVector(t, f) {
  f.active = false;
  if (!state.jupiter) return;
  const sel = NEOS.find(n => n.id === state.selectedId); if (!sel) return;
  const ap = orbitPos(sel, t), jp = orbitPos(PLANETS[4], t);
  const dx = jp.x - ap.x, dy = jp.y - ap.y, dz = (jp.z||0) - (ap.z||0);
  const d = Math.hypot(dx, dy);
  if (d > 6) return;
  f.active = true;
  f.ax = ap.x; f.ay = ap.y; f.az = ap.z||0;
  f.bx = ap.x + dx*0.06; f.by = ap.y + dy*0.06; f.bz = (ap.z||0) + dz*0.06;
}

const _J2000_RAF = Date.UTC(2000, 0, 1, 12, 0, 0);
const _T_SIM_RAF = _J2000_RAF + 9643 * 86400000; // sim epoch = 2026-05-27

// Per-frame flat data handed to the renderer (preallocated — no GC churn)
const _frame = {
  cam: { tx:0, ty:0, tz:0, dist:7, theta:0, phi:1.20 },
  planets: PLANETS.map(() => ({ x:0, y:0, visible:false, conj:false })),
  neos:    NEOS.map(() => ({ x:0, y:0, z:0 })),
  selIdx: -1, hovIdx: -1,
  cone: { active:false, risky:false, count:_CONE_N, upper:_coneUpper, lower:_coneLower },
  jup:  { active:false, ax:0, ay:0, az:0, bx:0, by:0, bz:0 },
  conjs: [],
  mpcDirty: false,
  hoverMPC: null,
  luna: { x:0, y:0, z:0, visible:false },
  promoted: { active:false, x:0, y:0, z:0, ex:0, ey:0, distLD:'', radius:0 },
};

let last=performance.now();
function tick(now) {
  const dt=Math.min(0.1,(now-last)/1000); last=now;
  if (state.playing) {
    // Simulate mode: advance time by wall-clock dt × simulation speed
    state.simTime += dt * state.daysPerSec * state.speed;
  } else {
    // Live mode: pin to real time every frame — zero drift, zero accumulation error
    state.simTime = (Date.now() - _T_SIM_RAF) / 86400000;
  }
  const t = state.simTime;

  for (let i=0;i<PLANETS.length;i++) {
    const p=PLANETS[i], f=_frame.planets[i];
    f.visible = state.showPlanets && !!state.planetToggles[p.key];
    if (f.visible) {
      const pos=orbitPos(p,t);
      f.x=pos.x; f.y=pos.y;
      f.conj=isActiveConjunctionPlanet(p.key,t);
    }
  }

  // Moon: heliocentric = Earth + geocentric circle (visual only, no physics)
  {
    const ef=_frame.planets[2], lf=_frame.luna;
    lf.visible = ef.visible;
    if (ef.visible) { const mp=moonPos(t); lf.x=ef.x+mp.x; lf.y=ef.y+mp.y; lf.z=mp.z; }
  }

  _frame.selIdx=-1; _frame.hovIdx=-1;
  for (let i=0;i<NEOS.length;i++) {
    const n=NEOS[i], pos=orbitPos(n,t), f=_frame.neos[i];
    f.x=pos.x; f.y=pos.y; f.z=pos.z;
    if (n.id===state.selectedId) _frame.selIdx=i;
    if (n.id===state.hoverId)    _frame.hovIdx=i;
  }

  _frame.cone.active = false;
  if (state.uncertainty && _frame.selIdx>=0) {
    const n=NEOS[_frame.selIdx];
    computeUncertaintyCone(n,t);
    _frame.cone.active = true;
    _frame.cone.risky  = (n.risk==='caution'||n.risk==='hazard');
  }

  computeJupiterVector(t, _frame.jup);
  _frame.conjs = computeActiveConjunctions(t);
  _frame.mpcDirty = updateMPCFrame();
  _frame.hoverMPC = _hoverMPC;

  // ── Promoted/focused asteroid mesh: position + physical radius ──
  {
    const pr=_frame.promoted;
    const tg=state.focusTarget;
    let sx=0, sy=0, sz=0, srcRadius=0, have=false;
    if (tg && tg.type==='neo') {
      const f=_frame.neos[tg.idx];
      sx=f.x; sy=f.y; sz=f.z; srcRadius=_focusRadiusAU; have=true;
    } else if (tg && tg.type==='mpc') {
      const pos=getMPCPosition(tg.ast,_SIM_EPOCH_JD+t);
      sx=pos.x; sy=pos.y; sz=pos.z; srcRadius=_astRadiusAU(tg.ast); have=true;
    } else if (_promotedAst) {
      const pos=getMPCPosition(_promotedAst,_SIM_EPOCH_JD+t);
      sx=pos.x; sy=pos.y; sz=pos.z; srcRadius=_astRadiusAU(_promotedAst); have=true;
    }
    if (have && _promoKey) {
      const ep=orbitPos(PLANETS[2],t);
      pr.active=true; pr.x=sx; pr.y=sy; pr.z=sz; pr.ex=ep.x; pr.ey=ep.y;
      pr.radius=srcRadius;
      pr.distLD=(Math.hypot(sx-ep.x,sy-ep.y,sz)/0.00257).toFixed(2);
    } else {
      pr.active=false;
    }
  }

  // ── Camera: drag inertia decay (the Eyes "feel") ──
  if (!_dragMode && (_camVTheta !== 0 || _camVPhi !== 0)) {
    state.cam.theta += _camVTheta;
    state.cam.phi = Math.min(1.48, Math.max(-1.48, state.cam.phi + _camVPhi));
    _camVTheta *= 0.90; _camVPhi *= 0.90;
    if (Math.abs(_camVTheta) < 1e-5) _camVTheta = 0;
    if (Math.abs(_camVPhi) < 1e-5) _camVPhi = 0;
  }

  // ── Focus mode: cinematic dolly + follow, all on the main camera ──
  if (state.focusTarget) {
    const tg = state.focusTarget;
    const tp = _focusTargetPos(t);

    // Focused planet/Moon may have its toggle off — force its frame slot on
    if (tg.type === 'planet' || tg.type === 'luna') {
      const idx = tg.type === 'planet' ? tg.idx : 2;
      const pf = _frame.planets[idx];
      if (!pf.visible) {
        const pp = orbitPos(PLANETS[idx], t);
        pf.x = pp.x; pf.y = pp.y; pf.visible = true; pf.conj = false;
      }
      if (tg.type === 'luna' && !_frame.luna.visible) {
        const mp = moonPos(t);
        _frame.luna.x = pf.x + mp.x; _frame.luna.y = pf.y + mp.y;
        _frame.luna.z = mp.z; _frame.luna.visible = true;
      }
    }

    if (_exitAnim) {
      // Exit: glide back to the camera saved on entry (~1.0 s, same curve)
      _exitAnim.t = Math.min(1, _exitAnim.t + dt / 1.0);
      const e2 = _easeInOutCubic(_exitAnim.t);
      const A = _exitAnim.from, B = state._camBeforeFocus;
      state.cam.tx = A.tx + (B.tx - A.tx) * e2;
      state.cam.ty = A.ty + (B.ty - A.ty) * e2;
      state.cam.tz = A.tz + (B.tz - A.tz) * e2;
      state.cam.dist = Math.exp(Math.log(A.dist) + (Math.log(B.dist) - Math.log(A.dist)) * e2);
      state.cam.theta = A.theta + (B.theta - A.theta) * e2;
      state.cam.phi = A.phi + (B.phi - A.phi) * e2;
      if (_exitAnim.t >= 1) _finishExitFocus();
    } else if (!_focusFollow) {
      // Entry: ~1.4 s dolly. The target lerps against the object's CURRENT
      // position every frame (it keeps moving on its orbit), and dist lerps
      // in log space — the only dolly that reads smooth across astronomical
      // scales. theta/phi stay untouched: the user never loses orientation.
      state.focusLerp = Math.min(1, state.focusLerp + dt / 1.4);
      const eF = _easeInOutCubic(state.focusLerp);
      const S = _focusStartCam;
      state.cam.tx = S.tx + (tp.x - S.tx) * eF;
      state.cam.ty = S.ty + (tp.y - S.ty) * eF;
      state.cam.tz = S.tz + ((tp.z || 0) - S.tz) * eF;
      state.cam.dist = Math.exp(Math.log(S.dist) + (Math.log(_focusDistTarget) - Math.log(S.dist)) * eF);
      if (state.focusLerp >= 1) _focusFollow = true;
      updateFocusHud(tp, t);
    } else {
      // Follow: target glued to the moving object; the user orbits/dollies
      // around it freely (dolly floor = just above the surface)
      state.cam.tx = tp.x; state.cam.ty = tp.y; state.cam.tz = tp.z || 0;
      state.cam.dist = Math.max(_focusMinDist, state.cam.dist);
      // Auto-rotate (Eyes signature): slow orbit after 5 s without input
      if (now - _lastInteractT > 5000) state.cam.theta += 0.0006;
      updateFocusHud(tp, t);
    }
  }

  // Camera → frame: flat copy of the 6 numbers (the renderer never decides
  // camera state on its own)
  _frame.cam.tx = state.cam.tx; _frame.cam.ty = state.cam.ty; _frame.cam.tz = state.cam.tz;
  _frame.cam.dist = state.cam.dist; _frame.cam.theta = state.cam.theta; _frame.cam.phi = state.cam.phi;

  _renderer.render(state, _frame);
  updateScaleBar();
  updateClock();
  requestAnimationFrame(tick);
}
requestAnimationFrame(tick);

// Display timezone — physics always runs in UTC/J2000 internally
var _selectedTz = (function () {
  try {
    var known = ['UTC','America/Sao_Paulo','America/New_York','America/Los_Angeles',
                 'Europe/London','Europe/Paris','Asia/Tokyo','Asia/Shanghai','Australia/Sydney'];
    var btz = Intl.DateTimeFormat().resolvedOptions().timeZone;
    return known.includes(btz) ? btz : 'UTC';
  } catch (e) { return 'UTC'; }
}());

function updateClock() {
  var epoch = new Date(Date.UTC(2026, 4, 27, 12, 0, 0));
  var d     = new Date(epoch.getTime() + state.simTime * 86400000);
  var fmt   = new Intl.DateTimeFormat('en-CA', {
    timeZone: _selectedTz,
    year: 'numeric', month: '2-digit', day: '2-digit',
    hour: '2-digit', minute: '2-digit', hour12: false,
  });
  var p = Object.fromEntries(fmt.formatToParts(d).map(function (x) { return [x.type, x.value]; }));
  var tzLabel = _selectedTz === 'UTC' ? 'UTC' : _selectedTz.split('/').pop().replace(/_/g, ' ');
  document.getElementById('sim-clock-val').textContent =
    p.year + '·' + p.month + '·' + p.day + ' ' + p.hour + ':' + p.minute + ' ' + tzLabel;
}
function updateScaleBar() {
  // Perspective: px-per-AU is only meaningful at one depth — we measure it at
  // the camera-target plane, so the bar stays honest as the dolly moves
  const ROUND = [1e-5,2e-5,5e-5,1e-4,2e-4,5e-4,0.001,0.002,0.005,0.01,0.02,0.05,0.1,0.2,0.5,1,2,5,10,20,50,100];
  const scale = pxPerAU();
  let chosen = ROUND[0];
  for (const v of ROUND) {
    chosen = v;
    if (v * scale >= 80) break;
  }
  const barPx = Math.round(chosen * scale);
  const label = chosen >= 0.01 ? chosen + ' AU'
    : Math.round(chosen * 1.496e8).toLocaleString('en-US') + ' km';
  const line = document.getElementById('dyn-scale-line');
  const lbl  = document.getElementById('dyn-scale-label');
  if (line) line.style.width = barPx + 'px';
  if (lbl)  lbl.textContent  = label;
  const sv = document.getElementById('scale-val');
  if (sv) sv.textContent = scale >= 1
    ? '1 AU = ' + scale.toFixed(0) + ' px'
    : '1 AU = ' + scale.toFixed(2) + ' px';
}

// Vis-viva orbital speed: v = sqrt(GM*(2/r - 1/a)) in km/s
function visVivaKms(a, r) {
  const GM = 4*Math.PI*Math.PI; // AU³/yr²
  const v_AU_per_yr = Math.sqrt(GM * (2/r - 1/a));
  return +(v_AU_per_yr * 4.74057).toFixed(1); // 1 AU/yr = 4.74057 km/s (Earth: 2π AU/yr ≈ 29.8)
}

function renderList() {
  const q=state.search.toLowerCase().trim();
  const filtered=NEOS.filter(n=>{
    if(state.filter!=='all'&&n.risk!==state.filter)return false;
    if(q&&!(n.name.toLowerCase().includes(q)||n.desig.toLowerCase().includes(q)))return false;
    return true;
  }).sort((a,b)=>a.nextLD-b.nextLD);
  document.getElementById('result-count').textContent=`${filtered.length} result${filtered.length===1?'':'s'}`;
  document.getElementById('neo-list').innerHTML=filtered.map(n=>`
    <div class="neo-item r-${n.risk}${state.selectedId===n.id?' selected':''}" data-id="${n.id}">
      <div class="name"><span class="risk-dot"></span>${n.name}</div>
      <div class="desig">${n.desig}</div>
      <div class="ld">${n.nextLD<1?n.nextLD.toFixed(2):n.nextLD.toFixed(1)}<small>LUNAR DIST</small></div>
    </div>`).join('');
  document.querySelectorAll('.neo-item').forEach(el=>el.addEventListener('click',()=>{state.selectedId=el.dataset.id;renderList();renderSelected();}));
}
function renderSelected() {
  const n=NEOS.find(x=>x.id===state.selectedId); if(!n)return;
  document.getElementById('sel-name').textContent=n.name;
  document.getElementById('sel-desig').textContent=`${n.desig} · NEA`;
  const re=document.getElementById('sel-risk'); re.className=`risk ${n.risk}`; re.textContent=n.label;
  document.getElementById('sel-figure').innerHTML=`${n.nextKm}<small>km</small>`;
