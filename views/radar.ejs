  @media (min-width: 769px) {
    .fab-live { display: none; }
  }

  /* ── Timezone custom dropdown ───────────────────────────────── */
  @keyframes fadeInDown {
    from { opacity: 0; transform: translateY(-4px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  .tz-wrap {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 3px;
    flex-shrink: 0;
    position: relative;
  }
  .tz-lbl {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-4);
  }
  .tz-dropdown { position: relative; }
  .tz-trigger {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: transparent;
    border: 1px solid var(--line);
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    padding: 4px 10px;
    border-radius: var(--r-sm);
    cursor: pointer;
    transition: border-color 0.15s, color 0.15s;
    white-space: nowrap;
    outline: none;
  }
  .tz-trigger:hover { border-color: var(--line-strong); color: var(--ink-2); }
  .tz-menu {
    display: none;
    position: absolute;
    top: calc(100% + 4px);
    right: 0;
    min-width: 160px;
    background: var(--bg-2);
    border: 1px solid var(--line-strong);
    border-radius: var(--r-md);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    padding: 4px;
    z-index: 300;
    box-shadow: 0 8px 32px rgba(0,0,0,0.4);
    margin: 0;
    list-style: none;
  }
  .tz-menu.open {
    display: block;
    animation: fadeInDown 0.15s ease;
  }
  .tz-menu li {
    padding: 7px 12px;
    border-radius: var(--r-sm);
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    cursor: pointer;
    list-style: none;
    transition: background 0.1s, color 0.1s;
    white-space: nowrap;
  }
  .tz-menu li:hover { background: rgba(255,255,255,0.05); color: var(--ink); }
  .tz-menu li.active { color: var(--cobalt-soft); background: rgba(26,108,246,0.08); }
  /* Hide topbar TZ wrap on mobile (lives in sidebar there) */
  @media (max-width: 767px) { .tz-wrap { display: none; } }

  /* ── Focus Mode HUD ─────────────────────────────────────────── */
  #focus-hud {
    position: absolute; top: 16px; left: 16px; z-index: 6;
    min-width: 232px; padding: 14px 16px;
    background: rgba(5,6,12,0.78);
    border: 1px solid var(--line-strong); border-radius: 10px;
    backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
    font-family: var(--font-mono);
    opacity: 0; transform: translateY(-6px);
    pointer-events: none;
    transition: opacity 300ms, transform 300ms;
  }
  #focus-hud.show { opacity: 1; transform: translateY(0); }
  #focus-hud .fh-title { font-size: 9px; letter-spacing: 0.22em; color: var(--cobalt-soft); }
  #focus-hud .fh-rule { height: 1px; background: var(--line); margin: 10px 0; }
  #focus-hud .fh-name { font-family: var(--font-display); font-size: 18px; font-weight: 500; letter-spacing: -0.01em; color: var(--ink); }
  #focus-hud .fh-desig { font-size: 9.5px; color: var(--ink-4); letter-spacing: 0.12em; margin-top: 3px; text-transform: uppercase; }
  #focus-hud .fh-kv { display: flex; justify-content: space-between; gap: 18px; font-size: 10.5px; margin: 4px 0; }
  #focus-hud .fh-kv .k { color: var(--ink-4); letter-spacing: 0.14em; }
  #focus-hud .fh-kv .v { color: var(--ink); font-variant-numeric: tabular-nums; }
  #focus-hud .fh-exit { font-size: 9.5px; letter-spacing: 0.16em; color: var(--ink-3); cursor: pointer; pointer-events: auto; transition: color 160ms; }
  #focus-hud .fh-exit:hover { color: var(--ink); }
  #focus-hud .fh-exit .kbd-esc { display: inline-block; padding: 1px 5px; border: 1px solid var(--line-strong); border-radius: 4px; margin-right: 6px; color: var(--ink-2); }
  /* Clean canvas while focused: hide chrome that only makes sense in map view */
  .canvas-area.focus-active .legend,
  .canvas-area.focus-active .scale-bar,
  .canvas-area.focus-active .corner-overlay { display: none; }
</style>

