  if (tg.type === 'planet') return REAL_RADIUS_AU[PLANETS[tg.idx].key] || 2e-5;
  if (tg.type === 'moon')   return MOONS_BY_ID[tg.id].r;
  if (tg.type === 'dwarf')  return DWARF_PLANETS[tg.idx].r;
  if (tg.type === 'comet')  return COMETS[tg.idx].r;
  if (tg.type === 'neo')    return 1.7e-9;       // catalog NEOs carry no H: ~500 m body, as in focus mode
