var _pilot = {
  active: false,
  bodies: null,                     // [{tg, name, r, x, y, z}], positions refreshed every frame
  anchor: null,                     // body the ship rides with, or null (heliocentric)
  rx: 0, ry: 0, rz: 0,              // position relative to the anchor (AU)
  x: 0, y: 0, z: 0,                 // heliocentric position (derived)
  q: null, cq: null,                // ship attitude, lagged camera attitude (THREE.Quaternion)
  yawRate: 0, pitchRate: 0, rollRate: 0,
  dragYaw: 0, dragPitch: 0,         // steering from mouse drags since the last frame (rad)
  visYaw: 0, visPitch: 0,           // smoothed turn rates for the hull's bank
  throttle: 0, limit: 1, speed: 0,
  target: null,                     // body object (from `bodies`, or a custom one for MPC asteroids)
