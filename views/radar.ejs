    const f=_frame.dwarfPlanets[i], pos=orbitPos(DWARF_ELEMS[i],t);
    f.x=pos.x; f.y=pos.y; f.z=pos.z||0; f.visible=true;
  }
  for (let i=0;i<COMET_ELEMS.length;i++) {
    const f=_frame.comets[i], pos=orbitPos(COMET_ELEMS[i],t);
    f.x=pos.x; f.y=pos.y; f.z=pos.z||0; f.visible=true;
    f.sunDist=Math.hypot(f.x,f.y,f.z);   // renderer: coma/tail below 3 AU
