  }
  // Not in the standing list (an MPC catalog asteroid): track it on its own
  var p = _bodyPos(tg, state.simTime);
  return { tg: tg, name: _bodyName(tg), r: _bodyRadiusAU(tg), x: p.x, y: p.y, z: p.z || 0, custom: true };
}
function _pilotRefreshBodies(t) {
  var B = _pilot.bodies;
  for (var i = 0; i < B.length; i++) {
    var p = _bodyPos(B[i].tg, t);
    B[i].x = p.x; B[i].y = p.y; B[i].z = p.z || 0;
