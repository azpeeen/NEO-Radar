  _setText('dos-albedo',    jpl.albedo != null  ? jpl.albedo.toFixed(3) : na);
  _setText('dos-rot',       jpl.rotation_h != null ? jpl.rotation_h.toFixed(2) + ' <small>h</small>' : na);
  _setText('dos-spec',      jpl.spectral_class  || na);
  _setText('dos-arc',       jpl.arc_years       || na);

  const jplBtn = document.getElementById('dos-jpl-btn');
  if (jplBtn && jpl.jpl_url) jplBtn.href = jpl.jpl_url;
}

function _renderDossierTrajectory(result) {
  const ca = result.closeApproach || {};
  const unc = result.uncertainty  || {};

  // Show content, hide spinner and idle
  document.getElementById('dos-ca-spinner').style.display = 'none';
  document.getElementById('dos-ca-idle').style.display = 'none';
  document.getElementById('dos-ca-error').style.display = 'none';
  document.getElementById('dos-ca-content').style.display = '';

  // Distance
  let distStr = '—', subStr = '—';
  if (ca.dist_AU != null) {
    if (ca.dist_AU < 0.00257) {
      distStr = (ca.dist_AU / 0.00257 * 384400).toFixed(0) + ' <small>km</small>';
    } else {
      distStr = (ca.dist_AU / 0.00257).toFixed(3) + ' <small>LD</small>';
    }
    subStr = (ca.date || '—') + ' · ' +
             ca.dist_AU.toFixed(5) + ' AU · ' +
             (ca.rel_vel_kms != null ? 'Δv ' + ca.rel_vel_kms.toFixed(2) + ' km/s' : '—');
  }
  _setText('dos-ca-dist', distStr);
  _setText('dos-ca-sub',  subStr);

  // Monte Carlo 3σ
  const sig = unc.sigma3_AU;
  _setText('dos-sigma', sig != null ? sig.toExponential(3) + ' AU (' + (sig/0.00257).toFixed(4) + ' LD)' : '—');

  // Hand the RK4 trajectory + Monte Carlo cloud to the renderer as flat arrays
  _promotedResult = result;
  _renderer.setPromotedTrajectory(
    result.trajectory || [],
    (result.uncertainty && result.uncertainty.caPositions) || []
  );
}

// ─── Open / close dossier ─────────────────────────────────────────────────────

async function openMPCDossier(entry) {
  const ast = entry.ast || entry;
  _promotedAst    = ast;
  _promotedResult = null;
  _hoverMPC       = null;

  // 3D mesh in the MAIN scene — NASA shape model when the designation has
  // one, procedural otherwise, plus its 3D orbit line. promote() fires
  // onModelApplied when a real GLB lands and the #repr-notice text upgrades
  // from "artistic" to the mission credit.
  _syncAsteroidMesh();
  _refreshReprNotice();

  const dossier = document.getElementById('mpc-dossier');
  dossier.classList.add('open');

  // Reset CA section to loading state
  document.getElementById('dos-ca-idle').style.display = '';
  document.getElementById('dos-ca-spinner').style.display = 'none';
  document.getElementById('dos-ca-content').style.display = 'none';
  document.getElementById('dos-ca-error').style.display = 'none';

  // Update HUD
  const hudLine = document.getElementById('hud-promoted-line');
  const hudName = document.getElementById('hud-promoted-name');
  if (hudLine) hudLine.style.display = '';
  if (hudName) hudName.textContent = ast.name || ast.designation;

  const desig = encodeURIComponent(ast.designation);

  // ── Fetch static dossier data ──────────────────────────────────────────
  try {
    const resp = await fetch('/api/asteroid/' + desig);
    if (resp.ok) {
      const data = await resp.json();
      _renderDossierStatic(data);
    }
  } catch (e) {
    console.warn('[Dossier] static fetch error:', e.message);
  }

  // ── Fetch RK4 trajectory ───────────────────────────────────────────────
  document.getElementById('dos-ca-idle').style.display = 'none';
  document.getElementById('dos-ca-spinner').style.display = '';

  try {
    const currentJD = _SIM_EPOCH_JD + state.simTime;
    const resp = await fetch('/api/asteroid/' + desig + '/trajectory?jd=' + currentJD.toFixed(4));
    if (resp.ok) {
      const result = await resp.json();
      _renderDossierTrajectory(result);
    } else {
      const err = await resp.json().catch(() => ({ error: 'Server error' }));
      document.getElementById('dos-ca-spinner').style.display = 'none';
      _setText('dos-ca-error', 'Error: ' + (err.error || resp.statusText));
      document.getElementById('dos-ca-error').style.display = '';
    }
  } catch (e) {
    document.getElementById('dos-ca-spinner').style.display = 'none';
    _setText('dos-ca-error', 'Network error: ' + e.message);
    document.getElementById('dos-ca-error').style.display = '';
  }
}

function closeMPCDossier() {
  _promotedAst    = null;
  _promotedResult = null;
  _syncAsteroidMesh();  // demotes (with dispose) unless the focus still owns the mesh
  _refreshReprNotice();
  document.getElementById('mpc-dossier').classList.remove('open');
  const hudLine = document.getElementById('hud-promoted-line');
  if (hudLine) hudLine.style.display = 'none';
}

document.getElementById('dos-close').addEventListener('click', closeMPCDossier);

// ─── Three.js renderer bootstrap ─────────────────────────────────────────────
// Orbit polylines are precomputed HERE (the Kepler solver stays page-side —
// src/renderer/ receives flat vertex arrays only, never solves anything).
function buildOrbitPts(o, segments) {
  const pts = new Float32Array(segments * 3);
  // Same rotation as orbitPos(): full 3D (ω, i, Ω) when the object has an
  // inclination — orbit polylines become real 3D loops out of the ecliptic
  const D2R = Math.PI/180;
  const hasI = !!o.i;
  const W = (o.w||0)*D2R, N = (o.om||0)*D2R, I = (o.i||0)*D2R;
  const cN = Math.cos(N), sN = Math.sin(N), cW = Math.cos(W), sW = Math.sin(W);
  const cI = Math.cos(I), sI = Math.sin(I);
  const ang = ((o.w||0)+(o.om||0))*D2R, ca = Math.cos(ang), sa = Math.sin(ang);
  for (let k = 0; k < segments; k++) {
    const M = (k/segments)*2*Math.PI + (o.phase||0);
    const E = solveKepler(M, o.e);
    const x = o.a*(Math.cos(E)-o.e), y = o.a*Math.sqrt(1-o.e*o.e)*Math.sin(E);
    if (hasI) {
      pts[k*3]   = (cN*cW - sN*sW*cI)*x + (-cN*sW - sN*cW*cI)*y;
      pts[k*3+1] = (sN*cW + cN*sW*cI)*x + (-sN*sW + cN*cW*cI)*y;
      pts[k*3+2] = (sW*sI)*x + (cW*sI)*y;
    } else {
      pts[k*3]   = x*ca - y*sa;
      pts[k*3+1] = x*sa + y*ca;
    }
  }
  return pts;
}

// ─── Dwarf planets + comets — shared tables from renderer3d.js ───────────────
// Elements carry M (deg) at the body's OWN epoch (d.epoch_jd, default J2000).
// orbitPos() wants { om, w, phase } with phase = mean anomaly at the SIM epoch
// (JD _SIM_EPOCH_JD) in radians — propagate M from its epoch once here.
// Mean motion uses a^1.5 (Kepler) = the SAME rate orbitPos propagates with, so
// each body lands exactly on its tabulated M at its own epoch: Halley (epoch
// 2061-08, M≈0°) rewinds ~169° to 2026 → aphelion, only nearing the Sun in 2061.
function _elemsFromEpoch(d) {
  const epoch = d.epoch_jd != null ? d.epoch_jd : 2451545.0;   // default J2000
  const n = 2 * Math.PI / (365.25 * Math.pow(d.a, 1.5));       // rad/day
  return {
    a: d.a, e: d.e, i: d.i, om: d.node, w: d.w,
    phase: d.M * Math.PI / 180 + n * (_SIM_EPOCH_JD - epoch),
  };
}
const DWARF_ELEMS = DWARF_PLANETS.map(_elemsFromEpoch);   // no epoch_jd → J2000, unchanged
const COMET_ELEMS = COMETS.map(_elemsFromEpoch);

const _container = document.querySelector('.canvas-area');
const _renderer  = new ThreeJSRenderer(_container, {
  planets: PLANETS.map(p => ({ key:p.key, name:p.name, color:p.color, r:p.r, glow:!!p.glow, ring:!!p.ring, orbitPts: buildOrbitPts(p, 200) })),
  neos:    NEOS.map(n => ({ id:n.id, name:n.name, risk:n.risk, orbitPts: buildOrbitPts(n, 200) })),
  // 512 segments for comets: uniform-M sampling starves the perihelion whip
  // of points on e≈0.97 orbits (Halley) — denser sampling keeps the loop smooth
  // Eccentric dwarfs get denser polylines for the same reason (Sedna e = 0.85)
  dwarfPlanets: DWARF_PLANETS.map((d, i) => ({ def: d, orbitPts: buildOrbitPts(DWARF_ELEMS[i], d.e > 0.6 ? 2048 : d.e > 0.3 ? 512 : 200) })),
  comets:       COMETS.map((c, i) => ({ def: c, orbitPts: buildOrbitPts(COMET_ELEMS[i], 512) })),
  textureBase: '/assets/textures/',
});
// Same #radar-canvas node as before — every mouse/touch listener stays valid
window._R3D = _renderer;   // debug/console handle (const doesn't reach window)
const cv = _renderer.domElement;
let W=0, H=0, DPR=1;
function resize() {
  const r=_container.getBoundingClientRect();
  W=r.width; H=r.height; DPR=Math.max(1,window.devicePixelRatio||1);
  _renderer.resize();
}
resize(); window.addEventListener('resize', resize);
// The mobile canvas also resizes WITHOUT a window resize (45vh squeeze while
// the bottom sheet is open) — observe the container itself
if (typeof ResizeObserver !== 'undefined') {
  new ResizeObserver(function () { resize(); }).observe(_container);
}

// ─── World → screen through the renderer's view-projection matrix ────────────
// _vp is the SAME Float32Array the renderer refreshes every render() — no
// copies, no callbacks. Returns null when the point is behind the camera:
// every call site must tolerate that.
const _vp = _renderer.getVPMatrix();
const FOV_RAD = 45 * Math.PI / 180;
// Farthest dolly-out. 260 AU keeps the scattered-disc dwarfs (Eris ~96 AU,
// Gonggong ~90, Sedna ~83) on screen; scene far plane is 500.
const CAM_MAX_DIST = 260;
function ws(x, y, z) {
  z = z || 0;
  const e = _vp;                       // column-major (Three.js convention)
  const cw = e[3]*x + e[7]*y + e[11]*z + e[15];
  if (cw <= 0) return null;            // behind the camera
  const cx = (e[0]*x + e[4]*y + e[8]*z  + e[12]) / cw;
  const cy = (e[1]*x + e[5]*y + e[9]*z  + e[13]) / cw;
  return { x: (cx + 1) * 0.5 * W, y: (1 - cy) * 0.5 * H, w: cw };
}
// CSS px per AU measured at the camera-target plane (perspective: varies with dist)
function pxPerAU() {
  return H / (2 * state.cam.dist * Math.tan(FOV_RAD / 2));
}

function isActiveConjunctionPlanet(key, t) {
  if (!ALIGNMENTS || !ALIGNMENTS.length) return false;
  const nameToKey = { Earth:'earth', Jupiter:'jupiter', Saturn:'saturn', Uranus:'uranus', Neptune:'neptune' };
  return ALIGNMENTS.some(al =>
    Math.abs(t - al.simDay) <= 3 &&
    al.bodies.some(name => (nameToKey[name] || name.toLowerCase()) === key)
  );
}

// Active conjunctions in WORLD coordinates — the renderer projects and draws
function computeActiveConjunctions(t) {
  if (!ALIGNMENTS || !ALIGNMENTS.length) return [];
  const nameToKey = { Earth:'earth', Jupiter:'jupiter', Saturn:'saturn', Uranus:'uranus', Neptune:'neptune' };
  const keyToPlanet = {};
  for (const p of PLANETS) keyToPlanet[p.key] = p;
  const out = [];
  for (const al of ALIGNMENTS) {
    if (Math.abs(t - al.simDay) > 3) continue;
    const pts = al.bodies.map(name => {
      const planet = keyToPlanet[nameToKey[name] || name.toLowerCase()];
      return planet ? orbitPos(planet, t) : null;
    }).filter(Boolean);
    if (pts.length >= 2) out.push({ pts });
  }
  return out;
}

// Uncertainty ribbon in WORLD coordinates — fixed-size stride-3 arrays so the
// renderer can update one BufferGeometry with zero allocation. Sampled through
// orbitPos() so the ribbon carries the same real z as the NEO it belongs to.
const _CONE_N = 101;
const _coneUpper = new Float32Array(_CONE_N * 3);
const _coneLower = new Float32Array(_CONE_N * 3);
function computeUncertaintyCone(o, t) {
  const pts=[];
  for(let k=0;k<_CONE_N;k++){
    const tt=t+(k-50)*8;
    const p=orbitPos(o,tt);
    const jup=orbitPos(PLANETS[4],tt);
    const dJ=Math.hypot(p.x-jup.x,p.y-jup.y);
    pts.push({x:p.x,y:p.y,z:p.z,w:0.005+0.05/(dJ*dJ+0.4)});
  }
  for(let k=0;k<pts.length;k++){
    const p=pts[k],next=pts[Math.min(k+1,pts.length-1)];
    const dx=next.x-p.x,dy=next.y-p.y,len=Math.hypot(dx,dy)||1e-9;
    const nx=-dy/len,ny=dx/len;                      // in-plane normal
    _coneUpper[k*3]=p.x+nx*p.w;_coneUpper[k*3+1]=p.y+ny*p.w;_coneUpper[k*3+2]=p.z;
    _coneLower[k*3]=p.x-nx*p.w;_coneLower[k*3+1]=p.y-ny*p.w;_coneLower[k*3+2]=p.z;
  }
}

// Jupiter Δv vector endpoints in WORLD coordinates
function computeJupiterVector(t, f) {
  f.active = false;
  if (!state.jupiter) return;
  const sel = NEOS.find(n => n.id === state.selectedId); if (!sel) return;
  const ap = orbitPos(sel, t), jp = orbitPos(PLANETS[4], t);
  const dx = jp.x - ap.x, dy = jp.y - ap.y, dz = (jp.z||0) - (ap.z||0);
  const d = Math.hypot(dx, dy);
  if (d > 6) return;
  f.active = true;
  f.ax = ap.x; f.ay = ap.y; f.az = ap.z||0;
  f.bx = ap.x + dx*0.06; f.by = ap.y + dy*0.06; f.bz = (ap.z||0) + dz*0.06;
}

const _J2000_RAF = Date.UTC(2000, 0, 1, 12, 0, 0);
const _T_SIM_RAF = _J2000_RAF + 9643 * 86400000; // sim epoch = 2026-05-27

