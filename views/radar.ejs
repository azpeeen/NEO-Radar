    transition: color 140ms, border-color 140ms;
  }
  #pilot-hud .ph-dest button:hover { color: var(--ink); border-color: var(--cobalt-soft); }
  #pilot-keys {
    /* Top, beside the HUD card: the ship owns the bottom of the view */
    position: absolute; left: 300px; top: 16px; z-index: 5; display: none;
    max-width: calc(100% - 300px - 72px);
